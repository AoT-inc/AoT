[Unit]
Description=AoT server
After=syslog.target network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=20s
TimeoutSec=0
# 제어 데몬을 화면·AI 보다 먼저 돌린다(자원 조절 R5). 가중치는 CPU·디스크를 다툴 때만
# 작동하고 상한을 걸지 않는다 — 한가할 때는 아무것도 바뀌지 않는다(기본 100).
# 메모리가 바닥나면 커널이 데몬보다 웹을 먼저 정리하게 한다(도커 compose 의
# oom_score_adj: -500 과 같은 값).
CPUWeight=400
IOWeight=400
OOMScoreAdjust=-500
ExecStart=/opt/AoT/env/bin/python /opt/AoT/aot/aot_daemon.py
ExecStop=/opt/AoT/env/bin/python /opt/AoT/aot/aot_client.py -t
ExecReload=/opt/AoT/env/bin/python /opt/AoT/aot/aot_client.py -t && /opt/AoT/env/bin/python /opt/AoT/aot/aot_daemon.py

[Install]
WantedBy=multi-user.target
Alias=aot.service
