# Copy to .env (same directory) and adjust.
# Image version to run. Pin to an exact release for reproducibility, or use
# "latest". To upgrade: change this, then `docker compose -f docker-compose.prod.yml pull && up -d`.
AOT_IMAGE_TAG=26.07.3

# Host port to expose the web UI on.
AOT_PORT=8084

# Container timezone (log timestamps + local-time scheduling). Data stays UTC.
TZ=Asia/Seoul

# Runtime hardware profile: LOW (Raspberry Pi / small VM) or HIGH.
HARDWARE_PROFILE=LOW

# External MCP server (aot_mcp service, port 5700 on 127.0.0.1 only).
# Require an API key for every call (X-API-KEY header = base64(User.api_key),
# generated under Settings > Users). Set to 0 only for solo local testing —
# the caller identity then falls back to self-declared ('unauthenticated:' prefix
# in the audit log).
AOT_MCP_REQUIRE_AUTH=1
# Allow write/control tools to run (after human approval in the review page or
# via the chat-relay respond_to_confirmation tool). 0 = advice-only mode.
AOT_MCP_WRITE_ENABLED=1
# Key for stdio MCP clients (e.g. Claude Desktop/Code). Not used by this
# service's own --http process — it's inherited by a `docker exec -i
# aot-aot_mcp-1 python aot/aot_mcp_server.py` stdio session started against
# THIS container specifically (AOT_MCP_API_KEY must not be set on aot-app).
# Base64-encode the same User.api_key used for X-API-KEY. Leave empty to
# require callers to pass AOT_MCP_REQUIRE_AUTH=0 for stdio testing instead.
AOT_MCP_API_KEY=
