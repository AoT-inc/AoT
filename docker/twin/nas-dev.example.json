{
  "enabled": true,
  "period_s": 3600,
  "workers": 2,
  "servers": [
    {
      "server_id": "dev8084",
      "mode": "remote",
      "url": "${AOT_TWIN_DEV_URL}",
      "api_key_env": "AOT_TWIN_DEV_KEY",
      "targets": [
        {
          "kind": "facility",
          "target_id": "<환경제어 함수(코디네이터) unique_id>",
          "facility": "<시설 uuid 앞 8자>",
          "options": {
            "allow_unverified": false
          },
          "inputs": {
            "T_int": {
              "unique_id": "<센서 id>",
              "unit": "C",
              "channel": 0,
              "provenance": "measured"
            },
            "RH_int": {
              "unique_id": "<센서 id>",
              "unit": "percent",
              "channel": 1,
              "provenance": "measured"
            }
          }
        },
        {
          "kind": "field",
          "target_id": "<노지 구획 unique_id (GeoPlot, facility_uuid 없음)>",
          "options": {
            "planted_on": "<YYYY-MM-DD 구획 started_on>",
            "timezone": "<구획 시간대, 예: Asia/Seoul>",
            "lat": "<구획 위도 — ET0 계열이 없을 때 Hargreaves>",
            "sensor": {
              "layer": 1,
              "a": 1.3,
              "b": 0.0,
              "r_sd": 1.5
            },
            "rain": {
              "agg": "hourly_mean_sum",
              "scale": 4.0,
              "kind": "station",
              "max_lag_d": 2
            },
            "forecast": {
              "timezone": "<구획 시간대 — 예보 입력의 날짜 기준과 같아야 한다>",
              "max_age_h": 36,
              "rain": {
                "unique_id": "<OPEN_METEO_DAILY_FORECAST 입력 id>",
                "unit": "mm",
                "channels": [
                  0,
                  1,
                  2,
                  3,
                  4,
                  5,
                  6,
                  7
                ],
                "scale": 1.0,
                "log_sd": 0.35,
                "log_sd_per_day": 0.08
              },
              "et0": {
                "unique_id": "<같은 입력 id>",
                "unit": "mm",
                "channels": [
                  8,
                  9,
                  10,
                  11,
                  12,
                  13,
                  14,
                  15
                ]
              },
              "t_max": {
                "unique_id": "<같은 입력 id>",
                "unit": "C",
                "channels": [
                  16,
                  17,
                  18,
                  19,
                  20,
                  21,
                  22,
                  23
                ]
              },
              "t_min": {
                "unique_id": "<같은 입력 id>",
                "unit": "C",
                "channels": [
                  24,
                  25,
                  26,
                  27,
                  28,
                  29,
                  30,
                  31
                ]
              }
            }
          },
          "inputs": {
            "theta": {
              "unique_id": "<토양센서 id>",
              "unit": "percent",
              "channel": 2,
              "provenance": "measured"
            },
            "soil_t": {
              "unique_id": "<토양센서 id>",
              "unit": "C",
              "channel": 3,
              "provenance": "measured"
            },
            "rain": {
              "unique_id": "<비 입력 id (관측소·우량계·재분석 입력)>",
              "unit": "mm",
              "channel": 6,
              "provenance": "measured"
            },
            "t_air": {
              "unique_id": "<기온 입력 id>",
              "unit": "C",
              "channel": 0,
              "provenance": "measured"
            }
          }
        }
      ]
    }
  ],
  "schedule": {
    "run_at": [
      "06:10",
      "18:10"
    ],
    "timezone": "Asia/Seoul",
    "run_on_start": true,
    "retry_s": 900,
    "max_retries": 4
  }
}
