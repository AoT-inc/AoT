#!/bin/sh
# AoT pre-commit 훅 — JS 번들 재빌드 누락 차단.
#
# 정적 JS 일부는 빌드 산출물이고 git 에 추적된다. 소스만 커밋하면 배포된 앱은
# 계속 옛 코드를 실행한다(2026-07-27 f8090ce 사건). 스테이지에 번들 입력이
# 있는데 산출물이 없으면 커밋을 막는다.
#
# 활성화: git config core.hooksPath .githooks   (클론마다 1회)
# 우회  : AOT_SKIP_BUNDLE_CHECK=1 git commit ...
set -e

if [ -n "$AOT_SKIP_BUNDLE_CHECK" ]; then
    exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
CHECK="$ROOT/aot/scripts/check_js_bundles.py"
[ -f "$CHECK" ] || exit 0

if ! python3 "$CHECK" --staged; then
    echo
    echo "커밋 중단: 위 번들을 재빌드하고 산출물까지 함께 스테이지하세요."
    echo "  (의도한 커밋이라면 AOT_SKIP_BUNDLE_CHECK=1 git commit ...)"
    exit 1
fi

# ── 정의 없이 불리는 JS 내부 함수 ────────────────────────────────────────
# 큰 함수를 잘라 옮기다 이웃 함수를 통째로 삼키는 실수가 두 번 났다.
# `node --check`·번들 빌드·정적 참조 검사가 **전부 통과**하고, 화면에서는 그
# 모달이 그냥 안 열린다(예외가 promise 안에서 삼켜지는 경로가 있다).
# 우회: AOT_SKIP_JS_UNDEF_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_JS_UNDEF_CHECK" ]; then
    UNDEF_CHECK="$ROOT/aot/scripts/check_js_undefined_calls.py"
    if [ -f "$UNDEF_CHECK" ] && git diff --cached --name-only | grep -q '\.js$'; then
        if ! python3 "$UNDEF_CHECK" --staged; then
            echo
            echo "커밋 중단: 정의가 없는 내부 함수를 부르고 있습니다."
            echo "  (의도한 커밋이라면 AOT_SKIP_JS_UNDEF_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi

# ── 지도 데이터 쓰기 소유권 (S5) ──────────────────────────────────────────
# geo 패키지 밖에서 GeoShape 를 직접 쓰면 지도 불변식(타입 어휘·채널 정규화·
# aot_type 미저장·마커 유일성·시설 연쇄)을 그 코드가 다 알아야 하고, 결국
# 아무도 다 알지 못한다 — 2026-08-03 오염 사고의 구조적 원인이다.
# 우회: AOT_SKIP_GEO_WRITE_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_GEO_WRITE_CHECK" ]; then
    GEO_CHECK="$ROOT/aot/scripts/check_geo_writes.py"
    if [ -f "$GEO_CHECK" ] && git diff --cached --name-only | grep -q '\.py$'; then
        if ! python3 "$GEO_CHECK"; then
            echo
            echo "커밋 중단: 지도 데이터는 geo 패키지가 소유합니다."
            echo "  배경: docs/design/geo-data-integrity.md"
            echo "  (의도한 커밋이라면 AOT_SKIP_GEO_WRITE_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi

# ── Alembic 체인 ↔ ALEMBIC_VERSION 일치 ───────────────────────────────────
# 업그레이드는 'head' 가 아니라 이 상수를 목표로 돈다. 새 마이그레이션을
# 넣고 상수를 안 올리면 그 마이그레이션은 영원히 실행되지 않으면서 앱은
# "up to date" 라고 로그를 남긴다 — 6550f41 과 v26.08.2 에서 두 번 났다.
# 인덱스를 검사한다: 마이그레이션만 stage 하고 상수 수정을 빠뜨린 커밋이
# 정확히 막으려는 경우인데, 워킹트리를 보면 그게 통과해 버린다.
# 우회: AOT_SKIP_ALEMBIC_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_ALEMBIC_CHECK" ]; then
    AL_CHECK="$ROOT/aot/scripts/check_alembic_head.py"
    if [ -f "$AL_CHECK" ] && git diff --cached --name-only \
        | grep -qE '^(alembic_db/alembic/versions/|aot/config/__init__\.py$)'; then
        if ! python3 "$AL_CHECK" --staged; then
            echo
            echo "커밋 중단: 마이그레이션 체인과 ALEMBIC_VERSION 이 어긋납니다."
            echo "  (의도한 커밋이라면 AOT_SKIP_ALEMBIC_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi

# ── 번역 카탈로그 .po ↔ .mo ───────────────────────────────────────────────
# 앱이 읽는 것은 .mo 다. .po 만 고치고 컴파일을 빠뜨리면 아무 에러 없이 그
# 언어 사용자만 영어를 본다 — .mo 는 바이너리라 diff 에도 안 드러난다.
# 번들 드리프트와 같은 종류의 조용한 실패다.
# 우회: AOT_SKIP_I18N_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_I18N_CHECK" ]; then
    I18N_CHECK="$ROOT/aot/scripts/check_po_mo_sync.py"
    if [ -f "$I18N_CHECK" ] && git diff --cached --name-only \
        | grep -qE '^aot/aot_flask/translations/.*\.(po|mo)$'; then
        if ! python3 "$I18N_CHECK" --staged; then
            echo
            echo "커밋 중단: .po 를 고치고 .mo 재컴파일을 빠뜨렸습니다."
            echo "  pybabel compile -d aot/aot_flask/translations"
            echo "  ※ -f 는 --force 가 아니라 --use-fuzzy 다. 붙이지 마세요."
            echo "  (의도한 커밋이라면 AOT_SKIP_I18N_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi

# ── 정적 자산 캐시 무효화 ────────────────────────────────────────────────
# 버전 없는 리터럴 "/static/…" 참조는 1년 캐시에 걸려 브라우저가 옛 파일을
# 영구히 실행한다. 2026-08-13 지도 삭제 사고가 그 형태였다 — 화면에도 로그에도
# 테스트에도 드러나지 않고, 개발자는 늘 새 코드를 보므로 사람이 잡을 수 없다.
# 우회: AOT_SKIP_STATIC_CACHE_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_STATIC_CACHE_CHECK" ]; then
    SC_CHECK="$ROOT/aot/scripts/check_static_cache_busting.py"
    if [ -f "$SC_CHECK" ] && git diff --cached --name-only \
        | grep -qE '^(aot/aot_flask/templates/|aot/widgets/|aot/aot_flask/static/js/)'; then
        if ! python3 "$SC_CHECK" --staged; then
            echo
            echo "커밋 중단: 버전 없는 정적 리터럴 참조가 있습니다."
            echo "  템플릿/위젯 : {{ url_for('static', filename='js/foo.js') }}"
            echo "  (의도한 커밋이라면 AOT_SKIP_STATIC_CACHE_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi

# ── 최근 커밋을 되돌리는 변경 ────────────────────────────────────────────
# 오래된 base 에서 편집한 파일이 방금 한 작업을 덮어쓰는 것. 문법도 멀쩡하고
# 테스트도 지워진 기능을 안 부르니 통과한다 — 지워지는 것이 선언·등록·문서면
# 구현과 테스트만 고아로 남고 아무도 모른다. 2026-08-14 에 실제로 그랬고
# (거리 도구 2개가 3개 파일에서 사라졌다), 그때 잡은 것은 우연히 돌려 본
# SSOT 테스트였다 — 그 밖에서 같은 일이 나면 잡을 수단이 없었다.
# 우회: AOT_SKIP_REVERT_CHECK=1 git commit ...
if [ -z "$AOT_SKIP_REVERT_CHECK" ]; then
    RV_CHECK="$ROOT/aot/scripts/check_revert_drift.py"
    if [ -f "$RV_CHECK" ]; then
        if ! python3 "$RV_CHECK" --staged; then
            echo
            echo "커밋 중단: 최근 커밋이 넣은 줄이 통째로 사라집니다."
            echo "  되돌리려는 것이 맞으면 그대로 진행하세요."
            echo "  (의도한 커밋이라면 AOT_SKIP_REVERT_CHECK=1 git commit ...)"
            exit 1
        fi
    fi
fi
