    "main_cpu_avg_pct":     {"label": "켜 둔 메인 스레드 평균", "unit": "%",    "pass": 5,     "warn": 15,    "scope": "client"},
    "poll_mb_per_hour":     {"label": "시간당 폴링 전송량",     "unit": "MB",   "pass": 10,    "warn": 30,    "scope": "line", "when_net": ["lte", "lte_slow"]},
    "server_cpu_avg_pct":   {"label": "서버 CPU 평균",         "unit": "%",    "pass": 50,    "warn": 80,    "scope": "server"},
    "server_p95_ms":        {"label": "응답 p95",              "unit": "ms",   "pass": 500,   "warn": 1500,  "scope": "server"},
    "server_throttled":     {"label": "파이 스로틀 비트",       "unit": "",     "pass": 0,     "warn": null,  "scope": "server"}
  }
