#: aot_flask/templates/settings/custom_ui.html:1
msgid ""
"Output/input channel row background when off; also a general surface "
"color in facility widgets"
msgstr "Kapalıyken çıkış/giriş kanalı satırı arka planı; ayrıca tesis widget'larında genel bir yüzey rengi"

#: aot_flask/templates/settings/custom_ui.html:1
msgid "Row background while a command awaits device confirmation"
msgstr "Bir komut cihaz onayını beklerken satır arka planı"

#: aot_flask/templates/settings/custom_ui.html:1
msgid "Output/Input Channel Preview"
msgstr "Çıkış/Giriş Kanalı Önizlemesi"

#: aot_flask/templates/settings/custom_ui.html:1
msgid "Click to edit Channel On colors"
msgstr "Kanal - Açık renklerini düzenlemek için tıklayın"

#: aot_flask/templates/settings/custom_ui.html:1
msgid "Click to edit Channel Off colors"
msgstr "Kanal - Kapalı renklerini düzenlemek için tıklayın"

#: aot_flask/templates/settings/custom_ui.html:1
