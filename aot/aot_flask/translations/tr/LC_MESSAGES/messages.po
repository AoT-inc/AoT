msgid "Row/card background for offline or unresponsive devices"
msgstr "Çevrimdışı veya yanıt vermeyen cihazlar için satır/kart arka planı"

#: widgets/widget_trigger_sequence.py:1350
msgid "Press and hold to reorder"
msgstr "Yeniden sıralamak için basılı tutun"

#: aot_flask/templates/settings/custom_ui.html:1
msgid ""
"Whole-card highlight when active (IEC focus row, badges) — not the per-"
