msgstr "Eksen Yazı Tipi Boyutu (em)"

#: widgets/AoT_graph.py:397
msgid "Set the font size for graph axes (em)."
msgstr "Grafik eksenleri için yazı tipi boyutunu ayarlayın (em)."

#: widgets/AoT_graph.py:403
msgid "Axis Title Font Size (em)"
msgstr "Eksen Başlığı Yazı Tipi Boyutu (em)"

#: widgets/AoT_graph.py:404
msgid "Set the font size for graph axis titles (em)."
msgstr "Grafik eksen başlıkları için yazı tipi boyutunu ayarlayın (em)."

#: widgets/AoT_graph.py:410
msgid "Legend Font Size (em)"
msgstr "Lejant Yazı Tipi Boyutu (em)"

