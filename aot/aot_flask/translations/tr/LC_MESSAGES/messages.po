msgstr "Yükseltmeler için etkin internet bağlantısını test etmek üzere IP adresi"

#: aot_flask/templates/settings/general.html:295
msgid "Port for the internet test IP address"
msgstr "İnternet test IP adresi için port"

#: aot_flask/templates/settings/general.html:302
msgid "Timeout period (in seconds) for the internet connection test"
msgstr "İnternet bağlantı testi için zaman aşımı süresi (saniye cinsinden)"

#: aot_flask/templates/settings/general.html:312
msgid "Check to enable AoT to automatically check for upgrades."
msgstr ""
"AoT'nin yükseltmeleri otomatik olarak kontrol etmesini etkinleştirmek "
"için işaretleyin."

#: aot_flask/templates/settings/general.html:321
