msgstr "Aktualisiert die Diagrammdaten automatisch im angegebenen Intervall."

#: widgets/AoT_graph.py:336 widgets/widget_graph_synchronous.py:281
msgid "Enable X-Axis Reset"
msgstr "X-Achsen-Zurücksetzen aktivieren"

#: widgets/AoT_graph.py:337
msgid "Reset the X-axis when refreshing the graph."
msgstr "Setzt die X-Achse beim Aktualisieren des Diagramms zurück."

#: widgets/AoT_graph.py:341
msgid "Graph Style"
msgstr "Diagrammstil"

#: widgets/AoT_graph.py:347 widgets/widget_graph_synchronous.py:288
msgid "Enable Header Buttons"
msgstr "Kopfzeilen-Schaltflächen aktivieren"

#: widgets/AoT_graph.py:348
msgid "Display graph control buttons in the widget header."
msgstr "Zeigt Diagramm-Steuerschaltflächen in der Widget-Kopfzeile an."

#: widgets/AoT_graph.py:354 widgets/widget_graph_synchronous.py:295
msgid "Enable Title"
msgstr "Titel aktivieren"

#: widgets/AoT_graph.py:355
msgid "Display the graph title."
msgstr "Zeigt den Diagrammtitel an."

#: widgets/AoT_graph.py:361
msgid "Enable NavBar"
msgstr "Navigationsleiste aktivieren"

#: widgets/AoT_graph.py:362 widgets/widget_graph_synchronous.py:303
msgid "Enable the graph navigation bar."
msgstr "Aktiviert die Navigationsleiste des Diagramms."

#: widgets/AoT_graph.py:368 widgets/widget_graph_synchronous.py:309
msgid "Enable Export"
msgstr "Export aktivieren"

#: widgets/AoT_graph.py:369
msgid "Enable the button to export the graph."
msgstr "Aktiviert die Schaltfläche zum Exportieren des Diagramms."

#: widgets/AoT_graph.py:375 widgets/widget_graph_synchronous.py:316
msgid "Enable Range Selector"
msgstr "Zeitraumauswahl aktivieren"

#: widgets/AoT_graph.py:376
msgid "Enable the graph range selector."
msgstr "Aktiviert die Zeitraumauswahl des Diagramms."

#: widgets/AoT_graph.py:382
msgid "Enable Legend"
msgstr "Legende aktivieren"

#: widgets/AoT_graph.py:383
msgid "Display the legend at the bottom of the graph."
msgstr "Zeigt die Legende am unteren Rand des Diagramms an."

#: widgets/AoT_graph.py:389
msgid "Hide Axis Labels on Mobile"
msgstr "Achsenbeschriftungen auf Mobilgeräten ausblenden"

#: widgets/AoT_graph.py:390
msgid ""
"Hide graph axis tick labels and unit titles on small screens (chart width"
" < 480px)."
msgstr "Blendet Achsenbeschriftungen und Einheitentitel des Diagramms auf kleinen Bildschirmen aus (Diagrammbreite < 480px)."

#: widgets/AoT_graph.py:396
msgid "Axis Font Size (em)"
msgstr "Schriftgröße der Achse (em)"

#: widgets/AoT_graph.py:397
msgid "Set the font size for graph axes (em)."
msgstr "Legt die Schriftgröße für die Diagrammachsen fest (em)."

#: widgets/AoT_graph.py:403
msgid "Axis Title Font Size (em)"
msgstr "Schriftgröße des Achsentitels (em)"

#: widgets/AoT_graph.py:404
msgid "Set the font size for graph axis titles (em)."
msgstr "Legt die Schriftgröße für die Achsentitel des Diagramms fest (em)."

#: widgets/AoT_graph.py:410
msgid "Legend Font Size (em)"
msgstr "Schriftgröße der Legende (em)"

#: widgets/AoT_graph.py:411
msgid "Set the font size for the legend (em)."
msgstr "Legt die Schriftgröße für die Legende fest (em)."

#: widgets/AoT_graph.py:417
msgid "Title Font Size (em)"
msgstr "Titel-Schriftgröße (em)"

#: widgets/AoT_graph.py:418
msgid "Set the font size for the title (em)."
msgstr "Legt die Schriftgröße für den Titel fest (em)."

#: widgets/AoT_graph.py:422
msgid "Data Source"
msgstr "Datenquelle"

#: widgets/AoT_graph.py:471
msgid "Note Tag"
msgstr "Notiz-Tag"

#: widgets/AoT_graph.py:476
msgid "Press <kbd>Ctrl</kbd> or <kbd>&#8984;</kbd> to select multiple items."
msgstr "Halten Sie <kbd>Strg</kbd> oder <kbd>&#8984;</kbd> gedrückt, um mehrere Elemente auszuwählen."

#: widgets/AoT_map.py:584
msgid "AoT Map"
msgstr "AoT-Karte"

#: widgets/AoT_map.py:594
msgid ""
"Displays the location of the selected device on a map. Highlights the "
"operating state with the selected color. Supports 3D terrain, pitch, and "
"bearing."
msgstr "Zeigt den Standort des ausgewählten Geräts auf einer Karte an. Hebt den Betriebszustand mit der ausgewählten Farbe hervor. Unterstützt 3D-Gelände, Neigung und Ausrichtung."

#: widgets/AoT_map.py:629
msgid ""
"All devices placed on this map in the map editor are shown automatically."
" Add or move devices in <a href=\"/geo/design\" target=\"_blank\" "
"rel=\"noopener\">Map Editor (geo/design)</a>."
msgstr "Alle im Karteneditor auf dieser Karte platzierten Geräte werden automatisch angezeigt. Fügen Sie Geräte im <a href=\"/geo/design\" target=\"_blank\" rel=\"noopener\">Karteneditor (geo/design)</a> hinzu oder verschieben Sie sie dort."

#: widgets/AoT_map.py:641
msgid "Select a map. Leave empty to use the most recently modified map."
msgstr "Wählen Sie eine Karte aus. Leer lassen, um die zuletzt geänderte Karte zu verwenden."

#: widgets/AoT_map.py:654
msgid "Show Labels"
msgstr "Beschriftungen anzeigen"

#: widgets/AoT_map.py:656
msgid ""
"Master switch for all map labels (site, zone, device, sensor). Use the "
"map's label controller to fine-tune input/output/function labels."
msgstr "Hauptschalter für alle Kartenbeschriftungen (Standort, Zone, Gerät, Sensor). Verwenden Sie die Beschriftungssteuerung der Karte, um Eingangs-/Ausgangs-/Funktionsbeschriftungen im Detail anzupassen."

#: widgets/AoT_map.py:664
msgid "Display Data Only (Hide Map)"
msgstr "Nur Daten anzeigen (Karte ausblenden)"

#: widgets/AoT_map.py:665
msgid "Hide the overlay map and show only the data panel."
msgstr "Blendet die Overlay-Karte aus und zeigt nur das Datenpanel an."

#: widgets/AoT_map.py:676
msgid "Show AI Advice"
msgstr "KI-Empfehlungen anzeigen"

#: widgets/AoT_map.py:678
msgid ""
"Display the latest periodic AI advice summary for this map's "
"facility/site."
msgstr "Zeigt die neueste periodische KI-Ratschlagszusammenfassung für die Anlage/den Standort dieser Karte an."

#: widgets/AoT_map.py:685 widgets/widget_trigger_sequence.py:293
msgid "Period (Seconds)"
msgstr "Zeitraum (Sekunden)"

#: widgets/AoT_map.py:686
msgid "Refresh the widget every N seconds. 0 to disable."
msgstr "Aktualisiert das Widget alle N Sekunden. 0 zum Deaktivieren."

#: widgets/AoT_map.py:710
msgid "Device Filter"
msgstr "Gerätefilter"

#: widgets/AoT_map.py:715
msgid ""
"Nothing is selected by default, so every device placed on the map is "
"shown. Devices you select below are hidden from the map."
msgstr "Standardmäßig ist nichts ausgewählt, sodass jedes auf der Karte platzierte Gerät angezeigt wird. Geräte, die Sie unten auswählen, werden auf der Karte ausgeblendet."

#: widgets/AoT_map.py:726
msgid "Select inputs to hide. Leave empty to show all placed inputs."
msgstr "Wählen Sie Eingänge aus, die ausgeblendet werden sollen. Leer lassen, um alle platzierten Eingänge anzuzeigen."

#: widgets/AoT_map.py:735
msgid "Select outputs to hide. Leave empty to show all placed outputs."
msgstr "Wählen Sie Ausgänge aus, die ausgeblendet werden sollen. Leer lassen, um alle platzierten Ausgänge anzuzeigen."

#: widgets/AoT_map.py:744
msgid "Select functions to hide. Leave empty to show all placed functions."
msgstr "Wählen Sie Funktionen aus, die ausgeblendet werden sollen. Leer lassen, um alle platzierten Funktionen anzuzeigen."

#: widgets/AoT_map.py:754
msgid "Measurement Panel"
msgstr "Messpanel"

#: widgets/AoT_map.py:763
msgid "Select input measurements to display in the panel."
msgstr "Wählen Sie Eingangsmessgrößen aus, die im Panel angezeigt werden sollen."

#: widgets/AoT_map.py:772
msgid "Select output measurements to display in the panel."
msgstr "Wählen Sie Ausgangsmessgrößen aus, die im Panel angezeigt werden sollen."

#: widgets/AoT_map.py:781
msgid "Select function measurements to display in the panel."
msgstr "Wählen Sie Funktionsmessgrößen aus, die im Panel angezeigt werden sollen."

#: widgets/AoT_map.py:791
msgid "Label Style"
msgstr "Beschriftungsstil"

#: widgets/AoT_map.py:798
msgid "Prevent Label Collision"
msgstr "Beschriftungsüberlappung verhindern"

#: widgets/AoT_map.py:799
msgid "Automatically hide overlapping labels when enabled."
msgstr "Blendet überlappende Beschriftungen automatisch aus, wenn aktiviert."

#: widgets/AoT_map.py:806
msgid "Label Text Size"
msgstr "Textgröße der Beschriftung"

#: widgets/AoT_map.py:807
msgid "Specify the size of all map labels (unit: em)."
msgstr "Legt die Größe aller Kartenbeschriftungen fest (Einheit: em)."

#: widgets/AoT_map.py:815
msgid "Facility-centric Labels"
msgstr "Anlagenbezogene Beschriftungen"

#: widgets/AoT_map.py:817
msgid ""
"Off (default): outdoor-centric — site/zone labels stay visible at all "
"zoom levels; facility and sensor labels appear only when zoomed in. On: "
"facility-centric — facility and sensor labels take priority; site/zone "
"labels yield and merge when zoomed out."
msgstr "Aus (Standard): außenorientiert — Standort-/Zonenbeschriftungen bleiben bei allen Zoomstufen sichtbar; Anlagen- und Sensorbeschriftungen erscheinen nur beim Heranzoomen. Ein: anlagenorientiert — Anlagen- und Sensorbeschriftungen haben Vorrang; Standort-/Zonenbeschriftungen treten zurück und werden beim Herauszoomen zusammengeführt."

#: widgets/AoT_map.py:832
msgid "Circle (integer value)"
msgstr "Kreis (Ganzzahlwert)"

#: widgets/AoT_map.py:833
msgid "Text label"
msgstr "Textbeschriftung"

#: widgets/AoT_map.py:835
msgid "Sensor Marker Style"
msgstr "Sensor-Markierungsstil"

#: widgets/AoT_map.py:836
msgid ""
"Circle: compact round marker showing the first measurement as an integer,"
" colored by measurement band. Text: full value label."
msgstr "Kreis: kompakte runde Markierung, die den ersten Messwert als Ganzzahl anzeigt, eingefärbt nach Messbereich. Text: vollständige Wertbeschriftung."

#: widgets/AoT_map.py:860
msgid "Site Shape"
msgstr "Standortform"

#: widgets/AoT_map.py:861
msgid "Show Site polygons on the map."
msgstr "Zeigt Standortpolygone auf der Karte an."

#: widgets/AoT_map.py:868
msgid "Zone Shape"
msgstr "Zonenform"

#: widgets/AoT_map.py:869
msgid "Show Zone polygons on the map."
msgstr "Zeigt Zonenpolygone auf der Karte an."

#: widgets/AoT_map.py:876
msgid "Facility Shape"
msgstr "Anlagenform"

#: widgets/AoT_map.py:877
msgid "Show Facility polygons on the map."
msgstr "Zeigt Anlagenpolygone auf der Karte an."

#: widgets/AoT_map.py:884
msgid "Equipment Shape"
msgstr "Ausrüstungsform"

#: widgets/AoT_map.py:885
msgid "Show Equipment (e.g., pipes) shapes on the map."
msgstr "Zeigt Ausrüstungsformen (z. B. Rohre) auf der Karte an."

#: widgets/AoT_map.py:892
msgid "Device Shape"
msgstr "Geräteform"

#: widgets/AoT_map.py:893
msgid "Show Device shape areas on the map."
msgstr "Zeigt Geräteflächen auf der Karte an."

#: widgets/AoT_map.py:900
msgid "Other Drawn Shapes"
msgstr "Andere gezeichnete Formen"

#: widgets/AoT_map.py:901
msgid "Show freeform shapes created with drawing tools."
msgstr "Zeigt mit Zeichenwerkzeugen erstellte Freiformformen an."

#: widgets/AoT_map.py:907
msgid "Device Shape Opacity"
msgstr "Deckkraft der Geräteform"

#: widgets/AoT_map.py:908
msgid "0 (Transparent) ~ 100 (Opaque)"
msgstr "0 (Transparent) ~ 100 (Undurchsichtig)"

#: widgets/AoT_map.py:919
msgid "3D Map (Vector Mode)"
msgstr "3D-Karte (Vektormodus)"

#: widgets/AoT_map.py:926
msgid "Enable 3D Terrain"
msgstr "3D-Gelände aktivieren"

#: widgets/AoT_map.py:927
msgid "Enable 3D terrain rendering (Hillshade, elevation). Requires vector mode."
msgstr "Aktiviert die 3D-Geländedarstellung (Schummerung, Höhenprofil). Erfordert den Vektormodus."

#: widgets/AoT_map.py:939
msgid "Facility Render Mode"
msgstr "Rendermodus der Anlage"

#: widgets/AoT_map.py:941
msgid ""
"Render style for the 3D facility overlay on the map. "
"Solid/Wireframe/Performance reduce GPU load."
msgstr "Darstellungsstil für das 3D-Anlagen-Overlay auf der Karte. Solid/Drahtgitter/Performance reduzieren die GPU-Last."

#: widgets/AoT_map.py:950
msgid "Vector Style URL"
msgstr "Vektorstil-URL"

#: widgets/AoT_map.py:951
msgid "Custom MapLibre style JSON URL. Leave empty to use GIS input setting."
msgstr "Benutzerdefinierte MapLibre-Style-JSON-URL. Leer lassen, um die GIS-Eingangseinstellung zu verwenden."

#: widgets/AoT_timer.py:75
msgid "Must be a number."
msgstr "Muss eine Zahl sein."

#: widgets/AoT_timer.py:77
msgid "Allowed range is -12.0 to +14.0."
msgstr "Der zulässige Bereich ist -12,0 bis +14,0."

#: widgets/AoT_timer.py:801 widgets/AoT_timer.py:840
#, python-brace-format
msgid "ON Failed: {}"
msgstr "EIN fehlgeschlagen: {}"

#: widgets/AoT_timer.py:1114
msgid "AoT Timer"
msgstr "AoT-Timer"

#: widgets/AoT_timer.py:1120
msgid ""
"Use the toggle switch to turn the device on and off. Turn on \"Timer\" to"
" operate on a timer: in Simple mode the device runs once for the set time"
" (0 = run until stopped), and in Cycle mode it repeats a Run / Rest "
"sequence for the set number of cycles. \"Scheduled Start\" begins "
"operation at a set wall-clock time in the device timezone. When \"Timer\""
" is off, the toggle simply switches the device on or off regardless of "
"the time settings."
msgstr "Verwenden Sie den Schalter, um das Gerät ein- und auszuschalten. Aktivieren Sie „Timer“, um es zeitgesteuert zu betreiben: Im Modus „Einfach“ läuft das Gerät einmal für die eingestellte Zeit (0 = bis zum Stoppen laufen lassen), im Modus „Zyklus“ wiederholt es eine Lauf-/Pausensequenz für die eingestellte Anzahl an Zyklen. „Geplanter Start“ beginnt den Betrieb zu einer festgelegten Uhrzeit in der Zeitzone des Geräts. Ist „Timer“ ausgeschaltet, schaltet der Schalter das Gerät unabhängig von den Zeiteinstellungen einfach ein oder aus."

#: widgets/AoT_timer.py:1138
msgid "Select the Output to control."
msgstr "Wählen Sie den zu steuernden Ausgang aus."

#: widgets/AoT_timer.py:1146
msgid "Sync (seconds)"
msgstr "Synchronisierung (Sekunden)"

#: widgets/AoT_timer.py:1147
msgid ""
"How often the widget refreshes the operation status from the server (in "
"seconds)."
msgstr "Wie oft das Widget den Betriebsstatus vom Server aktualisiert (in Sekunden)."

#: widgets/AoT_timer.py:1157
msgid "Show Status"
msgstr "Status anzeigen"

#: widgets/AoT_timer.py:1158
msgid "Display operation status on the title bar."
msgstr "Zeigt den Betriebsstatus in der Titelleiste an."

#: widgets/AoT_timer.py:1169
msgid ""
"When enabled, shows the timed controls (Run / Rest / Cycles / Scheduled "
"Start). When disabled, the toggle simply turns the device on or off."
msgstr "Wenn aktiviert, werden die zeitgesteuerten Bedienelemente angezeigt (Laufzeit / Pause / Zyklen / geplanter Start). Wenn deaktiviert, schaltet der Schalter das Gerät einfach ein oder aus."

#: widgets/AoT_timer.py:1176
msgid "Simple (single run / hold)"
msgstr "Einfach (einmaliger Lauf / Halten)"

#: widgets/AoT_timer.py:1177
msgid "Cycle (run / rest repeated)"
msgstr "Zyklus (Lauf/Pause wiederholt)"

#: widgets/AoT_timer.py:1180
msgid ""
"Cycle: shows Run / Rest / Cycles inputs, repeats the run/rest for a "
"number of cycles. Simple: single Run time only (0 = run until stopped)."
msgstr "Zyklus: zeigt Eingabefelder für Lauf/Pause/Zyklen an, wiederholt Lauf/Pause für eine bestimmte Anzahl von Zyklen. Einfach: nur eine einzelne Laufzeit (0 = läuft bis zum Stopp)."

#: widgets/AoT_timer.py:1186
msgid "Scheduled Start (hh:mm)"
msgstr "Geplanter Start (hh:mm)"

#: widgets/AoT_timer.py:1187
msgid ""
"Start at this wall-clock time (device timezone). 00:00 = start "
"immediately. If the time already passed today, starts tomorrow."
msgstr "Startet zu dieser Uhrzeit (Zeitzone des Geräts). 00:00 = sofort starten. Ist die Zeit heute bereits verstrichen, startet der Vorgang morgen."

#: widgets/AoT_timer.py:1191
msgid "Cycle Settings"
msgstr "Zykluseinstellungen"

#: widgets/AoT_timer.py:1198
msgid "Default Run Time (s)"
msgstr "Standard-Laufzeit (s)"

#: widgets/AoT_timer.py:1199
msgid "Default run time to use at start"
msgstr "Standard-Laufzeit beim Start"

#: widgets/AoT_timer.py:1206
msgid "Default Rest Time (s)"
msgstr "Standard-Ruhezeit (s)"

#: widgets/AoT_timer.py:1207
msgid "Default rest time between cycles (cycle mode)"
msgstr "Standard-Ruhezeit zwischen Zyklen (Zyklusmodus)"

#: widgets/AoT_timer.py:1214
msgid "Default Cycle Count"
msgstr "Standard-Zyklenanzahl"

#: widgets/AoT_timer.py:1215
msgid "Default number of automatic cycles (cycle mode)"
msgstr "Standardanzahl automatischer Zyklen (Zyklusmodus)"

#: widgets/AoT_weather_fcst_announcement.py:57
msgid "AoT Weather Forecast"
msgstr "AoT-Wettervorhersage"

#: widgets/AoT_weather_fcst_announcement.py:60
msgid ""
"Displays the KMA (Korea Meteorological Administration) short-term "
"forecast for the period selected by the user."
msgstr "Zeigt die kurzfristige Wettervorhersage der KMA (Korea Meteorological Administration) für den vom Benutzer ausgewählten Zeitraum an."

#: widgets/AoT_weather_fcst_announcement.py:70 widgets/AoT_wind_angular.py:201
msgid "Maximum Validity Time"
msgstr "Maximale Gültigkeitsdauer"

#: widgets/AoT_weather_fcst_announcement.py:71
msgid "Set the maximum validity for the forecast announcement. (Seconds)"
msgstr "Legt die maximale Gültigkeitsdauer für die Vorhersageansage fest. (Sekunden)"

#: widgets/AoT_weather_fcst_announcement.py:80
msgid "Set the interval to refresh the forecast. (Seconds)"
msgstr "Legt das Intervall zur Aktualisierung der Vorhersage fest. (Sekunden)"

#: widgets/AoT_weather_fcst_announcement.py:87
msgid "Temperature Font Size (em)"
msgstr "Schriftgröße der Temperatur (em)"

#: widgets/AoT_weather_fcst_announcement.py:88
msgid "Set the font size for the temperature display."
msgstr "Legt die Schriftgröße für die Temperaturanzeige fest."

#: widgets/AoT_weather_fcst_announcement.py:96
msgid "Set the general font size."
msgstr "Legt die allgemeine Schriftgröße fest."

#: widgets/AoT_weather_fcst_announcement.py:102
msgid "Detailed Forecast"
msgstr "Detaillierte Vorhersage"

#: widgets/AoT_weather_fcst_announcement.py:103
msgid "Toggle the display of the detailed forecast announcement."
msgstr "Anzeige der detaillierten Vorhersagebekanntgabe ein-/ausschalten."

#: widgets/AoT_wind_angular.py:163
msgid "AoT Wind Direction/Speed Gauge"
msgstr "AoT Windrichtungs-/Geschwindigkeitsanzeige"

#: widgets/AoT_wind_angular.py:167
msgid ""
"Displays wind direction on a circular ring (0-360°) and wind speed in the"
" center. Includes auxiliary lines for the 8 primary compass points."
msgstr "Zeigt die Windrichtung auf einem kreisförmigen Ring (0–360°) und die Windgeschwindigkeit in der Mitte an. Enthält Hilfslinien für die 8 Haupthimmelsrichtungen."

#: widgets/AoT_wind_angular.py:184
msgid "Wind Direction Measurement"
msgstr "Windrichtungsmessung"

#: widgets/AoT_wind_angular.py:185
msgid "Select the wind direction (0-360°) measurement."
msgstr "Wählen Sie die Messgröße für die Windrichtung (0-360°) aus."

#: widgets/AoT_wind_angular.py:192
msgid "Wind Speed Measurement"
msgstr "Windgeschwindigkeitsmessung"

#: widgets/AoT_wind_angular.py:193
msgid "Select the wind speed measurement."
msgstr "Wählen Sie die Messgröße für die Windgeschwindigkeit aus."

#: widgets/AoT_wind_angular.py:202
msgid "Set the maximum validity for the measurement."
msgstr "Legt die maximale Gültigkeitsdauer für die Messung fest."

#: widgets/AoT_wind_angular.py:211
msgid "Set the refresh interval for the widget."
msgstr "Legt das Aktualisierungsintervall für das Widget fest."

#: widgets/AoT_wind_angular.py:218
msgid "Set the number of decimal places to display."
msgstr "Legt die Anzahl der anzuzeigenden Dezimalstellen fest."

#: widgets/AoT_wind_angular.py:225
msgid "Set the minimum value for the gauge."
msgstr "Legt den Minimalwert für die Anzeige fest."

#: widgets/AoT_wind_angular.py:232
msgid "Set the maximum value for the gauge."
msgstr "Legt den Maximalwert für die Anzeige fest."

#: widgets/AoT_wind_angular.py:239
msgid "Set the font size for the data inside the gauge. (Default: 1.5)"
msgstr "Legt die Schriftgröße für die Daten innerhalb der Anzeige fest. (Standard: 1,5)"

#: widgets/AoT_wind_angular.py:246
msgid "Set the font size for the unit inside the gauge. (Default: 0.7)"
msgstr "Legt die Schriftgröße für die Einheit innerhalb der Anzeige fest. (Standard: 0,7)"

#: widgets/AoT_wind_angular.py:253
msgid "Selected from the palette. (Default: #D5D5D5)"
msgstr "Aus der Palette ausgewählt. (Standard: #D5D5D5)"

#: widgets/AoT_wind_angular.py:260
msgid "Selected from the palette. (Default: #F4D624)"
msgstr "Aus der Palette ausgewählt. (Standard: #F4D624)"

#: widgets/AoT_wind_angular.py:267
msgid "Set the radius (px) of the wind direction indicator dot. (Default: 10)"
msgstr "Legt den Radius (px) des Windrichtungspunkts fest. (Standard: 10)"

#: widgets/AoT_wind_angular.py:273
msgid "Compass Font Size (em)"
msgstr "Kompass-Schriftgröße (em)"

#: widgets/AoT_wind_angular.py:274
msgid ""
