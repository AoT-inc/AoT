msgstr "Warnzustand"

#: aot_flask/templates/settings/custom_ui.html:1
msgid "Row/card background for offline or unresponsive devices"
msgstr "Zeilen-/Karten-Hintergrund für Offline- oder nicht reagierende Geräte"

#: widgets/widget_trigger_sequence.py:1350
