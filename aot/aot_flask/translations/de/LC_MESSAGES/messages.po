msgstr "Eingangsgültigkeit (Sekunden)"

#: aot_flask/templates/pages/function_options/conditional_options/controller_status.html:2
msgid "Controller Status"
msgstr "Reglerstatus"

#: aot_flask/templates/pages/function_options/conditional_options/controller_status.html:2
msgid "Returns True if controller is running, otherwise False."
msgstr "Gibt True zurück, wenn der Controller läuft, andernfalls False."

#: aot_flask/templates/pages/function_options/conditional_options/controller_status.html:7
msgid "Select controller to get info from"
msgstr ""
"Wählen Sie den Controller aus, von dem Informationen abgerufen werden "
"sollen"

#: aot_flask/templates/pages/function_options/conditional_options/gpio_state.html:3
#: aot_flask/templates/pages/function_options/conditional_options/measurement_and_ts.html:4
msgid ""
"Returns True if GPIO pin is HIGH, False if LOW. Do not use this to check "
"On/Off GPIO output state. (Using this changes GPIO pin from OUTPUT to "
"INPUT, stopping it from working as output.) Use \"Output State "
"Condition\" to check output state."
msgstr ""
"Gibt True zurück, wenn der GPIO-Pin HIGH ist, False wenn LOW. Verwenden "
"Sie dies nicht, um den Ein/Aus-Status eines GPIO-Ausgangs zu prüfen. "
"(Dadurch wird der GPIO-Pin von OUTPUT auf INPUT umgestellt, wodurch er "
"nicht mehr als Ausgang funktioniert.) Verwenden Sie \"Ausgangsstatus-"
"Bedingung\", um den Ausgangsstatus zu prüfen."

#: aot_flask/templates/pages/function_options/conditional_options/gpio_state.html:6
#: aot_flask/templates/pages/function_options/conditional_options/measurement_and_ts.html:8
msgid "Select GPIO Pin"
msgstr "GPIO-Pin auswählen"

#: aot_flask/templates/pages/function_options/conditional_options/gpio_state.html:8
msgid "Set the GPIO pin to get status from"
msgstr "Legt den GPIO-Pin fest, von dem der Status abgerufen wird"

#: aot_flask/templates/pages/function_options/conditional_options/measurement.html:4
msgid ""
"Returns the last value found within the set maximum time, otherwise "
"returns None."
msgstr ""
"Gibt den letzten innerhalb der festgelegten Höchstzeit gefundenen Wert "
"zurück, andernfalls None."

#: aot_flask/templates/pages/function_options/conditional_options/measurement.html:10
#: aot_flask/templates/pages/function_options/conditional_options/measurement_dict.html:11
#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_average.html:10
#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_sum.html:6
msgid "Select the measurement to use as input"
msgstr "Wählen Sie die Messgröße aus, die als Eingang verwendet werden soll"

#: aot_flask/templates/pages/function_options/conditional_options/measurement.html:31
#: aot_flask/templates/pages/function_options/conditional_options/measurement_and_ts.html:33
#: aot_flask/templates/pages/function_options/conditional_options/measurement_dict.html:32
#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_average.html:31
#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_sum.html:26
msgid "Measurements older than this time are not accepted."
msgstr "Messungen, die älter als dieser Zeitpunkt sind, werden nicht akzeptiert."

#: aot_flask/templates/pages/function_options/conditional_options/measurement_and_ts.html:10
msgid "Set the GPIO pin to get the state from"
msgstr "Legt den GPIO-Pin fest, von dem der Zustand abgerufen wird"

#: aot_flask/templates/pages/function_options/conditional_options/measurement_and_ts.html:13
msgid "Select the measurement to use as the input"
msgstr "Wählen Sie die Messgröße aus, die als Eingang verwendet werden soll"

#: aot_flask/templates/pages/function_options/conditional_options/measurement_dict.html:4
msgid ""
"Returns a list of dictionaries containing \"time\" and \"value\" keys "
"found within the set maximum time, otherwise returns None."
msgstr ""
"Gibt eine Liste von Dictionaries mit den Schlüsseln \"time\" und "
"\"value\" zurück, die innerhalb der festgelegten Höchstzeit gefunden "
"wurden, andernfalls None."

#: aot_flask/templates/pages/function_options/conditional_options/measurement_dict.html:5
msgid "Example"
msgstr "Beispiel"

#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_average.html:4
msgid ""
"Returns the average of values found within the set maximum time, "
"otherwise returns None."
msgstr ""
"Gibt den Durchschnitt der innerhalb der festgelegten Höchstzeit "
"gefundenen Werte zurück, andernfalls None."

#: aot_flask/templates/pages/function_options/conditional_options/measurement_past_sum.html:4
msgid ""
"Returns the sum of values found within the set maximum time, otherwise "
"returns None."
msgstr ""
"Gibt die Summe der innerhalb der festgelegten Höchstzeit gefundenen Werte"
" zurück, andernfalls None."

#: aot_flask/templates/pages/function_options/conditional_options/output_duration_on.html:4
msgid "Returns how many seconds the output has been on, or 0 if off."
msgstr ""
"Gibt zurück, wie viele Sekunden der Ausgang eingeschaltet war, oder 0 "
"wenn ausgeschaltet."

#: aot_flask/templates/pages/function_options/conditional_options/output_duration_on.html:10
msgid "Select the output to get information from"
msgstr "Wählen Sie den Ausgang aus, von dem Informationen abgerufen werden sollen"

#: aot_flask/templates/pages/function_options/conditional_options/output_state.html:2
#: config/__init__.py:556
msgid "Output State"
msgstr "Ausgangszustand"

#: aot_flask/templates/pages/function_options/conditional_options/output_state.html:4
msgid ""
"Returns \"on\" if output is on, \"off\" if off, or duty cycle value if "
"PWM."
msgstr ""
"Gibt \"on\" zurück, wenn der Ausgang eingeschaltet ist, \"off\" wenn "
"ausgeschaltet, oder bei PWM den Tastgrad-Wert."

#: aot_flask/templates/pages/function_options/conditional_options/output_state.html:10
msgid "Select output to get state from"
msgstr "Wählen Sie den Ausgang aus, von dem der Status abgerufen werden soll"

#: aot_flask/templates/pages/function_options/conditional_options/sun_event_countdown.html:3
#: config/__init__.py:560
msgid "Sun: Time Until Event"
msgstr "Sonne: Zeit bis Ereignis"

#: aot_flask/templates/pages/function_options/conditional_options/sun_event_countdown.html:5
msgid ""
"Returns the number of seconds until the next selected sun event. The "
"location is inherited from this Conditional Function."
msgstr "Gibt die Anzahl der Sekunden bis zum nächsten ausgewählten Sonnenereignis zurück. Der Standort wird von dieser Bedingungsfunktion übernommen."

#: aot_flask/templates/pages/function_options/conditional_options/sun_event_countdown.html:8
msgid "Next event"
msgstr "Nächstes Ereignis"

#: aot_flask/templates/pages/function_options/conditional_options/sun_event_countdown.html:17
msgid "Which sun event to count down to"
msgstr "Bis zu welchem Sonnenereignis heruntergezählt wird"

#: aot_flask/templates/pages/function_options/conditional_options/sun_event_countdown.html:30
msgid ""
"Minutes to shift the event. A negative value counts down to before the "
"event (-60 means one hour before)."
msgstr "Minuten, um das Ereignis zu verschieben. Ein negativer Wert zählt bis vor das Ereignis herunter (-60 bedeutet eine Stunde davor)."

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:3
#: config/__init__.py:559
msgid "Sun: Day or Night"
msgstr "Sonne: Tag oder Nacht"

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:5
msgid ""
"Returns True during the day and False at night. The location is inherited"
" from this Conditional Function."
msgstr "Gibt tagsüber Wahr und nachts Falsch zurück. Der Standort wird von dieser Bedingungsfunktion übernommen."

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:8
#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:10
#: config/__init__.py:565
msgid "Sunrise"
msgstr "Sonnenaufgang"

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:8
#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:11
#: config/__init__.py:566
msgid "Sunset"
msgstr "Sonnenuntergang"

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:9
msgid "Right now"
msgstr "Gerade jetzt"

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:19
msgid ""
"Minutes to shift the start of daytime. A positive value delays it (30 "
"means daytime starts 30 minutes after sunrise)."
msgstr "Minuten, um den Beginn der Tageszeit zu verschieben. Ein positiver Wert verzögert ihn (30 bedeutet, der Tag beginnt 30 Minuten nach Sonnenaufgang)."

#: aot_flask/templates/pages/function_options/conditional_options/sun_state.html:28
msgid ""
"Minutes to shift the end of daytime. A negative value brings it forward "
"(-30 means night starts 30 minutes before sunset)."
msgstr "Minuten, um das Ende der Tageszeit zu verschieben. Ein negativer Wert bringt es vor (-30 bedeutet, die Nacht beginnt 30 Minuten vor Sonnenuntergang)."

#: aot_flask/templates/pages/function_options/pid_options/output_on_off_lower.html:6
msgid ""
"Minimum duration (in seconds) required for lower output to be active. If "
"ON duration is shorter than this, lower output will not turn on."
msgstr ""
"Mindestdauer (in Sekunden), die der untere Ausgang aktiv sein muss. Ist "
"die EIN-Dauer kürzer als dieser Wert, schaltet sich der untere Ausgang "
"nicht ein."

#: aot_flask/templates/pages/function_options/pid_options/output_on_off_lower.html:13
msgid ""
"Maximum duration (in seconds) that lower output can be on during a cycle."
" If ON duration is larger than this, lower output turns on only for the "
"set duration. Enter 0 to disable."
msgstr ""
"Maximale Dauer (in Sekunden), die der untere Ausgang während eines Zyklus"
" eingeschaltet sein darf. Ist die EIN-Dauer länger als dieser Wert, wird "
"der untere Ausgang nur für die festgelegte Dauer eingeschaltet. Geben Sie"
" 0 ein, um dies zu deaktivieren."

#: aot_flask/templates/pages/function_options/pid_options/output_on_off_lower.html:20
#: aot_flask/templates/pages/function_options/pid_options/output_on_off_raise.html:20
msgid "This output will remain off for at least this amount of time."
msgstr "Dieser Ausgang bleibt mindestens für diese Dauer ausgeschaltet."

#: aot_flask/templates/pages/function_options/pid_options/output_on_off_raise.html:6
msgid ""
"Minimum duration (in seconds) required for upper output to be active. If "
"ON duration is shorter than this, upper output will not turn on."
msgstr ""
"Mindestdauer (in Sekunden), die der obere Ausgang aktiv sein muss. Ist "
"die EIN-Dauer kürzer als dieser Wert, schaltet sich der obere Ausgang "
"nicht ein."

#: aot_flask/templates/pages/function_options/pid_options/output_on_off_raise.html:13
msgid ""
"Maximum duration (in seconds) that upper output can be on during a cycle."
" If ON duration is larger than this, upper output turns on only for the "
"set duration. Enter 0 to disable."
msgstr ""
"Maximale Dauer (in Sekunden), die der obere Ausgang während eines Zyklus "
"eingeschaltet sein darf. Ist die EIN-Dauer länger als dieser Wert, wird "
"der obere Ausgang nur für die festgelegte Dauer eingeschaltet. Geben Sie "
"0 ein, um dies zu deaktivieren."

#: aot_flask/templates/pages/function_options/pid_options/output_pwm_lower.html:5
msgid ""
"PWM Minimum Duty Cycle (in %) - Set minimum output level. Enter value "
"between 0 and 100."
msgstr ""
"PWM-Minimaler Tastgrad (in %) – Legt den minimalen Ausgangspegel fest. "
"Geben Sie einen Wert zwischen 0 und 100 ein."

#: aot_flask/templates/pages/function_options/pid_options/output_pwm_lower.html:11
msgid ""
"PWM Maximum Duty Cycle (in %) - Set maximum output level. Enter value "
"between 0 and 100."
msgstr ""
"PWM-Maximaler Tastgrad (in %) – Legt den maximalen Ausgangspegel fest. "
"Geben Sie einen Wert zwischen 0 und 100 ein."

#: aot_flask/templates/pages/function_options/pid_options/output_pwm_raise.html:5
msgid ""
"PWM Minimum Duty Cycle (in %) - Set minimum output level. Allowed range: "
"0~100%"
msgstr ""
"PWM-Minimaler Tastgrad (in %) – Legt den minimalen Ausgangspegel fest. "
"Zulässiger Bereich: 0~100 %"

#: aot_flask/templates/pages/function_options/pid_options/output_pwm_raise.html:11
msgid ""
"PWM Maximum Duty Cycle (in %) - Set maximum output level. Allowed range: "
"0~100%"
msgstr ""
"PWM-Maximaler Tastgrad (in %) – Legt den maximalen Ausgangspegel fest. "
"Zulässiger Bereich: 0~100 %"

#: aot_flask/templates/pages/function_options/pid_options/output_value_lower.html:6
msgid ""
"Minimum value required for lower output to be active. If smaller than "
"this, lower output will not turn on."
msgstr ""
"Mindestwert, der für die Aktivierung des unteren Ausgangs erforderlich "
"ist. Ist er kleiner als dieser Wert, schaltet sich der untere Ausgang "
"nicht ein."

#: aot_flask/templates/pages/function_options/pid_options/output_value_lower.html:13
msgid ""
"Maximum value for lower output during a cycle. If value exceeds this, "
"lower output turns on by the set value. Enter 0 to disable."
msgstr ""
"Maximalwert für den unteren Ausgang während eines Zyklus. Überschreitet "
"der Wert diesen Wert, schaltet sich der untere Ausgang um den "
"festgelegten Wert ein. Geben Sie 0 ein, um dies zu deaktivieren."

#: aot_flask/templates/pages/function_options/pid_options/output_value_raise.html:6
msgid ""
"Minimum value required for upper output to be active. If smaller than "
"this, upper output will not turn on."
msgstr ""
"Mindestwert, der für die Aktivierung des oberen Ausgangs erforderlich "
"ist. Ist er kleiner als dieser Wert, schaltet sich der obere Ausgang "
"nicht ein."

#: aot_flask/templates/pages/function_options/pid_options/output_value_raise.html:13
msgid ""
"Maximum value for upper output during a cycle. If value exceeds this, "
"upper output turns on by the set value. Enter 0 to disable."
msgstr ""
"Maximalwert für den oberen Ausgang während eines Zyklus. Überschreitet "
"der Wert diesen Wert, schaltet sich der obere Ausgang um den festgelegten"
" Wert ein. Geben Sie 0 ein, um dies zu deaktivieren."

#: aot_flask/templates/pages/function_options/pid_options/output_volume_lower.html:6
msgid ""
"Minimum output size required for lower output to be active. If smaller "
"than this, lower output will not turn on."
msgstr ""
"Mindestausgabegröße, die der untere Ausgang benötigt, um aktiv zu sein. "
"Ist sie kleiner als dieser Wert, schaltet sich der untere Ausgang nicht "
"ein."

#: aot_flask/templates/pages/function_options/pid_options/output_volume_lower.html:13
msgid ""
"Maximum output size for lower output to be maintained during a cycle. If "
"larger than this, lower output is maintained only for max duration. Enter"
" 0 to disable."
msgstr ""
"Maximale Ausgangsgröße, die der untere Ausgang während eines Zyklus "
"beibehalten darf. Ist der Wert größer als dieser, wird der untere Ausgang"
" nur für die maximale Dauer beibehalten. Geben Sie 0 ein, um dies zu "
"deaktivieren."

#: aot_flask/templates/pages/function_options/pid_options/output_volume_raise.html:6
msgid ""
"Minimum output size required for upper output to be active. If smaller "
"than this, upper output will not turn on."
msgstr ""
"Mindestausgabegröße, die der obere Ausgang benötigt, um aktiv zu sein. "
"Ist sie kleiner als dieser Wert, schaltet sich der obere Ausgang nicht "
"ein."

#: aot_flask/templates/pages/function_options/pid_options/output_volume_raise.html:13
msgid ""
"Maximum output size for upper output to be maintained during a cycle. If "
"larger than this, upper output is maintained only for max duration. Enter"
" 0 to disable."
msgstr ""
"Maximale Ausgangsgröße, die der obere Ausgang während eines Zyklus "
"beibehalten darf. Ist der Wert größer als dieser, wird der obere Ausgang "
"nur für die maximale Dauer beibehalten. Geben Sie 0 ein, um dies zu "
"deaktivieren."

#: aot_flask/templates/pages/function_options/trigger_options/edge.html:5
msgid "Select a measurement to use as input"
msgstr "Wählen Sie eine Messgröße als Eingang aus"

#: aot_flask/templates/pages/function_options/trigger_options/edge.html:20
msgid "Low to High (Rising), High to Low (Falling), or Both"
msgstr "Niedrig zu Hoch (steigend), Hoch zu Niedrig (fallend) oder Beides"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:5
#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:5
msgid "Execute this condition when this output turns on or off."
msgstr ""
"Führt diese Bedingung aus, wenn dieser Ausgang ein- oder ausgeschaltet "
"wird."

#: aot_flask/templates/pages/function_options/trigger_options/output.html:16
msgid "Select which action triggers this condition (On or Off)"
msgstr "Wählen Sie aus, welche Aktion diese Bedingung auslöst (Ein oder Aus)"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:18
msgid "No Duration"
msgstr "Keine Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:19
msgid "Any Duration"
msgstr "Beliebige Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:20
msgid "No Duration or Any Duration"
msgstr "Keine Dauer oder beliebige Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:21
msgid "Equal to Duration"
msgstr "Gleich der Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:22
msgid "Greater than Duration"
msgstr "Größer als Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:23
msgid "Greater than or Equal to Duration"
msgstr "Größer als oder gleich Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:24
msgid "Less than Duration"
msgstr "Kleiner als Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:25
msgid "Less than or Equal to Duration"
msgstr "Kleiner oder gleich Dauer"

#: aot_flask/templates/pages/function_options/trigger_options/output.html:33
msgid ""
"(Optional) Set a specific duration for the condition to trigger when the "
"output on duration matches this value"
msgstr ""
"(Optional) Legen Sie eine Dauer fest, bei der die Bedingung ausgelöst "
"wird, wenn die Einschaltdauer des Ausgangs diesem Wert entspricht."

#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:16
msgid ""
"Execute this condition when the measured value is greater or less than "
"the set value, or the measured timestamp is greater than the value in "
"seconds."
msgstr ""
"Führt diese Bedingung aus, wenn der Messwert größer oder kleiner als der "
"eingestellte Wert ist oder der Zeitstempel der Messung den Wert in "
"Sekunden überschreitet."

#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:18
msgid "Greater Than (>)"
msgstr "Größer als (>)"

#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:19
msgid "Less Than (<)"
msgstr "Kleiner als (<)"

#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:20
msgid "Equal To (=)"
msgstr "Gleich (=)"

#: aot_flask/templates/pages/function_options/trigger_options/output_pwm.html:27
msgid "Duty cycle of the output to check"
msgstr "Zu prüfendes Tastverhältnis des Ausgangs"

#: aot_flask/templates/pages/function_options/trigger_options/run_pwm_method.html:3
msgid "Duration Method"
msgstr "Dauer-Methode"

#: aot_flask/templates/pages/function_options/trigger_options/run_pwm_method.html:5
msgid ""
"Execute this duration method to set the PWM output duty cycle using the "
"output value."
msgstr ""
"Führt diese Dauermethode aus, um das PWM-Ausgangstastverhältnis anhand "
"des Ausgangswerts festzulegen."

#: aot_flask/templates/pages/function_options/trigger_options/run_pwm_method.html:14
msgid "PWM Output"
msgstr "PWM-Ausgang"

#: aot_flask/templates/pages/function_options/trigger_options/run_pwm_method.html:16
msgid "Apply duty cycle to this PWM output."
msgstr "Tastverhältnis (Duty Cycle) auf diesen PWM-Ausgang anwenden."

#: aot_flask/templates/pages/function_options/trigger_options/run_pwm_method.html:27
msgid "Duration between calculating and setting the PWM output duty cycle"
msgstr ""
"Zeitspanne zwischen Berechnung und Einstellung des PWM-"
"Ausgangstastverhältnisses"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:4
msgid "Next Sunrise/Sunset at Geographic Location"
msgstr "Nächster Sonnenaufgang/-untergang am geografischen Standort"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:13
#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:25
msgid "Unable to calculate Sunrise/Sunset times."
msgstr "Die Sonnenauf-/-untergangszeiten können nicht berechnet werden."

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:19
msgid "Next Execution"
msgstr "Nächste Ausführung"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:36
msgid "Which sun event should this Trigger fire on?"
msgstr "Bei welchem Sonnenereignis soll dieser Auslöser feuern?"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:48
msgid "Location (Auto)"
msgstr "Standort (Automatisch)"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:53
msgid "Set automatically from the map above. Move the marker to change location."
msgstr ""
"Wird automatisch anhand der obigen Karte festgelegt. Verschieben Sie den "
"Marker, um den Standort zu ändern."

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:55
msgid "Not set — place this trigger on the map above."
msgstr "Nicht festgelegt — platzieren Sie diesen Auslöser oben auf der Karte."

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:64
msgid "Days to offset from Sunrise/Sunset date"
msgstr "Anzahl der Tage Versatz vom Sonnenaufgangs-/Sonnenuntergangsdatum"

