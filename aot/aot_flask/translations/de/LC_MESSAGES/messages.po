#: inputs/chirpstack_MQTT_jmespath.py:53
msgid ""
"Subscribes to the ChirpStack v4 MQTT broker topic "
"(application/+/device/+/event/up) to receive events, and applies per-"
"channel JMESPath expressions to each event JSON to store measurements. "
"Examples (https://jmespath.org): object.battery_V, object.battery_pct, "
"max_by(rxInfo,&rssi).rssi, max_by(rxInfo,&snr).snr, deviceInfo.devEui."
msgstr ""
"Abonniert das ChirpStack-v4-MQTT-Broker-Topic "
"(application/+/device/+/event/up), um Ereignisse zu empfangen, und wendet"
" pro Kanal JMESPath-Ausdrücke auf jedes Ereignis-JSON an, um Messwerte zu"
" speichern. Beispiele (https://jmespath.org): object.battery_V, "
"object.battery_pct, max_by(rxInfo,&rssi).rssi, max_by(rxInfo,&snr).snr, "
"deviceInfo.devEui."

#: inputs/chirpstack_MQTT_jmespath.py:82
