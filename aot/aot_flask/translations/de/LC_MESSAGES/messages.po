#: aot_flask/utils/utils_settings.py:1982
#: aot_flask/utils/utils_settings.py:2022
#: aot_flask/utils/utils_settings.py:2075
msgid "Unit"
msgstr "Einheit"

#: aot_flask/templates/pages/geo/geo_facility.html:1008
