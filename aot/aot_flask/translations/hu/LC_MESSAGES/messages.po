msgstr "Állítsa be a GPIO-lábat, amelynek állapotát le szeretné kérni"

#: aot_flask/templates/pages/function_options/conditional_options/measurement.html:4
msgid ""
"Returns the last value found within the set maximum time, otherwise "
"returns None."
msgstr "A beállított maximális időn belül talált utolsó értéket adja vissza, egyébként None-t ad vissza."

