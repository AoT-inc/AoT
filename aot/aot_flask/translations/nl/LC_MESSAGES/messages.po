msgstr ""
"De host of het IP-adres van de externe AoT (een poort kan worden "
"opgenomen, bijv. 192.168.0.9:8084)"

#: inputs/remote_aot_input.py:116
msgid "Remote AoT API Key"
msgstr "API-sleutel van externe AoT"

