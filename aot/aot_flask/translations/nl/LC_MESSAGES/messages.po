msgstr "Hoe ver terug (in seconden) te zoeken in de ChirpStack-metricsgeschiedenis"

#: functions/lorawan_mode_manager.py:140
msgid "Retry Interval (min)"
msgstr "Herhalingsinterval (min)"

#: functions/lorawan_mode_manager.py:141
