#: inputs/modbus_tcp.py:49
msgid ""
"Reads coils and registers from a Modbus TCP device (PLC, gateway, meter). "
"Define one channel per register to read. Several Inputs and Outputs pointing"
" at the same host and port share a single connection automatically. Note "
"that Modbus has no authentication or encryption — keep the device on an "
"isolated network and never expose it to the internet."
msgstr ""

#: inputs/modbus_tcp.py:83 outputs/on_off_modbus.py:107
msgid "IP address or hostname of the Modbus TCP device"
msgstr ""

#: inputs/modbus_tcp.py:91 outputs/on_off_modbus.py:116
msgid "TCP port of the Modbus TCP device (standard: 502)"
msgstr ""

#: inputs/modbus_tcp.py:100 outputs/on_off_modbus.py:125
msgid ""
"Modbus unit/slave ID of the device. Usually 1 for a device addressed "
"directly, or the slave address behind a serial gateway"
msgstr ""

#: inputs/modbus_tcp.py:108 outputs/on_off_modbus.py:133
msgid "Timeout (seconds)"
msgstr ""

#: inputs/modbus_tcp.py:110
msgid ""
"How long to wait for a response. One request takes at most timeout x "
"(retries + 1)"
msgstr ""

#: inputs/modbus_tcp.py:118 outputs/on_off_modbus.py:143
msgid "Retries"
msgstr ""

#: inputs/modbus_tcp.py:120 outputs/on_off_modbus.py:145
msgid ""
"Retries per request before it is treated as failed. Keep this low: a high "
"value multiplies how long an unreachable device blocks a command"
msgstr ""

#: inputs/modbus_tcp.py:139
msgid "Coil (read/write bit)"
msgstr ""

#: inputs/modbus_tcp.py:140
msgid "Discrete Input (read-only bit)"
msgstr ""

#: inputs/modbus_tcp.py:141
