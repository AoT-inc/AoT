#: aot_flask/templates/pages/geo/programs.html:318
msgid "The temperature at which photosynthesis is fastest."
msgstr ""

#: aot_flask/templates/pages/geo/programs.html:319
msgid "Temperature width"
msgstr ""

#: aot_flask/templates/pages/geo/programs.html:320
msgid ""
"How far from the optimum it still does well. Larger means less fussy about "
"temperature."
msgstr ""

#: aot_flask/templates/pages/geo/programs.html:321
msgid "VPD half-saturation"
msgstr ""

#: aot_flask/templates/pages/geo/programs.html:322
msgid ""
"The dryness of the air at which the stomata are half closed. Lower means it "
"suffers sooner in dry air."
msgstr ""

#: aot_flask/templates/pages/geo/programs.html:323
