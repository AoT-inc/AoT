#: inputs/remote_aot_input.py:73
msgid ""
"Collect measurements from another AoT server over the network using its "
"API. Enter the host and API key, set the number of measurements, and save"
" — the Remote Measurement dropdown is then filled with the channels "
"available on that server. Pick one per channel and set its Measurement "
"Unit to match the unit shown in the dropdown. Values arrive with the "
"remote timestamp, and any conversion configured on the remote channel is "
"already applied."
msgstr "通过API经网络从另一台AoT服务器收集测量值。输入主机和API密钥，设置测量数量并保存后，远程测量下拉列表会填入该服务器上可用的通道。每个通道选择一项，并将测量单位设置为与下拉列表中显示的单位一致。数值连同远程时间戳一并到达，且远程通道上配置的转换已经应用。"

#: inputs/remote_aot_input.py:96
msgid ""
"SECURITY: an AoT API key carries every permission of the user it belongs "
"to. For a collect-only connection, create a user on the remote server "
"whose role has only \"View Settings\" and use that user's key — a key "
"from an admin account would also grant control of that server's devices. "
"Keep TLS verification enabled unless you understand the risk."
msgstr "安全提示：AoT API密钥拥有其所属用户的全部权限。若仅用于收集，请在远程服务器上创建一个角色只有\"查看设置\"权限的用户，并使用该用户的密钥——管理员账户的密钥还会授予对该服务器设备的控制权。除非了解风险，否则请保持启用TLS验证。"

#: inputs/remote_aot_input.py:108
msgid "Remote AoT Host"
msgstr "远程 AoT 主机"

#: inputs/remote_aot_input.py:109 outputs/remote_output_on_off.py:75
#: outputs/remote_output_pwm.py:91
msgid ""
"The host or IP address of the remote AoT (a port may be included, e.g. "
"192.168.0.9:8084)"
msgstr "远程 AoT 的主机名或 IP 地址（可包含端口，例如 192.168.0.9:8084）"

#: inputs/remote_aot_input.py:116
msgid "Remote AoT API Key"
msgstr "远程 AoT API 密钥"

#: inputs/remote_aot_input.py:117 outputs/remote_output_on_off.py:83
#: outputs/remote_output_pwm.py:99
msgid "The API key of the remote AoT, exactly as shown on that server"
msgstr "远程 AoT 的 API 密钥，需与该服务器上显示的完全一致"

#: inputs/remote_aot_input.py:127 outputs/on_off_wireless_rpi_rf.py:91
#: outputs/remote_output_on_off.py:93 outputs/remote_output_pwm.py:109
msgid "Protocol"
msgstr "协议"

#: inputs/remote_aot_input.py:128 outputs/remote_output_on_off.py:94
#: outputs/remote_output_pwm.py:110
msgid ""
"Use HTTPS unless the remote AoT is only reachable over plain HTTP on a "
"trusted network"
msgstr "除非远程AoT仅能在受信任网络中通过明文HTTP访问，否则请使用HTTPS"

#: inputs/remote_aot_input.py:134 outputs/remote_output_on_off.py:100
#: outputs/remote_output_pwm.py:116
msgid "Verify TLS Certificate"
msgstr "验证TLS证书"

#: inputs/remote_aot_input.py:135 outputs/remote_output_on_off.py:101
#: outputs/remote_output_pwm.py:117
msgid ""
"Verify the remote server certificate. Turn this off only for a self-"
"signed certificate on a trusted network — while off, the API key can be "
"read by a man in the middle"
msgstr "验证远程服务器证书。仅在受信任网络中使用自签名证书时才关闭——关闭期间，中间人可能读取API密钥"

#: inputs/remote_aot_input.py:141 outputs/remote_output_pwm.py:123
msgid "Request Timeout (Seconds)"
msgstr "请求超时（秒）"

#: inputs/remote_aot_input.py:142
msgid ""
"HTTP read timeout. Raise it if the remote server is slow to answer a "
"large batch"
msgstr "HTTP读取超时。如果远程服务器处理大批量请求较慢，请调大此值"

#: inputs/remote_aot_input.py:148
msgid "Initial Backfill (Hours)"
msgstr "初始回填（小时）"

#: inputs/remote_aot_input.py:149
msgid ""
