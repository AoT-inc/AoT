msgstr ""
"Sélectionnez le nombre d'heures d'anticipation des données de prévision à"
" utiliser."

#: inputs/kma_weather_forecast.py:205
msgid "API Timeout (sec)"
msgstr "Délai d'expiration de l'API (s)"

#: inputs/kma_weather_forecast.py:206
msgid "Set the API response timeout (default 60 sec)."
msgstr "Définissez le délai d'expiration de la réponse de l'API (par défaut 60 s)."

#: inputs/kma_weather_forecast.py:214
