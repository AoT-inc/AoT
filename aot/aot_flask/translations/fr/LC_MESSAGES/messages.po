#: aot_flask/utils/utils_remote_host.py
#, python-format
msgid "Could not retrieve the TLS certificate from %(host)s: %(err)s"
msgstr "Impossible de récupérer le certificat TLS depuis %(host)s : %(err)s"

#: aot_flask/utils/utils_remote_host.py
#, python-format
msgid ""
"The TLS certificate of %(host)s does not match the one pinned earlier "
"(pinned %(old)s, now %(new)s). Nothing was sent. If the remote genuinely "
"replaced its certificate, delete this remote host and add it again; "
"otherwise the connection is being intercepted."
msgstr "Le certificat TLS de %(host)s ne correspond pas à celui épinglé précédemment (épinglé %(old)s, actuel %(new)s). Rien n'a été envoyé. Si l'hôte distant a réellement remplacé son certificat, supprimez cet hôte distant puis ajoutez-le à nouveau ; sinon, la connexion est interceptée."

#: aot_flask/utils/utils_remote_host.py
#, python-format
msgid "Could not enroll with %(host)s: %(err)s"
msgstr "Impossible de s'enregistrer auprès de %(host)s : %(err)s"

#: aot_flask/utils/utils_remote_host.py
#, python-format
msgid ""
"Pinned the certificate of %(host)s. Verify this fingerprint out of band "
"before trusting the connection: %(fp)s"
msgstr "Certificat de %(host)s épinglé. Vérifiez cette empreinte par un canal indépendant avant de faire confiance à la connexion : %(fp)s"

