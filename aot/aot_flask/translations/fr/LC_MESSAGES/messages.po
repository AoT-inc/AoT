msgstr ""
"Définissez le nombre de tentatives pour le même horaire d'annonce en cas "
"d'erreur HTTP."

#: inputs/kma_weather_forecast.py:223
msgid "API Retry Interval (sec)"
msgstr "Intervalle entre les tentatives de l'API (s)"

#: inputs/kma_weather_forecast.py:224
msgid "Time to wait between retries (default 3 sec)."
msgstr "Temps d'attente entre les tentatives (par défaut 3 s)."

