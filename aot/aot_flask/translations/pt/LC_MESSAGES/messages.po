#: ai/agents/ai_router.py:15
msgid ""
"Gatekeeper agent that classifies user intent into 5 categories (Control, "
"Data Query, Schedule, Composite, Chat) for v6 pipeline routing."
msgstr ""
"Agente gatekeeper que classifica a intenção do usuário em 5 categorias "
"(Controle, Consulta de dados, Agendamento, Composto, Chat) para o roteamento"
" do pipeline v6."

#: ai/agents/anthropic.py:30
msgid ""
"Anthropic's Claude engine, known for human-like reasoning, sophisticated "
"analysis, and safe response generation."
msgstr ""
"Motor Claude da Anthropic, conhecido pelo raciocínio próximo ao humano, "
"análise sofisticada e geração de respostas seguras."

#: ai/agents/gemini.py:30
msgid ""
"Google's state-of-the-art multimodal AI engine, capable of understanding and"
" generating text, code, and images with a massive context window."
msgstr ""
"Motor de IA multimodal de última geração do Google, capaz de compreender e "
"gerar texto, código e imagens com uma janela de contexto imensa."

#: ai/agents/groq.py:26
msgid ""
"Provides extremely fast inference speeds using Groq's LPU (Language "
"Processing Unit) technology, supporting models like Llama 3.3 and GPT-OSS."
msgstr ""
"Oferece velocidades de inferência extremamente rápidas usando a tecnologia "
"LPU (Language Processing Unit) da Groq, com suporte a modelos como Llama 3.3"
" e GPT-OSS."

#: ai/agents/mcp_aot.py:15
msgid ""
"AoT System Specialist. Queries sensor history, spatial hierarchy, device "
"search, and energy reports via internal system tools."
msgstr ""
"Especialista no sistema AoT. Consulta histórico de sensores, hierarquia "
"espacial, busca de dispositivos e relatórios de energia por meio de "
"ferramentas internas do sistema."

#: ai/agents/mcp_database.py:8
msgid ""
"Analyzes data by querying PostgreSQL/SQLite databases using natural "
"language."
msgstr ""
"Analisa dados consultando bancos de dados PostgreSQL/SQLite usando linguagem"
" natural."

#: ai/agents/mcp_excel.py:8
msgid ""
"Generates professional environmental reports in Excel based on analyzed "
"data."
msgstr ""
"Gera relatórios ambientais profissionais em Excel com base em dados "
"analisados."

#: ai/agents/mcp_fetch.py:8
msgid ""
"Collects real-time information by directly reading or exploring web page "
"content."
msgstr ""
"Coleta informações em tempo real lendo ou explorando diretamente o conteúdo "
"de páginas web."

#: ai/agents/mcp_google_maps.py:10
msgid ""
"Provides location-based information and geographical analysis using Google "
"Maps data."
msgstr ""
"Fornece informações baseadas em localização e análises geográficas usando "
"dados do Google Maps."

#: ai/agents/mcp_grafana.py:10
msgid ""
"Provides visual insights by analyzing Grafana dashboards and data, reporting"
" on detected anomalies."
msgstr ""
"Oferece insights visuais analisando dashboards e dados do Grafana, relatando"
" anomalias detectadas."

#: ai/agents/mcp_influxdb.py:9
msgid "Analyzes InfluxDB v2 time-series data and performs Flux queries."
msgstr ""
"Analisa dados de séries temporais do InfluxDB v2 e executa consultas Flux."

#: ai/agents/mcp_iotdb.py:10
msgid ""
"Performs precise analysis of large-scale time-series sensor data stored in "
"Apache IoTDB."
msgstr ""
"Realiza análises precisas de grandes volumes de dados de sensores em séries "
"temporais armazenados no Apache IoTDB."

#: ai/agents/minimax.py:26
msgid ""
"MiniMax M2 series MoE models — optimized for coding, agentic workflows, and "
"multilingual tasks. OpenAI-compatible API."
msgstr ""
"Modelos MoE da série MiniMax M2 — otimizados para codificação, fluxos de "
"trabalho com agentes e tarefas multilíngues. API compatível com OpenAI."

#: ai/agents/mistral.py:24
msgid ""
"Mistral engine, a powerful open/closed-source model developed in Europe, "
"boasting multilingual capabilities and exceptional efficiency."
msgstr ""
"Motor Mistral, um poderoso modelo de código aberto/fechado desenvolvido na "
"Europa, com capacidades multilíngues e eficiência excepcional."

#: ai/agents/ollama.py:25
msgid ""
"An open-source LLM engine that runs on the user's local PC, ensuring privacy"
" and functioning without an internet connection."
msgstr ""
"Motor LLM de código aberto que roda no PC local do usuário, garantindo "
"privacidade e funcionando sem conexão à internet."

#: ai/agents/openai.py:23
msgid ""
"OpenAI's widely recognized GPT engine, featuring powerful logical reasoning "
"and creative writing capabilities."
msgstr ""
"Motor GPT amplamente reconhecido da OpenAI, com poderosas capacidades de "
"raciocínio lógico e escrita criativa."

#: ai/agents/openai_compatible.py:43
msgid ""
"A generic driver for any provider that speaks the OpenAI Chat Completions "
