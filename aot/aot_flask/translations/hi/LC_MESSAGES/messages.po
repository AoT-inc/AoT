msgstr "उन फ़िल्टरों से कुछ भी मेल नहीं खाता।"

#: aot_flask/templates/pages/ai/ai_library.html:528
msgid "Showing"
msgstr "दिखाया जा रहा है"

#: aot_flask/templates/pages/ai/ai_library.html:529
msgid "of"
msgstr "में से"

#: aot_flask/templates/pages/ai/ai_library.html:530
msgid "Show more"
msgstr "और दिखाएं"

#: aot_flask/templates/pages/ai/ai_library.html:532
msgid "Set aside"
msgstr "अलग रखें"

#: aot_flask/templates/pages/ai/ai_library.html:533
msgid "Put back"
msgstr "वापस रखें"

