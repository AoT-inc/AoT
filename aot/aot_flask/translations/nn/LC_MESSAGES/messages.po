msgstr "Merkelappar"

#: actions/create_note.py:40
msgid "Select one or more tags"
msgstr "Vel éin eller fleire merkelappar"

#: actions/create_note.py:48
msgid "Title (if blank, auto-extracted from the first line of the body)"
msgstr ""
"Tittel (viss tom, blir han automatisk henta frå den fyrste linja i "
"innhaldet)"

#: actions/create_note.py:56
msgid "Note body"
msgstr "Notatinnhald"

#: actions/create_note.py:62
msgid "Include action message in body"
msgstr "Inkluder handlingsmelding i innhaldet"

