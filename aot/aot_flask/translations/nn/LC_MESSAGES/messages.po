msgstr ""
"Heartbeat-periode (minutt) som blir brukt når batteriet er lågt eller "
"kritisk. Bør vere >= KVILE-HB for å maksimere kvilelengda."

#: functions/lorawan_mode_manager.py:44
msgid "LoRaWAN Mode/Period Manager (RAK3172E)"
msgstr "LoRaWAN modus-/periodebehandlar (RAK3172E)"

#: functions/lorawan_mode_manager.py:47
msgid ""
"Determines the Class/heartbeat period based on battery, time of day, "
"valve activity, and link quality. Queues downlinks directly via "
"ChirpStack gRPC (DeviceService.Enqueue)."
msgstr ""
"Avgjer klasse/heartbeat-periode basert på batteri, tid på døgnet, "
"ventilaktivitet og sambandskvalitet. Køar nedlinker direkte via "
"ChirpStack gRPC (DeviceService.Enqueue)."

#: functions/lorawan_mode_manager.py:62
msgid "Controller (valve/actuator) — Class C preferred"
msgstr "Kontroller (ventil/aktuator) — klasse C føretrekt"

#: functions/lorawan_mode_manager.py:63
msgid "Sensor — Class A, low power (no gateway GPS required)"
msgstr "Sensor — klasse A, lågt straumforbruk (ingen gateway-GPS nødvendig)"

#: functions/lorawan_mode_manager.py:64
msgid "Hybrid — manual configuration"
msgstr "Hybrid — manuell konfigurasjon"

#: functions/lorawan_mode_manager.py:66
msgid "Device Role"
msgstr "Einingsrolle"

#: functions/lorawan_mode_manager.py:68
msgid ""
"controller: Class C during operating hours, B at night. sensor: Class A "
"always (no gateway GPS required), longer HB at night. hybrid: follow the "
"settings below exactly."
msgstr ""
"kontroller: klasse C i driftstida, B om natta. sensor: alltid klasse A "
"(ingen gateway-GPS nødvendig), lengre HB om natta. hybrid: følgjer "
"innstillingane nedanfor nøyaktig."

