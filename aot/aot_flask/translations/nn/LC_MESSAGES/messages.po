msgid "Roles"
msgstr "Roller"

#: aot_flask/templates/settings/users.html:98
msgid "Edit User"
msgstr "Rediger brukar"

#: aot_flask/templates/settings/users.html:141
msgid "Edit Role"
msgstr "Rediger rolle"

#: aot_flask/templates/settings/users.html:166
msgid ""
"Groups restrict who can operate a resource. Every user can still view all"
" data."
msgstr ""
"Grupper avgrensar kven som kan styre ein ressurs. Alle brukarar kan "
"framleis sjå all data."

#: aot_flask/templates/settings/users.html:181
msgid "Edit Group"
msgstr "Rediger gruppe"

#: aot_flask/templates/settings/users.html:207
msgid ""
"No groups yet. Without a group, every user operates every resource their "
