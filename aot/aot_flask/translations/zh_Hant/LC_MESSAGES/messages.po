#: aot_flask/templates/settings/diagnostic.html:42
#: aot_flask/templates/settings/diagnostic.html:49
#: aot_flask/templates/settings/diagnostic.html:56
#: aot_flask/templates/settings/diagnostic.html:63
#: aot_flask/templates/settings/diagnostic.html:80
#: aot_flask/templates/settings/diagnostic.html:87
#: aot_flask/templates/settings/diagnostic.html:94
#: aot_flask/templates/settings/diagnostic.html:101
