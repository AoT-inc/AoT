msgstr "輸入名稱"

#: aot_flask/static/js/dist/geo-design.bundle.js:93
msgid "Apply Filter"
msgstr "套用篩選"

#: aot_flask/static/js/dist/geo-design.bundle.js:93
msgid "Design Summary"
msgstr "設計摘要"

#: aot_flask/static/js/dist/geo-design.bundle.js:96
msgid "Site Count"
msgstr "站點數量"

#: aot_flask/static/js/dist/geo-design.bundle.js:96
msgid "Zone Count"
msgstr "區域數量"

#: aot_flask/static/js/dist/geo-design.bundle.js:96
msgid "Pipe Length"
msgstr "管線長度"

#: aot_flask/static/js/dist/geo-design.bundle.js:96
