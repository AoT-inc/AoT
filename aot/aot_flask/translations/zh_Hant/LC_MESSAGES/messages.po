#: ai/agents/ai_router.py:15
msgid ""
"Gatekeeper agent that classifies user intent into 5 categories (Control, "
"Data Query, Schedule, Composite, Chat) for v6 pipeline routing."
msgstr "守門員代理，將使用者意圖分類為 5 種類別（控制、資料查詢、排程、複合、聊天），用於 v6 流程路由。"

#: ai/agents/anthropic.py:30
msgid ""
"Anthropic's Claude engine, known for human-like reasoning, sophisticated "
"analysis, and safe response generation."
msgstr "Anthropic 的 Claude 引擎，以接近人類的推理、精細的分析和安全的回應生成而聞名。"

#: ai/agents/gemini.py:30
msgid ""
"Google's state-of-the-art multimodal AI engine, capable of understanding "
"and generating text, code, and images with a massive context window."
msgstr "Google 最先進的多模態 AI 引擎，具備龐大的上下文視窗，能理解並生成文字、程式碼與圖像。"

#: ai/agents/groq.py:26
msgid ""
"Provides extremely fast inference speeds using Groq's LPU (Language "
"Processing Unit) technology, supporting models like Llama 3.3 and GPT-"
"OSS."
msgstr ""
"採用 Groq 的 LPU（Language Processing Unit）技術，提供極快的推論速度，支援 Llama 3.3、GPT-OSS "
"等模型。"

#: ai/agents/mcp_aot.py:15
msgid ""
"AoT System Specialist. Queries sensor history, spatial hierarchy, device "
"search, and energy reports via internal system tools."
msgstr "AoT 系統專家。透過內部系統工具查詢感測器歷史紀錄、空間階層、裝置搜尋及能源報告。"

#: ai/agents/mcp_database.py:8
msgid ""
"Analyzes data by querying PostgreSQL/SQLite databases using natural "
"language."
msgstr "以自然語言查詢 PostgreSQL/SQLite 資料庫來分析資料。"

#: ai/agents/mcp_excel.py:8
msgid ""
"Generates professional environmental reports in Excel based on analyzed "
"data."
msgstr "根據分析後的資料生成專業的環境報告（Excel 格式）。"

#: ai/agents/mcp_fetch.py:8
msgid ""
"Collects real-time information by directly reading or exploring web page "
"content."
msgstr "透過直接讀取或探索網頁內容來收集即時資訊。"

#: ai/agents/mcp_google_maps.py:10
msgid ""
"Provides location-based information and geographical analysis using "
"Google Maps data."
msgstr "利用 Google 地圖資料提供以位置為基礎的資訊與地理分析。"

#: ai/agents/mcp_grafana.py:10
msgid ""
"Provides visual insights by analyzing Grafana dashboards and data, "
"reporting on detected anomalies."
msgstr "分析 Grafana 儀表板與資料，提供視覺化洞察並回報偵測到的異常狀況。"

#: ai/agents/mcp_influxdb.py:9
msgid "Analyzes InfluxDB v2 time-series data and performs Flux queries."
msgstr "分析 InfluxDB v2 時間序列資料並執行 Flux 查詢。"

#: ai/agents/mcp_iotdb.py:10
msgid ""
"Performs precise analysis of large-scale time-series sensor data stored "
"in Apache IoTDB."
msgstr "對儲存在 Apache IoTDB 中的大規模時間序列感測器資料進行精確分析。"

#: ai/agents/minimax.py:26
msgid ""
"MiniMax M2 series MoE models — optimized for coding, agentic workflows, "
"and multilingual tasks. OpenAI-compatible API."
msgstr "MiniMax M2 系列 MoE 模型 — 針對程式撰寫、代理式工作流程與多語言任務優化，提供與 OpenAI 相容的 API。"

#: ai/agents/mistral.py:24
msgid ""
"Mistral engine, a powerful open/closed-source model developed in Europe, "
"boasting multilingual capabilities and exceptional efficiency."
msgstr "Mistral 引擎，一款在歐洲開發的強大開源／閉源模型，具備多語言能力與卓越效率。"

#: ai/agents/ollama.py:25
msgid ""
"An open-source LLM engine that runs on the user's local PC, ensuring "
"privacy and functioning without an internet connection."
msgstr "在使用者本機 PC 上運行的開源 LLM 引擎，可保護隱私並在無網路連線的情況下運作。"

#: ai/agents/openai.py:23
msgid ""
"OpenAI's widely recognized GPT engine, featuring powerful logical "
"reasoning and creative writing capabilities."
msgstr "OpenAI 廣受認可的 GPT 引擎，具備強大的邏輯推理與創意寫作能力。"

#: ai/agents/openai_compatible.py:43
msgid ""
"A generic driver for any provider that speaks the OpenAI Chat Completions"
" wire format but does not have a dedicated engine here yet. Use this to "
"connect a new provider without writing code."
msgstr "適用於任何採用 OpenAI Chat Completions 通訊格式、但尚無專屬引擎的供應商的通用驅動程式。可用來連接新供應商而無需撰寫程式碼。"

#: ai/services/agent_loop_service.py:173
#, python-format
msgid ""
"'%(name)s' doesn't match a single known place in the system. Which "
"location did you mean?"
msgstr "「%(name)s」無法對應到系統中唯一一個已知的地點。您指的是哪個位置？"

#: ai/services/agent_loop_service.py:697
msgid ""
"I went through several steps but couldn't reach a conclusion. Could you "
"break the request down and try again?"
msgstr "我已經過多個步驟，仍無法得出結論。可以請您將需求拆分得更細，再試一次嗎？"

#: ai/services/ai_agent_service.py:946
msgid ""
"This month's AI usage limit has been reached; AI features are paused. "
"They resume automatically on the 1st of next month."
msgstr "本月的 AI 使用量已達上限，AI 功能已暫停使用。將於下個月 1 日自動恢復。"

#: ai/services/ai_agent_service.py:1806 ai/services/ai_agent_service.py:1811
msgid "Scheduling completed."
msgstr "排程已完成。"

#: ai/services/ai_agent_service.py:1840 ai/services/ai_agent_service.py:2085
msgid "Action requires your approval before execution."
msgstr "此操作在執行前需要您的批准。"

#: ai/services/ai_agent_service.py:2179
msgid ""
"Sorry, the service is unstable and could not generate a response. Please "
"try again shortly."
msgstr "抱歉，服務目前不穩定，無法生成回應。請稍後再試一次。"

#: ai/services/ai_agent_service.py:2267
msgid "Intent parsing failed. Providing worker insights:"
msgstr "意圖解析失敗。提供工作者洞察："

#: ai/services/ai_agent_service.py:2273
msgid ""
"I couldn't process your request properly. Please try rephrasing your "
"command."
msgstr "無法正確處理您的請求。請嘗試以不同方式重新表達您的指令。"

#: ai/services/ai_agent_service.py:3459
#, python-format
msgid "Prepared a draft to run [%(device)s] for %(minutes)s minutes. Approve?"
msgstr "已準備好草案，將 [%(device)s] 運作 %(minutes)s 分鐘。要批准嗎？"

#: ai/services/ai_agent_service.py:3463
#, python-format
msgid ""
"Prepared a control draft for [%(device)s]. Tap the button below to "
"approve; the device is controlled only after you approve."
msgstr "已準備好 [%(device)s] 的控制草案。請點擊下方按鈕以批准；批准後裝置才會受到控制。"

#: ai/services/ai_agent_service.py:3468 ai/services/ai_agent_service.py:3531
msgid ""
"[Device control request] Tap the button below to approve; the device is "
"controlled only after you approve."
msgstr "[裝置控制請求] 請點擊下方按鈕以批准；批准後裝置才會受到控制。"

