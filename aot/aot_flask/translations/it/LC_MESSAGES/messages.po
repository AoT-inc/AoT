msgstr "Ancora nulla qui. Premere \"Raccogli nomi\" per raccogliere i nomi in uso."

#: aot_flask/templates/settings/translations.html:81
msgid "Original"
msgstr "Originale"

#: aot_flask/templates/settings/translations.html:82
msgid "Translation"
msgstr "Traduzione"

#: aot_flask/templates/settings/translations.html:103
msgid "Edited"
msgstr "Modificato"

#: aot_flask/templates/settings/translations.html:111
