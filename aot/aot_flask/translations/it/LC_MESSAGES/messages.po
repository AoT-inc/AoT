#: aot_flask/templates/settings/user_detail.html:149
msgid "No API keys issued."
msgstr "Nessuna chiave API emessa."

#: aot_flask/templates/settings/user_detail.html:161
msgid "Read-only keys can fetch data but cannot change anything."
msgstr ""
"Le chiavi di sola lettura possono recuperare i dati ma non possono "
"modificare nulla."

#: aot_flask/templates/settings/user_detail.html:169
msgid ""
"Name the client this key is for, so you know what you are cutting off "
"later."
msgstr ""
"Assegnare un nome al client a cui è destinata questa chiave, così sarà "
"chiaro cosa si sta disattivando in seguito."

#: aot_flask/templates/settings/user_detail.html:169
msgid "Issue New Key"
msgstr "Emetti nuova chiave"

#: aot_flask/templates/settings/user_detail.html:172
msgid "e.g. ChatGPT, Claude Desktop"
msgstr "ad es. ChatGPT, Claude Desktop"

#: aot_flask/templates/settings/user_detail.html:184
msgid "New Key"
msgstr "Nuova chiave"

#: aot_flask/templates/settings/user_detail.html:193
msgid "Copy it now — it is shown only once and cannot be retrieved later."
msgstr ""
"Copialo ora — viene mostrato una sola volta e non potrà essere recuperato"
