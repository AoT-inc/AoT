msgid "Data Position Offset"
msgstr "Scostamento posizione dati"

#: widgets/AoT_gauge_angular.py:350
msgid ""
"Set the vertical position offset of the data text inside the gauge "
"(numeric only)."
msgstr ""
"Imposta lo scostamento verticale del testo dei dati all'interno "
"dell'indicatore (solo numerico)."

#: widgets/AoT_graph.py:240
msgid "AoT Graph"
msgstr "Grafico AoT"

#: widgets/AoT_graph.py:244
msgid ""
"Displays a synchronous graph. Data selected will be displayed on the "
"X-axis for the configured duration."
msgstr ""
"Mostra un grafico sincrono. I dati selezionati vengono visualizzati "
"sull'asse X per la durata configurata."

#: widgets/AoT_graph.py:294
msgid "Time Axis Settings"
msgstr "Impostazioni dell'asse temporale"

#: widgets/AoT_graph.py:315
msgid "Select the unit for the X-axis duration."
msgstr "Seleziona l'unità per la durata dell'asse X."

#: widgets/AoT_graph.py:323
msgid "Enter the duration to display on the X-axis."
msgstr "Inserire la durata da visualizzare sull'asse X."

#: widgets/AoT_graph.py:329
msgid "Enable Auto Refresh"
msgstr "Abilita aggiornamento automatico"

#: widgets/AoT_graph.py:330
msgid "Automatically refresh graph data at the specified interval."
msgstr "Aggiorna automaticamente i dati del grafico all'intervallo specificato."

#: widgets/AoT_graph.py:336
msgid "Enable X-Axis Reset"
msgstr "Abilita reimpostazione asse X"

#: widgets/AoT_graph.py:337
msgid "Reset the X-axis when refreshing the graph."
msgstr "Ripristina l'asse X all'aggiornamento del grafico."

#: widgets/AoT_graph.py:341
msgid "Graph Style"
msgstr "Stile del grafico"

#: widgets/AoT_graph.py:347
msgid "Enable Header Buttons"
msgstr "Abilita pulsanti nell'intestazione"

#: widgets/AoT_graph.py:348
msgid "Display graph control buttons in the widget header."
msgstr "Mostra i pulsanti di controllo del grafico nell'intestazione del widget."

#: widgets/AoT_graph.py:354
msgid "Enable Title"
msgstr "Abilita titolo"

#: widgets/AoT_graph.py:355
msgid "Display the graph title."
msgstr "Mostra il titolo del grafico."

#: widgets/AoT_graph.py:361
msgid "Enable NavBar"
msgstr "Abilita barra di navigazione"

#: widgets/AoT_graph.py:362
msgid "Enable the graph navigation bar."
msgstr "Abilita la barra di navigazione del grafico."

#: widgets/AoT_graph.py:368
msgid "Shade Night"
msgstr "Ombreggia la notte"

#: widgets/AoT_graph.py:369
msgid ""
"Shades the periods between sunset and sunrise so readings can be read "
"against the solar day rather than the clock. Sun times come from this "
"farm's location."
msgstr ""
"Ombreggia i periodi tra il tramonto e l'alba, in modo che le letture "
"possano essere lette rispetto al giorno solare anziché all'orologio. Gli "
"orari solari provengono dalla posizione di questa azienda agricola."

#: widgets/AoT_graph.py:375
msgid "Enable Export"
msgstr "Abilita esportazione"

#: widgets/AoT_graph.py:376
msgid "Enable the button to export the graph."
msgstr "Abilita il pulsante per esportare il grafico."

#: widgets/AoT_graph.py:382
msgid "Enable Range Selector"
msgstr "Abilita selettore di intervallo"

#: widgets/AoT_graph.py:383
msgid "Enable the graph range selector."
msgstr "Abilita il selettore di intervallo del grafico."

#: widgets/AoT_graph.py:389
msgid "Enable Legend"
msgstr "Abilita legenda"

#: widgets/AoT_graph.py:390
msgid "Display the legend at the bottom of the graph."
msgstr "Mostra la legenda nella parte inferiore del grafico."

#: widgets/AoT_graph.py:396
msgid "Hide Axis Labels on Mobile"
msgstr "Nascondi le etichette degli assi su dispositivi mobili"

#: widgets/AoT_graph.py:397
msgid ""
"Hide graph axis tick labels and unit titles on small screens (chart width"
" < 480px)."
msgstr ""
"Nascondi le etichette degli assi del grafico e i titoli delle unità sugli"
" schermi piccoli (larghezza del grafico < 480 px)."

#: widgets/AoT_graph.py:403
msgid "Axis Font Size (em)"
msgstr "Dimensione carattere asse (em)"

#: widgets/AoT_graph.py:404
msgid "Set the font size for graph axes (em)."
msgstr "Imposta la dimensione del carattere per gli assi del grafico (em)."

#: widgets/AoT_graph.py:410
msgid "Axis Title Font Size (em)"
msgstr "Dimensione carattere titolo asse (em)"

#: widgets/AoT_graph.py:411
msgid "Set the font size for graph axis titles (em)."
msgstr ""
"Imposta la dimensione del carattere per i titoli degli assi del grafico "
"(em)."

#: widgets/AoT_graph.py:417
msgid "Legend Font Size (em)"
msgstr "Dimensione carattere legenda (em)"

#: widgets/AoT_graph.py:418
msgid "Set the font size for the legend (em)."
msgstr "Imposta la dimensione del carattere per la legenda (em)."

#: widgets/AoT_graph.py:424
msgid "Title Font Size (em)"
msgstr "Dimensione del carattere del titolo (em)"

#: widgets/AoT_graph.py:425
msgid "Set the font size for the title (em)."
msgstr "Imposta la dimensione del carattere per il titolo (em)."

#: widgets/AoT_graph.py:429
msgid "Data Source"
msgstr "Fonte dati"

#: widgets/AoT_graph.py:478
msgid "Note Tag"
msgstr "Tag della nota"

#: widgets/AoT_graph.py:483
msgid "Press <kbd>Ctrl</kbd> or <kbd>&#8984;</kbd> to select multiple items."
msgstr ""
"Tenere premuto <kbd>Ctrl</kbd> o <kbd>&#8984;</kbd> per selezionare più "
"elementi."

#: widgets/AoT_map.py:489
msgid "AoT Map"
msgstr "Mappa AoT"

#: widgets/AoT_map.py:499
msgid ""
"Displays the location of the selected device on a map. Highlights the "
"operating state with the selected color. Supports 3D terrain, pitch, and "
"bearing."
msgstr ""
"Mostra la posizione del dispositivo selezionato su una mappa. Evidenzia "
"lo stato operativo con il colore selezionato. Supporta terreno 3D, "
"inclinazione e orientamento."

#: widgets/AoT_map.py:534
msgid ""
"All devices placed on this map in the map editor are shown automatically."
" Add or move devices in <a href=\"/geo/design\" target=\"_blank\" "
"rel=\"noopener\">Map Editor (geo/design)</a>."
msgstr ""
"Tutti i dispositivi posizionati su questa mappa nell'editor mappe vengono"
" mostrati automaticamente. Aggiungere o spostare i dispositivi in <a "
"href=\"/geo/design\" target=\"_blank\" rel=\"noopener\">Editor mappe "
"(geo/design)</a>."

#: widgets/AoT_map.py:545
msgid "Select Map"
msgstr "Seleziona mappa"

#: widgets/AoT_map.py:546
msgid "Select a map. Leave empty to use the most recently modified map."
msgstr ""
"Seleziona una mappa. Lascia vuoto per utilizzare la mappa modificata più "
"di recente."

#: widgets/AoT_map.py:559
msgid "Show Labels"
msgstr "Mostra etichette"

#: widgets/AoT_map.py:561
msgid ""
"Master switch for all map labels (site, zone, device, sensor). Use the "
"map's label controller to fine-tune input/output/function labels."
msgstr ""
"Interruttore principale per tutte le etichette della mappa (sito, zona, "
"dispositivo, sensore). Usa il controller delle etichette della mappa per "
"regolare con precisione le etichette di ingresso/uscita/funzione."

#: widgets/AoT_map.py:569
msgid "Display Data Only (Hide Map)"
msgstr "Mostra solo i dati (nascondi mappa)"

#: widgets/AoT_map.py:570
msgid "Hide the overlay map and show only the data panel."
msgstr "Nascondi la mappa in sovrapposizione e mostra solo il pannello dei dati."

#: widgets/AoT_map.py:581
msgid "Show AI Advice"
msgstr "Mostra consigli IA"

#: widgets/AoT_map.py:583
msgid ""
"Display the latest periodic AI advice summary for this map's "
"facility/site."
msgstr ""
"Mostra l'ultimo riepilogo periodico dei consigli dell'IA per "
"l'impianto/sito di questa mappa."

#: widgets/AoT_map.py:597
msgid "Show Local Time"
msgstr "Mostra ora locale"

#: widgets/AoT_map.py:599
msgid ""
"Show a dock at the top of the map with the current time, sunrise and "
"sunset for wherever the map is centered."
msgstr ""
"Mostra un dock nella parte superiore della mappa con l'ora attuale, "
"l'alba e il tramonto relativi al punto su cui è centrata la mappa."

#: widgets/AoT_map.py:617
msgid "Data Transfer Period"
msgstr "Periodo di trasferimento dati"

#: widgets/AoT_map.py:623
msgid "Widget Refresh Period (Seconds)"
msgstr "Periodo di aggiornamento del widget (secondi)"

#: widgets/AoT_map.py:624
msgid "Refresh the widget every N seconds. 0 to disable."
msgstr "Aggiorna il widget ogni N secondi. 0 per disabilitare."

#: widgets/AoT_map.py:631
msgid "Input Value Refresh Period (Seconds)"
msgstr "Periodo di aggiornamento dei valori di ingresso (secondi)"

#: widgets/AoT_map.py:632
msgid "How often input measurement values in the panel are refreshed."
msgstr ""
"Con quale frequenza vengono aggiornati i valori di misura in ingresso nel"
" pannello."

#: widgets/AoT_map.py:639
msgid "Output Status Refresh Period (Seconds)"
msgstr "Periodo di aggiornamento dello stato di uscita (secondi)"

#: widgets/AoT_map.py:640
msgid "How often output on/off status is refreshed on the map."
msgstr ""
"Con quale frequenza viene aggiornato sulla mappa lo stato di "
"accensione/spegnimento dell'uscita."

#: widgets/AoT_map.py:667
msgid "Device Filter"
msgstr "Filtro dispositivo"

#: widgets/AoT_map.py:672
msgid ""
"Nothing is selected by default, so every device placed on the map is "
"shown. Devices you select below are hidden from the map."
msgstr ""
"Per impostazione predefinita non è selezionato nulla, quindi vengono "
"mostrati tutti i dispositivi posizionati sulla mappa. I dispositivi "
"selezionati qui sotto vengono nascosti dalla mappa."

#: widgets/AoT_map.py:683
msgid "Select inputs to hide. Leave empty to show all placed inputs."
msgstr ""
"Seleziona gli ingressi da nascondere. Lascia vuoto per mostrare tutti gli"
" ingressi posizionati."

#: widgets/AoT_map.py:692
msgid "Select outputs to hide. Leave empty to show all placed outputs."
msgstr ""
"Seleziona le uscite da nascondere. Lascia vuoto per mostrare tutte le "
"uscite posizionate."

#: widgets/AoT_map.py:701
msgid "Select functions to hide. Leave empty to show all placed functions."
msgstr ""
"Seleziona le funzioni da nascondere. Lascia vuoto per mostrare tutte le "
"funzioni posizionate."

#: widgets/AoT_map.py:711
msgid "Measurement Panel"
msgstr "Pannello di misurazione"

#: widgets/AoT_map.py:721
msgid "Show Measurement Panel"
msgstr "Mostra pannello misurazioni"

#: widgets/AoT_map.py:723
msgid ""
"Show the measurement panel dock. Turn off to hide it entirely, even if "
"measurements are selected below."
msgstr ""
"Mostra il dock del pannello misurazioni. Disattiva per nasconderlo del "
"tutto, anche se sotto sono selezionate delle misurazioni."

#: widgets/AoT_map.py:734
msgid "Select input measurements to display in the panel."
msgstr "Seleziona le misurazioni degli ingressi da visualizzare nel pannello."

#: widgets/AoT_map.py:743
msgid "Select output measurements to display in the panel."
msgstr "Seleziona le misurazioni delle uscite da visualizzare nel pannello."

#: widgets/AoT_map.py:752
msgid "Select function measurements to display in the panel."
msgstr "Seleziona le misurazioni delle funzioni da visualizzare nel pannello."

#: widgets/AoT_map.py:762
msgid "Label Style"
msgstr "Stile etichetta"

#: widgets/AoT_map.py:769
msgid "Prevent Label Collision"
msgstr "Evita la sovrapposizione delle etichette"

#: widgets/AoT_map.py:770
msgid "Automatically hide overlapping labels when enabled."
msgstr "Nasconde automaticamente le etichette sovrapposte quando abilitato."

#: widgets/AoT_map.py:777
msgid "Label Text Size"
msgstr "Dimensione testo etichetta"

#: widgets/AoT_map.py:778
msgid "Specify the size of all map labels (unit: em)."
msgstr "Specifica la dimensione di tutte le etichette della mappa (unità: em)."

#: widgets/AoT_map.py:789
msgid "Hide Labels When Zoomed Out — L1"
msgstr "Nascondi etichette quando lo zoom è ridotto — L1"

#: widgets/AoT_map.py:791
msgid ""
"Below this zoom level, output / input / function / equipment / sensor / "
"plot / bay / note labels and value keys are hidden. Site labels always "
"stay visible so the map keeps its bearings. Zone and facility labels have"
" their own threshold below (L2). Set 0 to never hide."
msgstr ""
"Al di sotto di questo livello di zoom, le etichette di uscita / ingresso "
"/ funzione / attrezzatura / sensore / parcella / baia / nota e le chiavi "
"dei valori vengono nascoste. Le etichette dei siti restano sempre "
"visibili, così la mappa mantiene i propri riferimenti. Le etichette di "
"zona e struttura hanno una propria soglia riportata di seguito (L2). "
"Impostare 0 per non nascondere mai."

#: widgets/AoT_map.py:808
msgid "Hide Labels & Shapes When Zoomed Out — L2"
msgstr "Nascondi etichette e forme quando lo zoom è ridotto — L2"

#: widgets/AoT_map.py:810
msgid ""
"A second, independent zoom threshold — currently for zone/facility labels"
" and zone/plot/equipment shapes. They need to stay visible at a wider "
"zoom than L1 above, so they get their own value here. More label and "
"shape kinds may be added to this tier later. Set 0 to never hide."
msgstr ""
"Una seconda soglia di zoom indipendente, attualmente per le etichette di "
"zona/struttura e le forme di zona/particella/attrezzatura. Devono "
"rimanere visibili con uno zoom più ampio rispetto a L1 sopra, quindi qui "
"hanno un valore proprio. Altri tipi di etichette e forme potranno essere "
"aggiunti a questo livello in futuro. Impostare 0 per non nasconderle mai."

#: widgets/AoT_map.py:823
msgid "Facility-centric Labels"
msgstr "Etichette centrate sulla struttura"

#: widgets/AoT_map.py:825
msgid ""
"Off (default): outdoor-centric — site/zone labels stay visible at all "
"zoom levels; facility and sensor labels appear only when zoomed in. On: "
"facility-centric — facility and sensor labels take priority; site/zone "
"labels yield and merge when zoomed out."
msgstr ""
"Off (predefinito): centrato sull'esterno — le etichette di sito/zona "
"restano visibili a tutti i livelli di zoom; le etichette di impianto e "
"sensore appaiono solo quando si esegue lo zoom avanti. On: centrato "
"sull'impianto — le etichette di impianto e sensore hanno priorità; le "
"etichette di sito/zona cedono il passo e si uniscono quando si esegue lo "
"zoom indietro."

#: widgets/AoT_map.py:840
msgid "Circle (integer value)"
msgstr "Cerchio (valore intero)"

#: widgets/AoT_map.py:841
msgid "Text label"
msgstr "Etichetta di testo"

#: widgets/AoT_map.py:843
msgid "Sensor Marker Style"
msgstr "Stile del marcatore del sensore"

#: widgets/AoT_map.py:844
msgid ""
"Circle: compact round marker showing the first measurement as an integer,"
" colored by measurement band. Text: full value label."
msgstr ""
"Cerchio: indicatore rotondo compatto che mostra la prima misurazione come"
" numero intero, colorato in base alla fascia di misurazione. Testo: "
"etichetta con il valore completo."

#: widgets/AoT_map.py:862
msgid "Environment & Control"
msgstr "Ambiente e controllo"

#: widgets/AoT_map.py:863
msgid "About"
msgstr "Informazioni"

#: widgets/AoT_map.py:865
msgid "Popup Default Tab"
msgstr "Scheda predefinita del popup"

#: widgets/AoT_map.py:866
msgid ""
"Which tab opens first in the zone and facility modals. The device modal "
"has no tabs."
msgstr ""
"Quale scheda si apre per prima nelle finestre modali di zona e impianto. "
"La finestra modale del dispositivo non ha schede."

#: widgets/AoT_map.py:883
msgid "Site Shape"
msgstr "Forma del sito"

#: widgets/AoT_map.py:884
msgid "Show Site polygons on the map."
msgstr "Mostra sulla mappa i poligoni dei siti."

#: widgets/AoT_map.py:891
msgid "Zone Shape"
msgstr "Forma zona"

#: widgets/AoT_map.py:892
msgid "Show Zone polygons on the map."
msgstr "Mostra sulla mappa i poligoni delle zone."

#: widgets/AoT_map.py:910
msgid "Plot Shape"
msgstr "Forma dell'appezzamento"

#: widgets/AoT_map.py:912
msgid "Show plots (what is where) on the map. Plot labels appear when zoomed in."
msgstr ""
"Mostra le particelle (cosa si trova dove) sulla mappa. Le etichette delle"
" particelle appaiono con lo zoom avanzato."

#: widgets/AoT_map.py:921
msgid "Facility Shape"
msgstr "Forma struttura"

#: widgets/AoT_map.py:922
msgid "Show Facility polygons on the map."
msgstr "Mostra sulla mappa i poligoni delle strutture."

#: widgets/AoT_map.py:929
msgid "Equipment Shape"
msgstr "Forma attrezzatura"

#: widgets/AoT_map.py:930
msgid "Show Equipment (e.g., pipes) shapes on the map."
msgstr "Mostra sulla mappa le forme delle apparecchiature (ad es. tubazioni)."

#: widgets/AoT_map.py:937
msgid "Device Shape"
msgstr "Forma del dispositivo"

#: widgets/AoT_map.py:938
msgid "Show Device shape areas on the map."
msgstr "Mostra le aree delle forme dei dispositivi sulla mappa."

#: widgets/AoT_map.py:945
msgid "Other Drawn Shapes"
msgstr "Altre forme disegnate"

#: widgets/AoT_map.py:946
msgid "Show freeform shapes created with drawing tools."
msgstr "Mostra le forme libere create con gli strumenti di disegno."

#: widgets/AoT_map.py:952
msgid "Device Shape Opacity"
msgstr "Opacità della forma del dispositivo"

#: widgets/AoT_map.py:953
msgid "0 (Transparent) ~ 100 (Opaque)"
msgstr "0 (Trasparente) ~ 100 (Opaco)"

#: widgets/AoT_map.py:964
msgid "3D Map (Vector Mode)"
msgstr "Mappa 3D (modalità vettoriale)"

#: widgets/AoT_map.py:971
msgid "Enable 3D Terrain"
msgstr "Abilita terreno 3D"

#: widgets/AoT_map.py:972
msgid "Enable 3D terrain rendering (Hillshade, elevation). Requires vector mode."
msgstr ""
"Abilita il rendering del terreno 3D (ombreggiatura del rilievo, "
"elevazione). Richiede la modalità vettoriale."

#: widgets/AoT_map.py:984
msgid "Facility Render Mode"
msgstr "Modalità di rendering struttura"

#: widgets/AoT_map.py:986
msgid ""
"Render style for the 3D facility overlay on the map. "
"Solid/Wireframe/Performance reduce GPU load."
msgstr ""
"Stile di rendering per la sovrapposizione 3D della struttura sulla mappa."
" Solido/Wireframe/Prestazioni riducono il carico sulla GPU."

#: widgets/AoT_map.py:995
msgid "Vector Style URL"
msgstr "URL stile vettoriale"

#: widgets/AoT_map.py:996
msgid "Custom MapLibre style JSON URL. Leave empty to use GIS input setting."
msgstr ""
"URL JSON dello stile MapLibre personalizzato. Lascia vuoto per usare "
"l'impostazione dell'Input GIS."

#: widgets/AoT_output_pwm.py:56
msgid "AoT PWM Output"
msgstr "Uscita PWM AoT"

#: widgets/AoT_output_pwm.py:60
msgid "Displays and controls a PWM output with a single slider."
msgstr "Mostra e controlla un'uscita PWM con un unico cursore."

#: widgets/AoT_output_pwm.py:74
msgid "Select the output to display and control"
msgstr "Seleziona l'uscita da visualizzare e controllare"

#: widgets/AoT_output_pwm.py:83 widgets/AoT_output_value.py:86
#: widgets/widget_camera.py:285 widgets/widget_function_status.py:264
#: widgets/widget_gauge_solid.py:192 widgets/widget_indicator.py:75
#: widgets/widget_measurement.py:71 widgets/widget_measurement_multi.py:107
#: widgets/widget_python_code.py:174 widgets/widget_trigger_sequence.py:473
msgid "The period of time between refreshing the widget"
msgstr "L'intervallo di tempo tra un aggiornamento e l'altro del widget"

#: widgets/AoT_output_value.py:57
msgid "AoT Actuator Position"
msgstr "Posizione attuatore AoT"

#: widgets/AoT_output_value.py:62
msgid ""
"Displays and controls a positional (open/close) actuator: close/stop/open"
" buttons plus a fine-adjust slider."
msgstr ""
"Mostra e controlla un attuatore posizionale (apri/chiudi): pulsanti "
"chiudi/stop/apri più un cursore per la regolazione fine."

#: widgets/AoT_output_value.py:77
msgid "Select the actuator to display and control"
msgstr "Seleziona l'attuatore da visualizzare e controllare"

#: widgets/AoT_plot.py:352
msgid "AoT Plot"
msgstr "Parcella AoT"

#: widgets/AoT_plot.py:357
msgid ""
"One plot at a glance: stage timeline, targets against current readings, "
"trends, and accumulated heat. Edit its schedule, guidance and targets "
"from here."
msgstr ""
"Un appezzamento in un colpo d'occhio: cronologia delle fasi, obiettivi "
"rispetto alle letture attuali, tendenze e calore accumulato. Modifica "
"pianificazione, indicazioni e obiettivi da qui."

#: widgets/AoT_plot.py:377
msgid "What to monitor"
msgstr "Cosa monitorare"

#: widgets/AoT_plot.py:383
msgid "Progress"
msgstr "Avanzamento"

#: widgets/AoT_plot.py:385
msgid "Stage timeline with today and past transitions marked."
msgstr "Cronologia delle fasi con oggi e le transizioni passate evidenziate."

#: widgets/AoT_plot.py:391
msgid "Targets vs now"
msgstr "Obiettivi rispetto a ora"

#: widgets/AoT_plot.py:393
msgid ""
"Current readings against the targets and limits this stage declares. One "
"gets the gauge, the rest are listed as text."
msgstr ""
"Le letture correnti rispetto agli obiettivi e ai limiti dichiarati da "
"questa fase. Una viene mostrata nell'indicatore, le altre sono elencate "
"come testo."

#: widgets/AoT_plot.py:400
msgid "Trends"
msgstr "Tendenze"

#: widgets/AoT_plot.py:402
msgid ""
"Fills the rows that have no axis with a recent trend line. Needs the "
"targets block."
msgstr ""
"Riempie le righe prive di asse con una linea di tendenza recente. "
"Richiede il blocco degli obiettivi."

#: widgets/AoT_plot.py:409
msgid "Accumulated heat"
msgstr "Calore accumulato"

#: widgets/AoT_plot.py:411
msgid ""
"How far this stage has come in growing degree days. Shown only when the "
"programme declares a base temperature."
msgstr ""
"Quanto è avanzata questa fase in gradi giorno di crescita. Visualizzato "
"solo quando il programma dichiara una temperatura di base."

#: widgets/AoT_plot.py:422
msgid "Soil moisture"
msgstr "Umidità del suolo"

#: widgets/AoT_plot.py:424
msgid "Gauge metric"
msgstr "Metrica dell'indicatore"

#: widgets/AoT_plot.py:426
msgid ""
"Which measurement gets the gauge. The rest are listed as text. If this "
"plot does not measure it, the first one with a range is shown instead."
msgstr ""
"Quale misurazione riceve l'indicatore. Le altre vengono elencate come "
"testo. Se questo appezzamento non la misura, viene mostrata invece la "
"prima con un intervallo."

#: widgets/AoT_plot.py:440
msgid ""
"Minutes between reloads. Stages move by the day, so short intervals only "
"add load."
msgstr ""
"Minuti tra i ricaricamenti. Gli stadi avanzano di giorno in giorno, "
"quindi intervalli brevi aggiungono solo carico."

#: widgets/AoT_timer.py:76
msgid "Must be a number."
msgstr "Deve essere un numero."

