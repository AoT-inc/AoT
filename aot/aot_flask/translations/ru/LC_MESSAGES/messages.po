msgstr "Шторы"

#: aot_flask/templates/pages/geo/geo_facility.html:626
#: aot_flask/templates/pages/geo/geo_facility.html:1283
msgid "Ceiling thermal curtain"
msgstr "Потолочная теплозащитная штора"

#: aot_flask/templates/pages/geo/geo_facility.html:638
