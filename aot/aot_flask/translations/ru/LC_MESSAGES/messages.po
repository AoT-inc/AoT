msgstr "Смещение в минутах от времени восхода/захода солнца"

#: aot_flask/templates/pages/function_options/trigger_options/timer_daily_time_span.html:21
msgid "Time interval between actions."
msgstr "Интервал времени между действиями."

#: aot_flask/templates/pages/function_options/trigger_options/timer_duration.html:5
msgid "Execute conditional actions at regular intervals."
msgstr "Выполнять условные действия через регулярные интервалы."

#: aot_flask/templates/pages/function_options/trigger_options/timer_duration.html:11
msgid "Time to wait before starting timer"
msgstr "Время ожидания перед запуском таймера"

