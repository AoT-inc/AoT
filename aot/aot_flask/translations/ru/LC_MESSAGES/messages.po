msgstr "Привод"

#: aot_flask/templates/pages/geo/geo_facility.html:784
msgid "Layer height (m)"
msgstr "Высота слоя (м)"

#: aot_flask/templates/pages/geo/geo_facility.html:785
msgid ""
"Install height of pipes and devices — changing it moves all pipes in the "
"layer"
msgstr "Высота установки труб и устройств — изменение перемещает все трубы в слое"

#: aot_flask/templates/pages/geo/geo_facility.html:793
