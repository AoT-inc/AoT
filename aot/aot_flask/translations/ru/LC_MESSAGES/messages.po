msgid "Camera ID"
msgstr "ID камеры"

#: widgets/AoT_camera.py:60
msgid "Select the camera instance to display"
msgstr "Выберите экземпляр камеры для отображения"

#: widgets/AoT_camera.py:71
msgid "Display Mode"
msgstr "Режим отображения"

#: widgets/AoT_camera.py:77
msgid "Refresh Rate (sec)"
msgstr "Частота обновления (сек)"

#: widgets/AoT_controller.py:145
msgid "AoT Controller Switch"
msgstr "Переключатель контроллера AoT"

#: widgets/AoT_controller.py:149
msgid "Switch to turn controllers on and off."
msgstr "Переключатель для включения и выключения контроллеров."

#: widgets/AoT_controller.py:179
msgid "Select the controller."
msgstr "Выберите контроллер."

#: widgets/AoT_controller.py:188
msgid "Frequency of widget refresh (seconds)"
msgstr "Частота обновления виджета (сек.)"

#: widgets/AoT_facility.py:372
msgid "AoT Facility"
msgstr "Объект AoT"

#: widgets/AoT_facility.py:383
msgid ""
"Facility 3D view, environment summary, setpoint editor, actuator control "
"grid, and AI advice."
msgstr ""
"3D-вид объекта, сводка по среде, редактор уставок, сетка управления "
"исполнительными механизмами и рекомендации ИИ."

#: widgets/AoT_facility.py:402
msgid "Refresh interval for runtime data. 0 to disable."
msgstr "Интервал обновления данных времени выполнения. 0 — отключить."

#: widgets/AoT_facility.py:411
msgid "IEC Function"
msgstr "Функция IEC"

#: widgets/AoT_facility.py:413
msgid ""
"Select the Integrated Environment Control function. The linked facility "
"is auto-discovered from the function configuration. Leave blank to auto-"
"select the first activated env_coordinator."
msgstr ""
"Выберите функцию комплексного управления средой. Связанный объект "
"определяется автоматически из конфигурации функции. Оставьте поле пустым,"
" чтобы автоматически выбрать первый активированный env_coordinator."

#: widgets/AoT_facility.py:422
msgid "Show AI Advice (§ E) — EXPERIMENTAL"
msgstr "Показать рекомендации ИИ (§ E) — ЭКСПЕРИМЕНТАЛЬНО"

#: widgets/AoT_facility.py:424
msgid ""
"Display AI recommendation cards. WARNING: currently shows MOCK demo cards"
" with hardcoded text. The Approve button still dispatches real actuator "
"commands via /api/geo/facility/<uuid>/apply, so do NOT enable in "
"production until a real advisor backend is wired up."
msgstr ""
"Отображать карточки рекомендаций ИИ. ВНИМАНИЕ: в настоящее время "
"отображаются ДЕМОНСТРАЦИОННЫЕ карточки с жёстко заданным текстом. Кнопка "
"«Утвердить» по-прежнему отправляет реальные команды исполнительным "
"устройствам через /api/geo/facility/<uuid>/apply, поэтому НЕ включайте в "
"рабочей среде, пока не будет подключён настоящий сервис рекомендаций."

#: widgets/AoT_facility.py:432
msgid "Integrated Environment Control (IEC)"
msgstr "Комплексное управление микроклиматом (IEC)"

#: widgets/AoT_facility.py:438
msgid "Show Status Strip (§ 0)"
msgstr "Показать полосу статуса (§ 0)"

#: widgets/AoT_facility.py:439
msgid "Show emergency/warn/active/idle badge. Control mode only."
msgstr ""
"Показывать значок аварии/предупреждения/активности/простоя. Только в "
"режиме управления."

#: widgets/AoT_facility.py:445
msgid "Show Setpoints (§ C)"
msgstr "Показать уставки (§ C)"

#: widgets/AoT_facility.py:446
msgid "Show target temp/RH/CO2 editor. Control mode only."
msgstr ""
"Показывать редактор целевых значений темп./влажн./CO2. Только в режиме "
"управления."

#: widgets/AoT_facility.py:452
msgid "Show Actuator Grid (§ D)"
msgstr "Показать сетку приводов (§ D)"

#: widgets/AoT_facility.py:453
msgid "Show actuator sliders and toggles. Control mode only."
msgstr "Показывать ползунки и переключатели приводов. Только в режиме управления."

#: widgets/AoT_facility.py:459
msgid "Show Emergency Stop"
msgstr "Показать аварийную остановку"

#: widgets/AoT_facility.py:460
msgid "Show ALL STOP button in actuator grid. Requires explicit activation."
msgstr ""
"Показать кнопку «ОСТАНОВИТЬ ВСЁ» в сетке приводов. Требует явной "
"активации."

#: widgets/AoT_facility.py:466
msgid "3D Rendering"
msgstr "3D-рендеринг"

#: widgets/AoT_facility.py:473 widgets/AoT_map.py:979
msgid "Default (transparent)"
msgstr "По умолчанию (прозрачный)"

#: widgets/AoT_facility.py:474 widgets/AoT_map.py:980
msgid "Solid (opaque)"
msgstr "Сплошной (непрозрачный)"

#: widgets/AoT_facility.py:475 widgets/AoT_map.py:981
msgid "Wireframe"
msgstr "Каркас"

#: widgets/AoT_facility.py:476 widgets/AoT_map.py:982
msgid "Performance (mobile)"
msgstr "Производительность (мобильные устройства)"

#: widgets/AoT_facility.py:478
msgid "Render Mode"
msgstr "Режим отрисовки"

#: widgets/AoT_facility.py:480
msgid ""
"Default: semi-transparent cover. Solid: opaque, lower overdraw. "
"Wireframe: outlines only. Performance: simplified shading + reduced "
"resolution for mobile."
msgstr ""
"По умолчанию: полупрозрачное покрытие. Сплошной: непрозрачный, меньше "
"перерисовки. Каркас: только контуры. Производительность: упрощённое "
"затенение и сниженное разрешение для мобильных устройств."

#: widgets/AoT_facility.py:490
msgid "Sensor Labels"
msgstr "Метки датчиков"

#: widgets/AoT_facility.py:496
msgid "Show Sensor Labels"
msgstr "Показать метки датчиков"

#: widgets/AoT_facility.py:497
msgid "Display realtime measurement values next to each sensor in the 3D scene."
msgstr ""
"Отображать значения измерений в реальном времени рядом с каждым датчиком "
"в 3D-сцене."

#: widgets/AoT_facility.py:503
msgid "Max Channels Shown"
msgstr "Макс. число отображаемых каналов"

#: widgets/AoT_facility.py:504
msgid ""
"Number of measurement values shown per label. Extra channels collapse to "
"\"+\"."
msgstr ""
"Количество значений измерений, отображаемых на метку. Дополнительные "
"каналы сворачиваются в «+»."

#: widgets/AoT_facility.py:511
msgid "Decimals"
msgstr "Знаки после запятой"

#: widgets/AoT_facility.py:512
msgid "Decimal places for label values."
msgstr "Число знаков после запятой для значений подписей."

#: widgets/AoT_facility.py:519
msgid "Label Size (em)"
msgstr "Размер метки (em)"

#: widgets/AoT_facility.py:520
msgid "Font size of sensor labels in em units."
msgstr "Размер шрифта подписей датчиков в единицах em."

#: widgets/AoT_facility.py:527
msgid "Label Background"
msgstr "Фон метки"

#: widgets/AoT_facility.py:528
msgid "CSS color for label background."
msgstr "Цвет CSS для фона метки."

#: widgets/AoT_facility.py:534
msgid "Label Text Color"
msgstr "Цвет текста метки"

#: widgets/AoT_facility.py:535
msgid "CSS color for label text."
msgstr "Цвет CSS для текста метки."

#: widgets/AoT_facility.py:541
msgid "Vertical Offset (m)"
msgstr "Вертикальное смещение (м)"

#: widgets/AoT_facility.py:542
msgid "Distance above the sensor (in meters) where the label is anchored."
msgstr "Расстояние над датчиком (в метрах), на котором закрепляется метка."

#: widgets/AoT_facility.py:549
msgid "Label Opacity"
msgstr "Непрозрачность метки"

#: widgets/AoT_facility.py:550
msgid "Opacity of sensor value labels (0.0–1.0)."
msgstr "Непрозрачность подписей значений датчиков (0.0–1.0)."

#: widgets/AoT_facility.py:557 widgets/AoT_map.py:850
msgid "Enable Sensor Popup"
msgstr "Включить всплывающее окно датчика"

#: widgets/AoT_facility.py:558 widgets/AoT_map.py:851
msgid "Click a sensor label to open a detail popup with the last 24h chart."
msgstr ""
"Щёлкните метку датчика, чтобы открыть всплывающее окно с подробным "
"графиком за последние 24 часа."

#: widgets/AoT_gauge_angular.py:210
msgid "AoT Circular Gauge"
msgstr "Круговой индикатор AoT"

#: widgets/AoT_gauge_angular.py:215
msgid ""
"Displays data in a circular gauge. Ensure the maximum value option "
"matches the last section (High) for correct display. Selecting presets "
"like Temperature, Humidity, or VPD automatically sets min/max values and "
"color sections."
msgstr ""
"Отображает данные в виде кругового индикатора. Убедитесь, что параметр "
"максимального значения соответствует последнему разделу («Верхний»), для "
"корректного отображения. Выбор пресетов, таких как «Температура», "
"«Влажность» или VPD, автоматически задаёт мин/макс значения и цветовые "
"разделы."

#: widgets/AoT_gauge_angular.py:240 widgets/AoT_graph.py:277
msgid ""
"Highcharts is free for open source and personal use. However, if used as "
"part of a commercial product, a commercial license may be required. "
"Please check https://shop.highsoft.com for the most accurate information."
msgstr ""
"Highcharts бесплатен для проектов с открытым исходным кодом и личного "
"использования. Однако при использовании в составе коммерческого продукта "
"может потребоваться коммерческая лицензия. Актуальную информацию "
"уточняйте на https://shop.highsoft.com."

#: widgets/AoT_gauge_angular.py:260 widgets/AoT_graph.py:439
#: widgets/AoT_graph.py:449 widgets/AoT_graph.py:459 widgets/AoT_graph.py:469
#: widgets/AoT_graph.py:479
msgid "Select the measurement to display"
msgstr "Выберите измерение для отображения"

#: widgets/AoT_gauge_angular.py:269
msgid "Set the maximum valid time for the measurement"
msgstr "Задайте максимальное время действительности измерения"

#: widgets/AoT_gauge_angular.py:278 widgets/AoT_graph.py:303
msgid "Set the refresh interval for the widget"
msgstr "Задайте интервал обновления виджета"

#: widgets/AoT_gauge_angular.py:285
msgid "Set the number of decimal places to display"
msgstr "Задайте количество отображаемых десятичных знаков"

#: widgets/AoT_gauge_angular.py:291 widgets/AoT_wind_angular.py:224
msgid "Minimum Value"
msgstr "Минимальное значение"

#: widgets/AoT_gauge_angular.py:292
msgid "Set the minimum value of the gauge"
msgstr "Задайте минимальное значение индикатора"

#: widgets/AoT_gauge_angular.py:298 widgets/AoT_wind_angular.py:231
msgid "Maximum Value"
msgstr "Максимальное значение"

#: widgets/AoT_gauge_angular.py:299
msgid "Set the maximum value of the gauge"
msgstr "Задайте максимальное значение индикатора"

#: widgets/AoT_gauge_angular.py:305
msgid "Number of Color Sections"
msgstr "Количество цветовых секций"

#: widgets/AoT_gauge_angular.py:306
msgid "Set the number of sections to distinguish gauge colors"
msgstr "Задайте количество секций для различения цветов индикатора"

#: widgets/AoT_gauge_angular.py:318
msgid "Preset Config"
msgstr "Конфигурация пресета"

#: widgets/AoT_gauge_angular.py:319
msgid ""
"Selecting a preset configuration automatically applies default settings "
"such as min/max values. Preset gauges follow the global band colors "
"(Settings > Custom UI); choose Custom to set individual section colors."
msgstr ""
"Выбор предустановленной конфигурации автоматически применяет настройки по"
" умолчанию, такие как минимальные/максимальные значения. "
"Предустановленные индикаторы используют глобальные цвета диапазонов "
"(Настройки > Пользовательский интерфейс); выберите «Пользовательский», "
"чтобы задать цвета отдельных секций."

#: widgets/AoT_gauge_angular.py:326 widgets/AoT_wind_angular.py:238
msgid "Data Font Size"
msgstr "Размер шрифта данных"

#: widgets/AoT_gauge_angular.py:327
msgid "Set the font size of the data inside the gauge. Default is 1.5 (medium)."
msgstr ""
"Задайте размер шрифта данных внутри индикатора. По умолчанию 1.5 "
"(средний)."

#: widgets/AoT_gauge_angular.py:334 widgets/AoT_wind_angular.py:245
msgid "Unit Font Size"
msgstr "Размер шрифта единицы измерения"

#: widgets/AoT_gauge_angular.py:335
msgid "Set the font size of the unit inside the gauge. Default is 0.7 (small)."
msgstr ""
"Задайте размер шрифта единицы измерения внутри индикатора. По умолчанию "
"0.7 (маленький)."

#: widgets/AoT_gauge_angular.py:342
msgid "Unit Font Weight"
msgstr "Насыщенность шрифта единицы измерения"

#: widgets/AoT_gauge_angular.py:343
msgid "Set the font weight inside the gauge. Default is 500 (medium)."
msgstr "Задайте насыщенность шрифта внутри индикатора. По умолчанию 500 (средняя)."

#: widgets/AoT_gauge_angular.py:349 widgets/AoT_wind_angular.py:280
msgid "Data Position Offset"
msgstr "Смещение положения данных"

#: widgets/AoT_gauge_angular.py:350
msgid ""
"Set the vertical position offset of the data text inside the gauge "
"(numeric only)."
msgstr ""
"Задайте смещение вертикального положения текста данных внутри индикатора "
"(только числовое значение)."

#: widgets/AoT_graph.py:240
msgid "AoT Graph"
msgstr "График AoT"

#: widgets/AoT_graph.py:244
msgid ""
"Displays a synchronous graph. Data selected will be displayed on the "
"X-axis for the configured duration."
msgstr ""
"Отображает синхронный график. Выбранные данные будут отображаться по оси "
"X в течение заданной продолжительности."

#: widgets/AoT_graph.py:294
msgid "Time Axis Settings"
msgstr "Настройки оси времени"

#: widgets/AoT_graph.py:315
msgid "Select the unit for the X-axis duration."
msgstr "Выберите единицу измерения для продолжительности по оси X."

#: widgets/AoT_graph.py:323
msgid "Enter the duration to display on the X-axis."
msgstr "Введите продолжительность для отображения по оси X."

#: widgets/AoT_graph.py:329
msgid "Enable Auto Refresh"
msgstr "Включить автообновление"

#: widgets/AoT_graph.py:330
msgid "Automatically refresh graph data at the specified interval."
msgstr "Автоматически обновлять данные графика с заданным интервалом."

#: widgets/AoT_graph.py:336
msgid "Enable X-Axis Reset"
msgstr "Включить сброс оси X"

#: widgets/AoT_graph.py:337
msgid "Reset the X-axis when refreshing the graph."
msgstr "Сбрасывать ось X при обновлении графика."

#: widgets/AoT_graph.py:341
msgid "Graph Style"
msgstr "Стиль графика"

#: widgets/AoT_graph.py:347
msgid "Enable Header Buttons"
msgstr "Включить кнопки в заголовке"

#: widgets/AoT_graph.py:348
msgid "Display graph control buttons in the widget header."
msgstr "Отображать кнопки управления графиком в заголовке виджета."

#: widgets/AoT_graph.py:354
msgid "Enable Title"
msgstr "Включить заголовок"

#: widgets/AoT_graph.py:355
msgid "Display the graph title."
msgstr "Отображать заголовок графика."

#: widgets/AoT_graph.py:361
msgid "Enable NavBar"
msgstr "Включить панель навигации"

#: widgets/AoT_graph.py:362
msgid "Enable the graph navigation bar."
msgstr "Включить панель навигации графика."

#: widgets/AoT_graph.py:368
msgid "Shade Night"
msgstr "Затенение ночи"

#: widgets/AoT_graph.py:369
msgid ""
"Shades the periods between sunset and sunrise so readings can be read "
"against the solar day rather than the clock. Sun times come from this "
"farm's location."
msgstr "Затеняет периоды между закатом и восходом, чтобы показания можно было читать относительно солнечного дня, а не часов. Время восхода и заката берётся из местоположения этой фермы."

#: widgets/AoT_graph.py:375
msgid "Enable Export"
msgstr "Включить экспорт"

#: widgets/AoT_graph.py:376
msgid "Enable the button to export the graph."
msgstr "Включить кнопку экспорта графика."

#: widgets/AoT_graph.py:382
msgid "Enable Range Selector"
msgstr "Включить селектор диапазона"

#: widgets/AoT_graph.py:383
msgid "Enable the graph range selector."
msgstr "Включить селектор диапазона графика."

#: widgets/AoT_graph.py:389
msgid "Enable Legend"
msgstr "Включить легенду"

#: widgets/AoT_graph.py:390
msgid "Display the legend at the bottom of the graph."
msgstr "Отображать легенду внизу графика."

#: widgets/AoT_graph.py:396
msgid "Hide Axis Labels on Mobile"
msgstr "Скрывать подписи осей на мобильных устройствах"

#: widgets/AoT_graph.py:397
msgid ""
"Hide graph axis tick labels and unit titles on small screens (chart width"
" < 480px)."
msgstr ""
"Скрывать подписи делений осей и названия единиц измерения графика на "
"маленьких экранах (ширина графика < 480px)."

#: widgets/AoT_graph.py:403
msgid "Axis Font Size (em)"
msgstr "Размер шрифта оси (em)"

#: widgets/AoT_graph.py:404
msgid "Set the font size for graph axes (em)."
msgstr "Задайте размер шрифта для осей графика (em)."

#: widgets/AoT_graph.py:410
msgid "Axis Title Font Size (em)"
msgstr "Размер шрифта заголовка оси (em)"

#: widgets/AoT_graph.py:411
msgid "Set the font size for graph axis titles (em)."
msgstr "Задайте размер шрифта для названий осей графика (em)."

#: widgets/AoT_graph.py:417
msgid "Legend Font Size (em)"
msgstr "Размер шрифта легенды (em)"

#: widgets/AoT_graph.py:418
msgid "Set the font size for the legend (em)."
msgstr "Задайте размер шрифта легенды (em)."

#: widgets/AoT_graph.py:424
msgid "Title Font Size (em)"
msgstr "Размер шрифта заголовка (em)"

#: widgets/AoT_graph.py:425
msgid "Set the font size for the title (em)."
msgstr "Задайте размер шрифта заголовка (em)."

#: widgets/AoT_graph.py:429
msgid "Data Source"
msgstr "Источник данных"

#: widgets/AoT_graph.py:478
msgid "Note Tag"
msgstr "Тег заметки"

#: widgets/AoT_graph.py:483
msgid "Press <kbd>Ctrl</kbd> or <kbd>&#8984;</kbd> to select multiple items."
msgstr ""
"Удерживайте <kbd>Ctrl</kbd> или <kbd>&#8984;</kbd>, чтобы выбрать "
"несколько элементов."

#: widgets/AoT_map.py:489
msgid "AoT Map"
msgstr "Карта AoT"

#: widgets/AoT_map.py:499
msgid ""
"Displays the location of the selected device on a map. Highlights the "
"operating state with the selected color. Supports 3D terrain, pitch, and "
"bearing."
msgstr ""
"Отображает местоположение выбранного устройства на карте. Выделяет "
"рабочее состояние выбранным цветом. Поддерживает 3D-рельеф, наклон и "
"азимут."

#: widgets/AoT_map.py:534
msgid ""
"All devices placed on this map in the map editor are shown automatically."
" Add or move devices in <a href=\"/geo/design\" target=\"_blank\" "
"rel=\"noopener\">Map Editor (geo/design)</a>."
msgstr ""
"Все устройства, размещенные на этой карте в редакторе карт, отображаются "
"автоматически. Добавляйте или перемещайте устройства в <a "
"href=\"/geo/design\" target=\"_blank\" rel=\"noopener\">редакторе карт "
"(geo/design)</a>."

#: widgets/AoT_map.py:545
msgid "Select Map"
msgstr "Выберите карту"

#: widgets/AoT_map.py:546
msgid "Select a map. Leave empty to use the most recently modified map."
msgstr ""
"Выберите карту. Оставьте поле пустым, чтобы использовать последнюю "
"изменённую карту."

#: widgets/AoT_map.py:559
msgid "Show Labels"
msgstr "Показать метки"

#: widgets/AoT_map.py:561
msgid ""
"Master switch for all map labels (site, zone, device, sensor). Use the "
"map's label controller to fine-tune input/output/function labels."
msgstr ""
"Главный переключатель для всех подписей на карте (участок, зона, "
"устройство, датчик). Используйте контроллер подписей карты для точной "
"настройки подписей входов/выходов/функций."

#: widgets/AoT_map.py:569
msgid "Display Data Only (Hide Map)"
msgstr "Отображать только данные (скрыть карту)"

#: widgets/AoT_map.py:570
msgid "Hide the overlay map and show only the data panel."
msgstr "Скрыть карту-наложение и показывать только панель данных."

#: widgets/AoT_map.py:581
msgid "Show AI Advice"
msgstr "Показать рекомендации ИИ"

#: widgets/AoT_map.py:583
msgid ""
"Display the latest periodic AI advice summary for this map's "
"facility/site."
msgstr ""
"Отображать последнюю периодическую сводку рекомендаций ИИ для "
"объекта/участка этой карты."

#: widgets/AoT_map.py:597
msgid "Show Local Time"
msgstr "Показывать местное время"

#: widgets/AoT_map.py:599
msgid ""
"Show a dock at the top of the map with the current time, sunrise and "
"sunset for wherever the map is centered."
msgstr "Показывать панель в верхней части карты с текущим временем, восходом и закатом для точки, в которой центрирована карта."

#: widgets/AoT_map.py:617
msgid "Data Transfer Period"
msgstr "Период передачи данных"

#: widgets/AoT_map.py:623
msgid "Widget Refresh Period (Seconds)"
msgstr "Период обновления виджета (секунды)"

#: widgets/AoT_map.py:624
msgid "Refresh the widget every N seconds. 0 to disable."
msgstr "Обновлять виджет каждые N секунд. 0 — отключить."

#: widgets/AoT_map.py:631
msgid "Input Value Refresh Period (Seconds)"
msgstr "Период обновления входных значений (секунды)"

#: widgets/AoT_map.py:632
msgid "How often input measurement values in the panel are refreshed."
msgstr "Как часто обновляются значения входных измерений на панели."

#: widgets/AoT_map.py:639
msgid "Output Status Refresh Period (Seconds)"
msgstr "Период обновления состояния выхода (секунды)"

#: widgets/AoT_map.py:640
msgid "How often output on/off status is refreshed on the map."
msgstr "Как часто на карте обновляется состояние вкл/выкл выхода."

#: widgets/AoT_map.py:667
msgid "Device Filter"
msgstr "Фильтр устройств"

#: widgets/AoT_map.py:672
msgid ""
"Nothing is selected by default, so every device placed on the map is "
"shown. Devices you select below are hidden from the map."
msgstr ""
"По умолчанию ничего не выбрано, поэтому на карте отображаются все "
"размещённые устройства. Устройства, выбранные ниже, скрываются с карты."

#: widgets/AoT_map.py:683
msgid "Select inputs to hide. Leave empty to show all placed inputs."
msgstr ""
"Выберите входы, которые нужно скрыть. Оставьте пустым, чтобы показать все"
" размещённые входы."

#: widgets/AoT_map.py:692
msgid "Select outputs to hide. Leave empty to show all placed outputs."
msgstr ""
"Выберите выходы, которые нужно скрыть. Оставьте пустым, чтобы показать "
"все размещённые выходы."

#: widgets/AoT_map.py:701
msgid "Select functions to hide. Leave empty to show all placed functions."
msgstr ""
"Выберите функции, которые нужно скрыть. Оставьте пустым, чтобы показать "
"все размещённые функции."

#: widgets/AoT_map.py:711
msgid "Measurement Panel"
msgstr "Панель измерений"

#: widgets/AoT_map.py:721
msgid "Show Measurement Panel"
msgstr "Показывать панель измерений"

#: widgets/AoT_map.py:723
msgid ""
"Show the measurement panel dock. Turn off to hide it entirely, even if "
"measurements are selected below."
msgstr "Показывать панель измерений. Отключите, чтобы полностью скрыть её, даже если ниже выбраны измерения."

#: widgets/AoT_map.py:734
msgid "Select input measurements to display in the panel."
msgstr "Выберите измерения входов для отображения на панели."

#: widgets/AoT_map.py:743
msgid "Select output measurements to display in the panel."
msgstr "Выберите измерения выходов для отображения на панели."

#: widgets/AoT_map.py:752
msgid "Select function measurements to display in the panel."
msgstr "Выберите измерения функций для отображения на панели."

#: widgets/AoT_map.py:762
msgid "Label Style"
msgstr "Стиль метки"

#: widgets/AoT_map.py:769
msgid "Prevent Label Collision"
msgstr "Предотвращать наложение подписей"

#: widgets/AoT_map.py:770
msgid "Automatically hide overlapping labels when enabled."
msgstr "При включении автоматически скрывать перекрывающиеся подписи."

#: widgets/AoT_map.py:777
msgid "Label Text Size"
msgstr "Размер текста метки"

#: widgets/AoT_map.py:778
msgid "Specify the size of all map labels (unit: em)."
msgstr "Задайте размер всех подписей на карте (единица измерения: em)."

#: widgets/AoT_map.py:789
msgid "Hide Labels When Zoomed Out — L1"
msgstr "Скрывать подписи при уменьшении масштаба — L1"

#: widgets/AoT_map.py:791
msgid ""
"Below this zoom level, output / input / function / equipment / sensor / "
"plot / bay / note labels and value keys are hidden. Site labels always "
"stay visible so the map keeps its bearings. Zone and facility labels have"
" their own threshold below (L2). Set 0 to never hide."
msgstr "Ниже этого уровня масштаба подписи выходов / входов / функций / оборудования / датчиков / участков / отсеков / заметок и ключи значений скрываются. Подписи площадок остаются видимыми всегда, чтобы карта не теряла ориентиры. У подписей зон и сооружений есть свой порог ниже (L2). Установите 0, чтобы никогда не скрывать."

#: widgets/AoT_map.py:808
msgid "Hide Labels & Shapes When Zoomed Out — L2"
msgstr "Скрывать подписи и фигуры при уменьшении масштаба — L2"

#: widgets/AoT_map.py:810
msgid ""
"A second, independent zoom threshold — currently for zone/facility labels"
" and zone/plot/equipment shapes. They need to stay visible at a wider "
"zoom than L1 above, so they get their own value here. More label and "
"shape kinds may be added to this tier later. Set 0 to never hide."
msgstr "Второй, независимый порог масштаба — сейчас для подписей зон/сооружений и фигур зон/участков/оборудования. Они должны оставаться видимыми при более широком масштабе, чем L1 выше, поэтому здесь задаётся отдельное значение. В будущем к этому уровню могут добавиться другие виды подписей и фигур. Установите 0, чтобы никогда не скрывать."

#: widgets/AoT_map.py:823
msgid "Facility-centric Labels"
msgstr "Подписи, ориентированные на объект"

#: widgets/AoT_map.py:825
msgid ""
"Off (default): outdoor-centric — site/zone labels stay visible at all "
"zoom levels; facility and sensor labels appear only when zoomed in. On: "
"facility-centric — facility and sensor labels take priority; site/zone "
"labels yield and merge when zoomed out."
msgstr ""
"Выкл (по умолчанию): ориентация на открытую местность — подписи "
"участков/зон остаются видимыми на всех уровнях масштабирования; подписи "
"объектов и датчиков появляются только при увеличении. Вкл: ориентация на "
"объект — подписи объектов и датчиков имеют приоритет; подписи "
"участков/зон уступают и объединяются при уменьшении масштаба."

#: widgets/AoT_map.py:840
msgid "Circle (integer value)"
msgstr "Круг (целое значение)"

#: widgets/AoT_map.py:841
msgid "Text label"
msgstr "Текстовая метка"

#: widgets/AoT_map.py:843
msgid "Sensor Marker Style"
msgstr "Стиль маркера датчика"

#: widgets/AoT_map.py:844
msgid ""
"Circle: compact round marker showing the first measurement as an integer,"
" colored by measurement band. Text: full value label."
msgstr ""
"Круг: компактный круглый маркер, показывающий первое измерение в виде "
"целого числа, окрашенный по диапазону измерения. Текст: полная подпись "
"значения."

#: widgets/AoT_map.py:861
msgid "Overview"
msgstr "Обзор"

#: widgets/AoT_map.py:862
msgid "Environment & Control"
msgstr "Среда и управление"

#: widgets/AoT_map.py:863
msgid "About"
msgstr "О программе"

#: widgets/AoT_map.py:865
msgid "Popup Default Tab"
msgstr "Вкладка всплывающего окна по умолчанию"

#: widgets/AoT_map.py:866
msgid ""
"Which tab opens first in the zone and facility modals. The device modal "
"has no tabs."
msgstr "Какая вкладка открывается первой в модальных окнах зоны и объекта. В модальном окне устройства вкладок нет."

#: widgets/AoT_map.py:883
msgid "Site Shape"
msgstr "Форма участка"

#: widgets/AoT_map.py:884
msgid "Show Site polygons on the map."
msgstr "Показывать полигоны участков на карте."

#: widgets/AoT_map.py:891
msgid "Zone Shape"
msgstr "Форма зоны"

#: widgets/AoT_map.py:892
msgid "Show Zone polygons on the map."
msgstr "Показывать полигоны зон на карте."

#: widgets/AoT_map.py:910
msgid "Plot Shape"
msgstr "Форма участка"

#: widgets/AoT_map.py:912
msgid "Show plots (what is where) on the map. Plot labels appear when zoomed in."
msgstr "Показывать участки (что где находится) на карте. Подписи участков появляются при увеличении масштаба."

#: widgets/AoT_map.py:921
msgid "Facility Shape"
msgstr "Форма объекта"

#: widgets/AoT_map.py:922
msgid "Show Facility polygons on the map."
msgstr "Показывать полигоны объектов на карте."

#: widgets/AoT_map.py:929
msgid "Equipment Shape"
msgstr "Форма оборудования"

#: widgets/AoT_map.py:930
msgid "Show Equipment (e.g., pipes) shapes on the map."
msgstr "Показывать фигуры оборудования (например, труб) на карте."

#: widgets/AoT_map.py:937
msgid "Device Shape"
msgstr "Форма устройства"

#: widgets/AoT_map.py:938
msgid "Show Device shape areas on the map."
msgstr "Показывать области фигур устройств на карте."

#: widgets/AoT_map.py:945
msgid "Other Drawn Shapes"
msgstr "Другие нарисованные фигуры"

#: widgets/AoT_map.py:946
msgid "Show freeform shapes created with drawing tools."
msgstr "Показывать произвольные фигуры, созданные инструментами рисования."

#: widgets/AoT_map.py:952
msgid "Device Shape Opacity"
msgstr "Непрозрачность формы устройства"

#: widgets/AoT_map.py:953
msgid "0 (Transparent) ~ 100 (Opaque)"
msgstr "0 (прозрачный) ~ 100 (непрозрачный)"

#: widgets/AoT_map.py:964
msgid "3D Map (Vector Mode)"
msgstr "3D-карта (векторный режим)"

#: widgets/AoT_map.py:971
msgid "Enable 3D Terrain"
msgstr "Включить 3D-рельеф"

#: widgets/AoT_map.py:972
msgid "Enable 3D terrain rendering (Hillshade, elevation). Requires vector mode."
msgstr ""
"Включить отрисовку 3D-рельефа (отмывка рельефа, высота). Требуется "
"векторный режим."

#: widgets/AoT_map.py:984
msgid "Facility Render Mode"
msgstr "Режим отображения объекта"

#: widgets/AoT_map.py:986
msgid ""
"Render style for the 3D facility overlay on the map. "
"Solid/Wireframe/Performance reduce GPU load."
msgstr ""
"Стиль отрисовки 3D-наложения объекта на карте. Режимы "
"«Сплошной/Каркасный/Производительный» снижают нагрузку на GPU."

#: widgets/AoT_map.py:995
msgid "Vector Style URL"
msgstr "URL векторного стиля"

#: widgets/AoT_map.py:996
msgid "Custom MapLibre style JSON URL. Leave empty to use GIS input setting."
msgstr ""
"URL JSON-стиля MapLibre. Оставьте пустым, чтобы использовать настройку "
"ГИС-входа."

#: widgets/AoT_output_pwm.py:56
msgid "AoT PWM Output"
msgstr "ШИМ-выход AoT"

#: widgets/AoT_output_pwm.py:60
msgid "Displays and controls a PWM output with a single slider."
msgstr "Отображает и управляет ШИМ-выходом с помощью одного ползунка."

#: widgets/AoT_output_pwm.py:74
msgid "Select the output to display and control"
msgstr "Выберите выход для отображения и управления"

#: widgets/AoT_output_pwm.py:83 widgets/AoT_output_value.py:86
#: widgets/widget_camera.py:285 widgets/widget_function_status.py:61
#: widgets/widget_gauge_solid.py:192 widgets/widget_indicator.py:75
#: widgets/widget_measurement.py:71 widgets/widget_measurement_multi.py:107
#: widgets/widget_python_code.py:174 widgets/widget_trigger_sequence.py:260
msgid "The period of time between refreshing the widget"
msgstr "Период времени между обновлениями виджета"

#: widgets/AoT_output_value.py:57
msgid "AoT Actuator Position"
msgstr "Позиция привода AoT"

#: widgets/AoT_output_value.py:62
msgid ""
"Displays and controls a positional (open/close) actuator: close/stop/open"
" buttons plus a fine-adjust slider."
msgstr "Отображает и управляет позиционным приводом (открыть/закрыть): кнопки закрыть/стоп/открыть плюс ползунок точной настройки."

#: widgets/AoT_output_value.py:77
msgid "Select the actuator to display and control"
msgstr "Выберите привод для отображения и управления"

#: widgets/AoT_plot.py:352
msgid "AoT Plot"
msgstr "Участок AoT"

#: widgets/AoT_plot.py:357
msgid ""
"One plot at a glance: stage timeline, targets against current readings, "
"trends, and accumulated heat. Edit its schedule, guidance and targets "
"from here."
msgstr "Один участок как на ладони: хронология этапов, цели в сравнении с текущими показаниями, тренды и накопленное тепло. Здесь же можно изменить расписание, рекомендации и целевые значения."

#: widgets/AoT_plot.py:377
msgid "What to monitor"
msgstr "Что отслеживать"

#: widgets/AoT_plot.py:383
msgid "Progress"
msgstr "Прогресс"

#: widgets/AoT_plot.py:385
msgid "Stage timeline with today and past transitions marked."
msgstr "Хронология этапов с отметкой сегодняшнего дня и прошедших переходов."

#: widgets/AoT_plot.py:391
msgid "Targets vs now"
msgstr "Цели и текущее значение"

#: widgets/AoT_plot.py:393
msgid ""
"Current readings against the targets and limits this stage declares. One "
"gets the gauge, the rest are listed as text."
msgstr "Текущие показания относительно целевых значений и пределов, заданных этим этапом. Одно отображается на индикаторе, остальные — текстом."

#: widgets/AoT_plot.py:400
msgid "Trends"
msgstr "Тенденции"

#: widgets/AoT_plot.py:402
msgid ""
"Fills the rows that have no axis with a recent trend line. Needs the "
"targets block."
msgstr "Заполняет строки без оси недавней линией тренда. Требует блока целевых значений."

#: widgets/AoT_plot.py:409
msgid "Accumulated heat"
msgstr "Накопленное тепло"

#: widgets/AoT_plot.py:411
msgid ""
"How far this stage has come in growing degree days. Shown only when the "
"programme declares a base temperature."
msgstr "Насколько этот этап продвинулся по накопленным градусо-дням. Отображается только если в программе задана базовая температура."

#: widgets/AoT_plot.py:422
msgid "Soil moisture"
msgstr "Влажность почвы"

#: widgets/AoT_plot.py:424
msgid "Gauge metric"
msgstr "Показатель для индикатора"

#: widgets/AoT_plot.py:426
msgid ""
"Which measurement gets the gauge. The rest are listed as text. If this "
"plot does not measure it, the first one with a range is shown instead."
msgstr "Какое измерение отображается на индикаторе. Остальные показаны текстом. Если этот участок его не измеряет, вместо него показывается первое измерение с диапазоном."

#: widgets/AoT_plot.py:440
msgid ""
"Minutes between reloads. Stages move by the day, so short intervals only "
"add load."
msgstr "Минуты между перезагрузками. Этапы меняются по дням, поэтому короткие интервалы лишь создают лишнюю нагрузку."

#: widgets/AoT_timer.py:76
msgid "Must be a number."
msgstr "Должно быть числом."

#: widgets/AoT_timer.py:78
msgid "Allowed range is -12.0 to +14.0."
msgstr "Допустимый диапазон от -12.0 до +14.0."

#: widgets/AoT_timer.py:806 widgets/AoT_timer.py:845
#, python-brace-format
msgid "ON Failed: {}"
msgstr "Включение не удалось: {}"

#: widgets/AoT_timer.py:1127
msgid "AoT Timer"
msgstr "Таймер AoT"

#: widgets/AoT_timer.py:1133
msgid ""
"Use the toggle switch to turn the device on and off. Turn on \"Timer\" to"
" operate on a timer: in Simple mode the device runs once for the set time"
" (0 = run until stopped), and in Cycle mode it repeats a Run / Rest "
"sequence for the set number of cycles. \"Scheduled Start\" begins "
"operation at a set wall-clock time in the device timezone. When \"Timer\""
" is off, the toggle simply switches the device on or off regardless of "
"the time settings."
msgstr ""
"Используйте переключатель, чтобы включить или выключить устройство. "
"Включите «Таймер» для работы по таймеру: в простом режиме устройство "
"работает один раз в течение заданного времени (0 = работать до "
"остановки), а в циклическом режиме повторяет последовательность «Работа /"
" Пауза» заданное число циклов. «Запуск по расписанию» начинает работу в "
"заданное астрономическое время в часовом поясе устройства. Когда «Таймер»"
" выключен, переключатель просто включает или выключает устройство "
"независимо от настроек времени."

#: widgets/AoT_timer.py:1151
msgid "Select the Output to control."
msgstr "Выберите выход для управления."

#: widgets/AoT_timer.py:1159
msgid "Sync (seconds)"
msgstr "Синхронизация (секунды)"

#: widgets/AoT_timer.py:1160
msgid ""
"How often the widget refreshes the operation status from the server (in "
"seconds)."
msgstr "Как часто виджет обновляет статус операции с сервера (в секундах)."

#: widgets/AoT_timer.py:1170
msgid "Show Status"
msgstr "Показать статус"

#: widgets/AoT_timer.py:1171
msgid "Display operation status on the title bar."
msgstr "Отображать состояние работы в строке заголовка."

#: widgets/AoT_timer.py:1182
msgid ""
"When enabled, shows the timed controls (Run / Rest / Cycles / Scheduled "
"Start). When disabled, the toggle simply turns the device on or off."
msgstr ""
"При включении отображаются элементы управления таймером (Работа / Пауза /"
" Циклы / Запуск по расписанию). При выключении переключатель просто "
"включает или выключает устройство."

#: widgets/AoT_timer.py:1189
msgid "Simple (single run / hold)"
msgstr "Простой (однократный запуск / удержание)"

#: widgets/AoT_timer.py:1190
msgid "Cycle (run / rest repeated)"
msgstr "Цикл (повтор работы/отдыха)"

#: widgets/AoT_timer.py:1193
msgid ""
"Cycle: shows Run / Rest / Cycles inputs, repeats the run/rest for a "
"number of cycles. Simple: single Run time only (0 = run until stopped)."
msgstr ""
"Цикл: отображает поля «Работа/Отдых/Циклы», повторяет работу и отдых "
"заданное число циклов. Простой: только время работы (0 = работать до "
"остановки)."

#: widgets/AoT_timer.py:1199
msgid "Scheduled Start (hh:mm)"
msgstr "Запланированное начало (чч:мм)"

#: widgets/AoT_timer.py:1200
msgid ""
"Start at this wall-clock time (device timezone). 00:00 = start "
"immediately. If the time already passed today, starts tomorrow."
msgstr ""
"Начать в указанное время по часам (часовой пояс устройства). 00:00 "
"означает немедленный запуск. Если это время сегодня уже прошло, запуск "
"произойдёт завтра."

#: widgets/AoT_timer.py:1204
msgid "Cycle Settings"
msgstr "Настройки цикла"

#: widgets/AoT_timer.py:1211
msgid "Default Run Time (s)"
msgstr "Время работы по умолчанию (с)"

#: widgets/AoT_timer.py:1212
msgid "Default run time to use at start"
msgstr "Время работы по умолчанию при запуске"

#: widgets/AoT_timer.py:1219
msgid "Default Rest Time (s)"
msgstr "Время отдыха по умолчанию (с)"

#: widgets/AoT_timer.py:1220
msgid "Default rest time between cycles (cycle mode)"
msgstr "Время отдыха между циклами по умолчанию (режим цикла)"

#: widgets/AoT_timer.py:1227
msgid "Default Cycle Count"
msgstr "Число циклов по умолчанию"

#: widgets/AoT_timer.py:1228
msgid "Default number of automatic cycles (cycle mode)"
msgstr "Число автоматических циклов по умолчанию (режим цикла)"

#: widgets/AoT_weather_fcst_announcement.py:57
msgid "AoT Weather Forecast"
msgstr "Прогноз погоды AoT"

#: widgets/AoT_weather_fcst_announcement.py:60
msgid ""
"Displays the KMA (Korea Meteorological Administration) short-term "
"forecast for the period selected by the user."
msgstr ""
"Отображает краткосрочный прогноз KMA (Метеорологическое управление Кореи)"
" за период, выбранный пользователем."

#: widgets/AoT_weather_fcst_announcement.py:70 widgets/AoT_wind_angular.py:201
msgid "Maximum Validity Time"
