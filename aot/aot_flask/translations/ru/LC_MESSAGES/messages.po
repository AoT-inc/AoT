msgstr "Непрозрачность метки"

#: widgets/AoT_facility.py:546
msgid "Opacity of sensor value labels (0.0–1.0)."
msgstr "Непрозрачность подписей значений датчиков (0.0–1.0)."

#: widgets/AoT_facility.py:553 widgets/AoT_map.py:842
msgid "Enable Sensor Popup"
msgstr "Включить всплывающее окно датчика"

#: widgets/AoT_facility.py:554 widgets/AoT_map.py:843
msgid "Click a sensor label to open a detail popup with the last 24h chart."
msgstr "Щёлкните метку датчика, чтобы открыть всплывающее окно с подробным графиком за последние 24 часа."

#: widgets/AoT_gauge_angular.py:210
msgid "AoT Circular Gauge"
msgstr "Круговой индикатор AoT"

#: widgets/AoT_gauge_angular.py:215
msgid ""
"Displays data in a circular gauge. Ensure the maximum value option "
"matches the last section (High) for correct display. Selecting presets "
"like Temperature, Humidity, or VPD automatically sets min/max values and "
"color sections."
msgstr "Отображает данные в виде кругового индикатора. Убедитесь, что параметр максимального значения соответствует последнему разделу («Верхний»), для корректного отображения. Выбор пресетов, таких как «Температура», «Влажность» или VPD, автоматически задаёт мин/макс значения и цветовые разделы."

#: widgets/AoT_gauge_angular.py:240 widgets/AoT_graph.py:277
msgid ""
"Highcharts is free for open source and personal use. However, if used as "
"part of a commercial product, a commercial license may be required. "
"Please check https://shop.highsoft.com for the most accurate information."
msgstr "Highcharts бесплатен для проектов с открытым исходным кодом и личного использования. Однако при использовании в составе коммерческого продукта может потребоваться коммерческая лицензия. Актуальную информацию уточняйте на https://shop.highsoft.com."

#: widgets/AoT_gauge_angular.py:260 widgets/AoT_graph.py:432
#: widgets/AoT_graph.py:442 widgets/AoT_graph.py:452 widgets/AoT_graph.py:462
#: widgets/AoT_graph.py:472
msgid "Select the measurement to display"
msgstr "Выберите измерение для отображения"

#: widgets/AoT_gauge_angular.py:269
msgid "Set the maximum valid time for the measurement"
msgstr "Задайте максимальное время действительности измерения"

#: widgets/AoT_gauge_angular.py:278 widgets/AoT_graph.py:303
msgid "Set the refresh interval for the widget"
msgstr "Задайте интервал обновления виджета"

#: widgets/AoT_gauge_angular.py:285
msgid "Set the number of decimal places to display"
msgstr "Задайте количество отображаемых десятичных знаков"

#: widgets/AoT_gauge_angular.py:291 widgets/AoT_wind_angular.py:224
msgid "Minimum Value"
msgstr "Минимальное значение"

#: widgets/AoT_gauge_angular.py:292
msgid "Set the minimum value of the gauge"
msgstr "Задайте минимальное значение индикатора"

#: widgets/AoT_gauge_angular.py:298 widgets/AoT_wind_angular.py:231
msgid "Maximum Value"
msgstr "Максимальное значение"

#: widgets/AoT_gauge_angular.py:299
msgid "Set the maximum value of the gauge"
msgstr "Задайте максимальное значение индикатора"

#: widgets/AoT_gauge_angular.py:305
msgid "Number of Color Sections"
msgstr "Количество цветовых секций"

#: widgets/AoT_gauge_angular.py:306
msgid "Set the number of sections to distinguish gauge colors"
msgstr "Задайте количество секций для различения цветов индикатора"

#: widgets/AoT_gauge_angular.py:318
msgid "Preset Config"
msgstr "Конфигурация пресета"

#: widgets/AoT_gauge_angular.py:319
msgid ""
"Selecting a preset configuration automatically applies default settings "
"such as min/max values. Preset gauges follow the global band colors "
"(Settings > Custom UI); choose Custom to set individual section colors."
msgstr "Выбор предустановленной конфигурации автоматически применяет настройки по умолчанию, такие как минимальные/максимальные значения. Предустановленные индикаторы используют глобальные цвета диапазонов (Настройки > Пользовательский интерфейс); выберите «Пользовательский», чтобы задать цвета отдельных секций."

#: widgets/AoT_gauge_angular.py:326 widgets/AoT_wind_angular.py:238
msgid "Data Font Size"
msgstr "Размер шрифта данных"

#: widgets/AoT_gauge_angular.py:327
msgid "Set the font size of the data inside the gauge. Default is 1.5 (medium)."
msgstr "Задайте размер шрифта данных внутри индикатора. По умолчанию 1.5 (средний)."

#: widgets/AoT_gauge_angular.py:334 widgets/AoT_wind_angular.py:245
msgid "Unit Font Size"
msgstr "Размер шрифта единицы измерения"

#: widgets/AoT_gauge_angular.py:335
msgid "Set the font size of the unit inside the gauge. Default is 0.7 (small)."
msgstr "Задайте размер шрифта единицы измерения внутри индикатора. По умолчанию 0.7 (маленький)."

#: widgets/AoT_gauge_angular.py:342
msgid "Unit Font Weight"
msgstr "Насыщенность шрифта единицы измерения"

#: widgets/AoT_gauge_angular.py:343
msgid "Set the font weight inside the gauge. Default is 500 (medium)."
msgstr "Задайте насыщенность шрифта внутри индикатора. По умолчанию 500 (средняя)."

#: widgets/AoT_gauge_angular.py:349 widgets/AoT_wind_angular.py:280
msgid "Data Position Offset"
msgstr "Смещение положения данных"

#: widgets/AoT_gauge_angular.py:350
msgid ""
"Set the vertical position offset of the data text inside the gauge "
"(numeric only)."
msgstr "Задайте смещение вертикального положения текста данных внутри индикатора (только числовое значение)."

#: widgets/AoT_graph.py:240
msgid "AoT Graph"
msgstr "График AoT"

#: widgets/AoT_graph.py:244
msgid ""
"Displays a synchronous graph. Data selected will be displayed on the "
"X-axis for the configured duration."
msgstr "Отображает синхронный график. Выбранные данные будут отображаться по оси X в течение заданной продолжительности."

#: widgets/AoT_graph.py:294
msgid "Time Axis Settings"
msgstr "Настройки оси времени"

#: widgets/AoT_graph.py:315
msgid "Select the unit for the X-axis duration."
msgstr "Выберите единицу измерения для продолжительности по оси X."

#: widgets/AoT_graph.py:323
msgid "Enter the duration to display on the X-axis."
msgstr "Введите продолжительность для отображения по оси X."

#: widgets/AoT_graph.py:329 widgets/widget_graph_synchronous.py:274
msgid "Enable Auto Refresh"
msgstr "Включить автообновление"

#: widgets/AoT_graph.py:330
msgid "Automatically refresh graph data at the specified interval."
msgstr "Автоматически обновлять данные графика с заданным интервалом."

#: widgets/AoT_graph.py:336 widgets/widget_graph_synchronous.py:281
msgid "Enable X-Axis Reset"
msgstr "Включить сброс оси X"

#: widgets/AoT_graph.py:337
msgid "Reset the X-axis when refreshing the graph."
msgstr "Сбрасывать ось X при обновлении графика."

#: widgets/AoT_graph.py:341
msgid "Graph Style"
msgstr "Стиль графика"

#: widgets/AoT_graph.py:347 widgets/widget_graph_synchronous.py:288
msgid "Enable Header Buttons"
msgstr "Включить кнопки в заголовке"

#: widgets/AoT_graph.py:348
msgid "Display graph control buttons in the widget header."
msgstr "Отображать кнопки управления графиком в заголовке виджета."

#: widgets/AoT_graph.py:354 widgets/widget_graph_synchronous.py:295
msgid "Enable Title"
msgstr "Включить заголовок"

#: widgets/AoT_graph.py:355
msgid "Display the graph title."
msgstr "Отображать заголовок графика."

#: widgets/AoT_graph.py:361
msgid "Enable NavBar"
msgstr "Включить панель навигации"

#: widgets/AoT_graph.py:362 widgets/widget_graph_synchronous.py:303
msgid "Enable the graph navigation bar."
msgstr "Включить панель навигации графика."

#: widgets/AoT_graph.py:368 widgets/widget_graph_synchronous.py:309
msgid "Enable Export"
msgstr "Включить экспорт"

#: widgets/AoT_graph.py:369
msgid "Enable the button to export the graph."
msgstr "Включить кнопку экспорта графика."

#: widgets/AoT_graph.py:375 widgets/widget_graph_synchronous.py:316
msgid "Enable Range Selector"
msgstr "Включить селектор диапазона"

#: widgets/AoT_graph.py:376
msgid "Enable the graph range selector."
msgstr "Включить селектор диапазона графика."

#: widgets/AoT_graph.py:382
msgid "Enable Legend"
msgstr "Включить легенду"

#: widgets/AoT_graph.py:383
msgid "Display the legend at the bottom of the graph."
msgstr "Отображать легенду внизу графика."

#: widgets/AoT_graph.py:389
msgid "Hide Axis Labels on Mobile"
msgstr "Скрывать подписи осей на мобильных устройствах"

#: widgets/AoT_graph.py:390
msgid ""
"Hide graph axis tick labels and unit titles on small screens (chart width"
" < 480px)."
msgstr "Скрывать подписи делений осей и названия единиц измерения графика на маленьких экранах (ширина графика < 480px)."

#: widgets/AoT_graph.py:396
msgid "Axis Font Size (em)"
msgstr "Размер шрифта оси (em)"

#: widgets/AoT_graph.py:397
msgid "Set the font size for graph axes (em)."
msgstr "Задайте размер шрифта для осей графика (em)."

#: widgets/AoT_graph.py:403
msgid "Axis Title Font Size (em)"
msgstr "Размер шрифта заголовка оси (em)"

#: widgets/AoT_graph.py:404
msgid "Set the font size for graph axis titles (em)."
msgstr "Задайте размер шрифта для названий осей графика (em)."

#: widgets/AoT_graph.py:410
msgid "Legend Font Size (em)"
msgstr "Размер шрифта легенды (em)"

#: widgets/AoT_graph.py:411
msgid "Set the font size for the legend (em)."
msgstr "Задайте размер шрифта легенды (em)."

#: widgets/AoT_graph.py:417
msgid "Title Font Size (em)"
msgstr "Размер шрифта заголовка (em)"

#: widgets/AoT_graph.py:418
msgid "Set the font size for the title (em)."
msgstr "Задайте размер шрифта заголовка (em)."

#: widgets/AoT_graph.py:422
msgid "Data Source"
msgstr "Источник данных"

#: widgets/AoT_graph.py:471
msgid "Note Tag"
msgstr "Тег заметки"

#: widgets/AoT_graph.py:476
msgid "Press <kbd>Ctrl</kbd> or <kbd>&#8984;</kbd> to select multiple items."
msgstr "Удерживайте <kbd>Ctrl</kbd> или <kbd>&#8984;</kbd>, чтобы выбрать несколько элементов."

#: widgets/AoT_map.py:584
msgid "AoT Map"
msgstr "Карта AoT"

#: widgets/AoT_map.py:594
msgid ""
"Displays the location of the selected device on a map. Highlights the "
"operating state with the selected color. Supports 3D terrain, pitch, and "
"bearing."
msgstr "Отображает местоположение выбранного устройства на карте. Выделяет рабочее состояние выбранным цветом. Поддерживает 3D-рельеф, наклон и азимут."

#: widgets/AoT_map.py:629
msgid ""
"All devices placed on this map in the map editor are shown automatically."
" Add or move devices in <a href=\"/geo/design\" target=\"_blank\" "
"rel=\"noopener\">Map Editor (geo/design)</a>."
msgstr "Все устройства, размещенные на этой карте в редакторе карт, отображаются автоматически. Добавляйте или перемещайте устройства в <a href=\"/geo/design\" target=\"_blank\" rel=\"noopener\">редакторе карт (geo/design)</a>."

#: widgets/AoT_map.py:641
msgid "Select a map. Leave empty to use the most recently modified map."
msgstr "Выберите карту. Оставьте поле пустым, чтобы использовать последнюю изменённую карту."

#: widgets/AoT_map.py:654
msgid "Show Labels"
msgstr "Показать метки"

#: widgets/AoT_map.py:656
msgid ""
"Master switch for all map labels (site, zone, device, sensor). Use the "
"map's label controller to fine-tune input/output/function labels."
msgstr "Главный переключатель для всех подписей на карте (участок, зона, устройство, датчик). Используйте контроллер подписей карты для точной настройки подписей входов/выходов/функций."

#: widgets/AoT_map.py:664
msgid "Display Data Only (Hide Map)"
msgstr "Отображать только данные (скрыть карту)"

#: widgets/AoT_map.py:665
msgid "Hide the overlay map and show only the data panel."
msgstr "Скрыть карту-наложение и показывать только панель данных."

#: widgets/AoT_map.py:676
msgid "Show AI Advice"
msgstr "Показать рекомендации ИИ"

#: widgets/AoT_map.py:678
msgid ""
"Display the latest periodic AI advice summary for this map's "
"facility/site."
msgstr "Отображать последнюю периодическую сводку рекомендаций ИИ для объекта/участка этой карты."

#: widgets/AoT_map.py:685 widgets/widget_trigger_sequence.py:293
msgid "Period (Seconds)"
msgstr "Период (секунды)"

#: widgets/AoT_map.py:686
msgid "Refresh the widget every N seconds. 0 to disable."
msgstr "Обновлять виджет каждые N секунд. 0 — отключить."

#: widgets/AoT_map.py:710
msgid "Device Filter"
msgstr "Фильтр устройств"

#: widgets/AoT_map.py:715
msgid ""
"Nothing is selected by default, so every device placed on the map is "
"shown. Devices you select below are hidden from the map."
msgstr "По умолчанию ничего не выбрано, поэтому на карте отображаются все размещённые устройства. Устройства, выбранные ниже, скрываются с карты."

#: widgets/AoT_map.py:726
msgid "Select inputs to hide. Leave empty to show all placed inputs."
msgstr "Выберите входы, которые нужно скрыть. Оставьте пустым, чтобы показать все размещённые входы."

#: widgets/AoT_map.py:735
msgid "Select outputs to hide. Leave empty to show all placed outputs."
msgstr "Выберите выходы, которые нужно скрыть. Оставьте пустым, чтобы показать все размещённые выходы."

#: widgets/AoT_map.py:744
msgid "Select functions to hide. Leave empty to show all placed functions."
msgstr "Выберите функции, которые нужно скрыть. Оставьте пустым, чтобы показать все размещённые функции."

#: widgets/AoT_map.py:754
msgid "Measurement Panel"
msgstr "Панель измерений"

#: widgets/AoT_map.py:763
msgid "Select input measurements to display in the panel."
msgstr "Выберите измерения входов для отображения на панели."

#: widgets/AoT_map.py:772
msgid "Select output measurements to display in the panel."
msgstr "Выберите измерения выходов для отображения на панели."

#: widgets/AoT_map.py:781
msgid "Select function measurements to display in the panel."
msgstr "Выберите измерения функций для отображения на панели."

#: widgets/AoT_map.py:791
msgid "Label Style"
msgstr "Стиль метки"

#: widgets/AoT_map.py:798
msgid "Prevent Label Collision"
msgstr "Предотвращать наложение подписей"

#: widgets/AoT_map.py:799
msgid "Automatically hide overlapping labels when enabled."
msgstr "При включении автоматически скрывать перекрывающиеся подписи."

#: widgets/AoT_map.py:806
msgid "Label Text Size"
msgstr "Размер текста метки"

#: widgets/AoT_map.py:807
msgid "Specify the size of all map labels (unit: em)."
msgstr "Задайте размер всех подписей на карте (единица измерения: em)."

#: widgets/AoT_map.py:815
msgid "Facility-centric Labels"
msgstr "Подписи, ориентированные на объект"

#: widgets/AoT_map.py:817
msgid ""
"Off (default): outdoor-centric — site/zone labels stay visible at all "
"zoom levels; facility and sensor labels appear only when zoomed in. On: "
"facility-centric — facility and sensor labels take priority; site/zone "
"labels yield and merge when zoomed out."
msgstr "Выкл (по умолчанию): ориентация на открытую местность — подписи участков/зон остаются видимыми на всех уровнях масштабирования; подписи объектов и датчиков появляются только при увеличении. Вкл: ориентация на объект — подписи объектов и датчиков имеют приоритет; подписи участков/зон уступают и объединяются при уменьшении масштаба."

#: widgets/AoT_map.py:832
msgid "Circle (integer value)"
msgstr "Круг (целое значение)"

#: widgets/AoT_map.py:833
msgid "Text label"
msgstr "Текстовая метка"

#: widgets/AoT_map.py:835
msgid "Sensor Marker Style"
msgstr "Стиль маркера датчика"

#: widgets/AoT_map.py:836
msgid ""
"Circle: compact round marker showing the first measurement as an integer,"
" colored by measurement band. Text: full value label."
msgstr "Круг: компактный круглый маркер, показывающий первое измерение в виде целого числа, окрашенный по диапазону измерения. Текст: полная подпись значения."

#: widgets/AoT_map.py:860
msgid "Site Shape"
msgstr "Форма участка"

#: widgets/AoT_map.py:861
msgid "Show Site polygons on the map."
msgstr "Показывать полигоны участков на карте."

#: widgets/AoT_map.py:868
msgid "Zone Shape"
msgstr "Форма зоны"

#: widgets/AoT_map.py:869
msgid "Show Zone polygons on the map."
msgstr "Показывать полигоны зон на карте."

#: widgets/AoT_map.py:876
msgid "Facility Shape"
msgstr "Форма объекта"

#: widgets/AoT_map.py:877
msgid "Show Facility polygons on the map."
msgstr "Показывать полигоны объектов на карте."

#: widgets/AoT_map.py:884
msgid "Equipment Shape"
msgstr "Форма оборудования"

#: widgets/AoT_map.py:885
msgid "Show Equipment (e.g., pipes) shapes on the map."
msgstr "Показывать фигуры оборудования (например, труб) на карте."

#: widgets/AoT_map.py:892
msgid "Device Shape"
msgstr "Форма устройства"

#: widgets/AoT_map.py:893
msgid "Show Device shape areas on the map."
msgstr "Показывать области фигур устройств на карте."

#: widgets/AoT_map.py:900
msgid "Other Drawn Shapes"
msgstr "Другие нарисованные фигуры"

#: widgets/AoT_map.py:901
msgid "Show freeform shapes created with drawing tools."
msgstr "Показывать произвольные фигуры, созданные инструментами рисования."

#: widgets/AoT_map.py:907
msgid "Device Shape Opacity"
msgstr "Непрозрачность формы устройства"

#: widgets/AoT_map.py:908
msgid "0 (Transparent) ~ 100 (Opaque)"
msgstr "0 (прозрачный) ~ 100 (непрозрачный)"

#: widgets/AoT_map.py:919
msgid "3D Map (Vector Mode)"
msgstr "3D-карта (векторный режим)"

#: widgets/AoT_map.py:926
msgid "Enable 3D Terrain"
msgstr "Включить 3D-рельеф"

#: widgets/AoT_map.py:927
msgid "Enable 3D terrain rendering (Hillshade, elevation). Requires vector mode."
msgstr "Включить отрисовку 3D-рельефа (отмывка рельефа, высота). Требуется векторный режим."

#: widgets/AoT_map.py:939
msgid "Facility Render Mode"
msgstr "Режим отображения объекта"

#: widgets/AoT_map.py:941
msgid ""
"Render style for the 3D facility overlay on the map. "
"Solid/Wireframe/Performance reduce GPU load."
msgstr "Стиль отрисовки 3D-наложения объекта на карте. Режимы «Сплошной/Каркасный/Производительный» снижают нагрузку на GPU."

#: widgets/AoT_map.py:950
msgid "Vector Style URL"
msgstr "URL векторного стиля"

#: widgets/AoT_map.py:951
msgid "Custom MapLibre style JSON URL. Leave empty to use GIS input setting."
msgstr "URL JSON-стиля MapLibre. Оставьте пустым, чтобы использовать настройку ГИС-входа."

#: widgets/AoT_timer.py:75
msgid "Must be a number."
msgstr "Должно быть числом."

#: widgets/AoT_timer.py:77
msgid "Allowed range is -12.0 to +14.0."
msgstr "Допустимый диапазон от -12.0 до +14.0."

#: widgets/AoT_timer.py:801 widgets/AoT_timer.py:840
#, python-brace-format
msgid "ON Failed: {}"
msgstr "Включение не удалось: {}"

#: widgets/AoT_timer.py:1114
msgid "AoT Timer"
msgstr "Таймер AoT"

#: widgets/AoT_timer.py:1120
msgid ""
"Use the toggle switch to turn the device on and off. Turn on \"Timer\" to"
" operate on a timer: in Simple mode the device runs once for the set time"
" (0 = run until stopped), and in Cycle mode it repeats a Run / Rest "
"sequence for the set number of cycles. \"Scheduled Start\" begins "
"operation at a set wall-clock time in the device timezone. When \"Timer\""
" is off, the toggle simply switches the device on or off regardless of "
"the time settings."
