msgstr "Радиус трубы (м)"

#: aot_flask/templates/pages/geo/geo_facility.html:805
msgid "Actuator that operates this fitting (one can drive multiple fittings)"
msgstr ""
"Привод, управляющий этим фитингом (один привод может управлять "
"несколькими фитингами)"

#: aot_flask/templates/pages/geo/geo_facility.html:811
#: aot_flask/templates/pages/geo/geo_facility.html:821
#: aot_flask/templates/pages/geo/geo_facility.html:1178
msgid "Replace hardware"
msgstr "Заменить оборудование"

#: aot_flask/templates/pages/geo/geo_facility.html:818
msgid "Select sensor device (Input / Function)"
msgstr "Выберите устройство датчика (вход / функция)"

#: aot_flask/templates/pages/geo/geo_facility.html:832
msgid "Sensor location — indoor/outdoor"
msgstr "Расположение датчика — в помещении/на улице"

#: aot_flask/templates/pages/geo/geo_facility.html:833
msgid "Indoor"
msgstr "Внутри помещения"

#: aot_flask/templates/pages/geo/geo_facility.html:834
msgid "Outdoor"
msgstr "На улице"

#: aot_flask/templates/pages/geo/geo_facility.html:839
msgid "Fan Role"
msgstr "Роль вентилятора"

#: aot_flask/templates/pages/geo/geo_facility.html:842
msgid "Fan role for environment control"
msgstr "Роль вентилятора в управлении средой"

