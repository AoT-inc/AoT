msgstr "Norėdami pasiekti šį puslapį, prisijunkite"

#: aot_flask/app.py:1510
msgid ""
"The security token for this page had expired. Nothing was saved — please "
"try again."
msgstr ""
"Šio puslapio saugumo raktas baigė galioti. Niekas nebuvo išsaugota — "
"bandykite dar kartą."

#: aot_flask/app.py:1518
msgid "Your session has expired. Please log in again."
msgstr "Jūsų seansas baigėsi. Prisijunkite dar kartą."

