#: aot_flask/templates/settings/user_detail.html:16
msgid ""
"Note: Password and keypad code fields are empty. Enter values and save to"
" change. Leave empty to keep current settings. To disable keypad code, "
"enter 0 and save."
msgstr ""
"Pastaba: slaptažodžio ir klaviatūros kodo laukai tušti. Norėdami "
"pakeisti, įveskite reikšmes ir išsaugokite. Palikite tuščius, kad išliktų"
" dabartiniai nustatymai. Norėdami išjungti klaviatūros kodą, įveskite 0 "
"ir išsaugokite."

#: aot_flask/templates/settings/user_detail.html:27
#: aot_flask/templates/settings/users.html:276
msgid "Used to log in. Letters and numbers only, and cannot be changed later."
msgstr "Naudojama prisijungimui. Tik raidės ir skaičiai, vėliau pakeisti negalima."

