msgstr ""
"Ši grupė kol kas neturi išteklių. Visi vis dar gali valdyti tai, kas "
"nepriskirta."

#: aot_flask/templates/settings/group_detail.html:89
msgid "Are you sure you want to delete this group?"
msgstr "Ar tikrai norite ištrinti šią grupę?"

