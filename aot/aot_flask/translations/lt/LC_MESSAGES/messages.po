#: aot_flask/utils/utils_remote_host.py:316
#: aot_flask/utils/utils_remote_host.py:320
#: aot_flask/utils/utils_remote_host.py:358
#, python-format
msgid "Error: %(err)s"
msgstr "Klaida: %(err)s"

#: aot_flask/routes_admin.py:234
msgid "Backup deleted"
msgstr "Atsarginė kopija ištrinta"

#: aot_flask/routes_admin.py:241
msgid "Deletion of backup in progress"
msgstr "Vykdomas atsarginės kopijos trynimas"

#: aot_flask/routes_admin.py:249
msgid "Invalid restore path."
msgstr "Neteisingas atkūrimo kelias."

#: aot_flask/routes_admin.py:267 aot_flask/routes_admin.py:276
msgid "Restore in progress"
msgstr "Vykdomas atkūrimas"

#: aot_flask/routes_admin.py:611
msgid "Waiting for the updater to start..."
msgstr "Laukiama, kol paleis atnaujinimo įrankis..."

#: aot_flask/routes_admin.py:658
msgid "Enter the update time as HH:MM (24-hour), e.g. 03:00."
msgstr "Įveskite atnaujinimo laiką formatu VV:MM (24 val.), pvz., 03:00."

#: aot_flask/routes_admin.py:688
msgid ""
"Saved, but the daemon could not be notified. The new schedule takes "
"effect after the daemon restarts."
msgstr ""
"Išsaugota, tačiau nepavyko pranešti tarnybai (daemon). Naujas "
"tvarkaraštis įsigalios paleidus tarnybą iš naujo."

#: aot_flask/routes_admin.py:694
#, python-format
msgid ""
"Automatic updates are on. A published update will be installed at "
"%(time)s each day."
msgstr ""
"Automatiniai atnaujinimai įjungti. Paskelbtas atnaujinimas bus įdiegtas "
"kasdien %(time)s val."

#: aot_flask/routes_admin.py:698
msgid "Automatic updates are off."
msgstr "Automatiniai atnaujinimai išjungti."

#: aot_flask/routes_admin.py:724
msgid ""
"In-app upgrade is not available without the updater service. On the host,"
" pull the new image and recreate the containers (docker compose pull && "
"docker compose up -d) instead."
msgstr ""
"Atnaujinimas programoje neįmanomas be atnaujinimo tarnybos. Serveryje "
"atsisiųskite naują atvaizdą (image) ir iš naujo sukurkite konteinerius "
"(docker compose pull && docker compose up -d)."

#: aot_flask/routes_admin.py:728
msgid "An update is already in progress."
msgstr "Atnaujinimas jau vykdomas."

#: aot_flask/routes_admin.py:735
#, python-format
msgid "You are already on the latest version (%(version)s)."
msgstr "Jau naudojate naujausią versiją (%(version)s)."

#: aot_flask/routes_admin.py:751
msgid ""
"The update has been requested. The containers will be recreated on the "
"new image; this page shows progress."
msgstr ""
"Atnaujinimo užklausa pateikta. Konteineriai bus sukurti iš naujo "
"naudojant naują atvaizdą; šiame puslapyje rodoma eiga."

#: aot_flask/routes_admin.py:832
msgid ""
"There was an error encountered during the upgrade process. Check the "
"upgrade log for details."
msgstr ""
"Atnaujinimo proceso metu įvyko klaida. Išsamesnę informaciją rasite "
"atnaujinimo žurnale."

#: aot_flask/routes_admin.py:886
#, python-format
msgid ""
"A backup must be performed during an upgrade and there is not enough free"
" space to perform a backup. A backup requires %(size_bu).1f MB but there "
"is only %(size_free).1f MB available, which would leave %(size_after).1f "
"MB after the backup. If the free space after a backup is less than 50 MB,"
" the backup cannot proceed. Free up space by deleting current backups."
msgstr ""
"Atnaujinant privaloma sukurti atsarginę kopiją, tačiau tam nepakanka "
"laisvos vietos. Kopijai reikia %(size_bu).1f MB, tačiau laisva tik "
"%(size_free).1f MB, todėl po kopijavimo liktų %(size_after).1f MB. Jei po"
" kopijavimo laisva vieta būtų mažesnė nei 50 MB, kopija negali būti "
"sukurta. Atlaisvinkite vietos ištrindami esamas atsargines kopijas."

#: aot_flask/routes_admin.py:919
msgid "The upgrade (from master branch) has started"
msgstr "Atnaujinimas (iš „master“ šakos) pradėtas"

#: aot_flask/routes_admin.py:937
msgid "The upgrade has started"
msgstr "Atnaujinimas pradėtas"

#: aot_flask/routes_admin.py:958
msgid "The major version upgrade has started"
msgstr "Pagrindinės versijos atnaujinimas pradėtas"

#: aot_flask/routes_admin.py:961
msgid "You cannot upgrade if an upgrade is not available"
msgstr "Negalite atnaujinti, jei atnaujinimas nepasiekiamas"

