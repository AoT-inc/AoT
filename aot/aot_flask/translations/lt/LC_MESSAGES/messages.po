#: aot_flask/templates/settings/user_detail.html:203
msgid "Are you sure you want to delete this user?"
msgstr "Ar tikrai norite ištrinti šį naudotoją?"

#: aot_flask/templates/settings/users.html:64
msgid "Roles"
msgstr "Vaidmenys"

#: aot_flask/templates/settings/users.html:98
msgid "Edit User"
msgstr "Redaguoti naudotoją"

#: aot_flask/templates/settings/users.html:141
msgid "Edit Role"
msgstr "Redaguoti vaidmenį"

#: aot_flask/templates/settings/users.html:166
msgid ""
"Groups restrict who can operate a resource. Every user can still view all"
" data."
msgstr ""
"Grupės apriboja, kas gali valdyti išteklių. Visi naudotojai vis tiek gali"
" peržiūrėti visus duomenis."

#: aot_flask/templates/settings/users.html:181
msgid "Edit Group"
msgstr "Redaguoti grupę"

