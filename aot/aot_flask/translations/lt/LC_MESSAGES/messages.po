#: aot_flask/templates/settings/translations.html:75
msgid "Nothing here yet. Press \"Collect names\" to gather the names in use."
msgstr ""
"Čia kol kas nieko nėra. Paspauskite „Rinkti pavadinimus“, kad "
"surinktumėte naudojamus pavadinimus."

#: aot_flask/templates/settings/translations.html:81
msgid "Original"
msgstr "Originalas"

#: aot_flask/templates/settings/translations.html:82
msgid "Translation"
msgstr "Vertimas"

#: aot_flask/templates/settings/translations.html:103
msgid "Edited"
msgstr "Redaguota"

#: aot_flask/templates/settings/translations.html:111
msgid "Retranslate"
msgstr "Versti iš naujo"

#: aot_flask/templates/settings/translations.html:176
