msgstr "Ngưỡng điện áp để chuyển sang chế độ tiết kiệm điện (4S LiFePO4: 13.00 V ≈ 25%; ắc quy chì-axit 12 V: 11.70 V)"

#: functions/lorawan_mode_manager.py:336
msgid "Ultra-saving Threshold (V)"
msgstr "Ngưỡng Siêu tiết kiệm (V)"

#: functions/lorawan_mode_manager.py:337
