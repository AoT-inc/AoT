#: functions/custom_functions/env_coordinator_impl/_function_info.py:69
msgid "Integrated Environment Control"
msgstr "Điều khiển môi trường tích hợp"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:73
msgid ""
"Coordinates registered Output actuators to optimise photosynthesis. VPD "
"is the primary control target; temperature and humidity act as safety "
"constraints. Add \"Environment Control: Register Actuator\" actions to "
"register devices. External environment data (outdoor temperature, "
"humidity, wind, rain, solar, CO₂) comes from the linked facility's "
"outdoor sensors, or optionally from the ext_context_collector function."
msgstr "Điều phối các cơ cấu chấp hành Đầu ra đã đăng ký để tối ưu hóa quang hợp. VPD là mục tiêu điều khiển chính; nhiệt độ và độ ẩm đóng vai trò là các ràng buộc an toàn. Thêm hành động \"Điều khiển môi trường: Đăng ký cơ cấu chấp hành\" để đăng ký thiết bị. Dữ liệu môi trường bên ngoài (nhiệt độ, độ ẩm, gió, mưa, bức xạ mặt trời, CO₂ ngoài trời) đến từ các cảm biến ngoài trời của cơ sở được liên kết, hoặc tùy chọn từ hàm ext_context_collector."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:85
msgid "Trigger an immediate cycle, reload actuators, or issue an emergency stop."
msgstr "Kích hoạt một chu kỳ ngay lập tức, tải lại cơ cấu chấp hành, hoặc phát lệnh dừng khẩn cấp."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:93
msgid "Reload Actuators"
msgstr "Tải lại bộ truyền động"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:95
msgid "Re-read the Actions table and rebuild actuator profiles."
msgstr "Đọc lại bảng Hành động và xây dựng lại hồ sơ cơ cấu chấp hành."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:103
msgid "Run Now"
msgstr "Chạy ngay"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:105
msgid "Execute one coordination cycle immediately using current sensor readings."
msgstr "Thực thi ngay một chu kỳ điều phối bằng các giá trị cảm biến hiện tại."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:113
msgid "Emergency Stop"
msgstr "Dừng khẩn cấp"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:115
msgid "Immediately set all actuators to safe_default and pause control for 60 s."
msgstr "Ngay lập tức đặt tất cả bộ chấp hành về safe_default và tạm dừng điều khiển trong 60 giây."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:132
msgid "Fewer decisions"
msgstr "Ít quyết định hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:133
msgid "Faster response"
msgstr "Phản hồi nhanh hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:503
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1080
msgid "Relaxed"
msgstr "Thư giãn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
msgid "Slow"
msgstr "Chậm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1088
msgid "Responsive"
msgstr "Đáp ứng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:140
msgid ""
"Coordination cycle interval. Recommended: slowest actuator response time "
"× 1.5."
msgstr "Khoảng thời gian chu kỳ điều phối. Khuyến nghị: thời gian phản hồi chậm nhất của cơ cấu chấp hành × 1.5."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:148
msgid "Max Sensor Age (seconds)"
msgstr "Tuổi cảm biến tối đa (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:158
msgid ""
"Reject sensor readings older than this. Leave at 0 to let each sensor "
"decide from its own update interval."
msgstr "Từ chối các giá trị cảm biến cũ hơn thời gian này. Để 0 để mỗi cảm biến tự quyết định theo chu kỳ cập nhật riêng."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:166
msgid "Actuation Rate"
msgstr "Tốc độ Truyền động"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:175
msgid "Responsive (60s)"
msgstr "Đáp ứng (60 giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:176
msgid "Standard (180s)"
msgstr "Tiêu chuẩn (180s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:177
msgid "Gentle — extend vent motor life (600s)"
msgstr "Nhẹ nhàng — kéo dài tuổi thọ động cơ cửa thông gió (600 giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:178
msgid "Custom (set seconds below)"
msgstr "Tùy chỉnh (đặt số giây bên dưới)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:180
msgid "Vent Actuation Profile"
msgstr "Hồ sơ vận hành cửa thông gió"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:182
msgid "How often the vents may move. Emergencies and safety gates ignore this."
msgstr "Tần suất cửa thông gió có thể di chuyển. Các trường hợp khẩn cấp và cổng an toàn bỏ qua giá trị này."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:191
msgid "Custom Actuation Period (seconds)"
msgstr "Chu kỳ tác động tùy chỉnh (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:193
msgid ""
"Used only when Vent Actuation Profile = Custom. 0 = fall back to the "
"selected profile default."
msgstr "Chỉ dùng khi Hồ sơ Vận hành Cửa thông gió = Tùy chỉnh. 0 = quay về giá trị mặc định của hồ sơ đã chọn."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:204
msgid "Emergency Minimum Interval (seconds)"
msgstr "Khoảng thời gian tối thiểu khẩn cấp (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:206
msgid ""
"Even during an emergency, vents will not be re-commanded more often than "
"this — prevents rapid back-to-back moves."
msgstr "Ngay cả trong tình huống khẩn cấp, cửa thông gió cũng sẽ không được ra lệnh lại thường xuyên hơn mức này — nhằm tránh các lần di chuyển liên tiếp quá nhanh."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:215
#: functions/custom_functions/env_coordinator_impl/_function_info.py:233
msgid "Reacts later"
msgstr "Phản ứng muộn hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:216
#: functions/custom_functions/env_coordinator_impl/_function_info.py:234
msgid "Reacts sooner"
msgstr "Phản ứng sớm hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:235
msgid "Late"
msgstr "Trễ"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:235
msgid "Early"
msgstr "Sớm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:221
msgid "Emergency Deviation Threshold (× tolerance)"
msgstr "Ngưỡng lệch khẩn cấp (× dung sai)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:223
msgid ""
"If a variable deviates from its target by more than this many times its "
"tolerance, treat the cycle as an emergency and move vents immediately "
"(ignore the actuation period above)."
msgstr "Nếu một biến lệch khỏi mục tiêu nhiều hơn số lần dung sai này, hãy coi chu kỳ là khẩn cấp và di chuyển cửa thông gió ngay lập tức (bỏ qua chu kỳ tác động ở trên)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:239
msgid "Emergency Rate Threshold (°C / 10min)"
msgstr "Ngưỡng tốc độ khẩn cấp (°C / 10 phút)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:241
msgid ""
"If indoor temperature is changing faster than this rate, treat the cycle "
"as an emergency and move vents immediately."
msgstr "Nếu nhiệt độ trong nhà thay đổi nhanh hơn tốc độ này, hãy coi chu kỳ là khẩn cấp và di chuyển cửa thông gió ngay lập tức."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:251
msgid "Close Vents When Ventilation Cannot Help"
msgstr "Đóng cửa thông gió khi thông gió không có tác dụng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:253
msgid ""
"Opening helps only when the outdoor air is on the target side. When it is"
" not, wider vents drag the reading further away."
msgstr "Việc mở chỉ có ích khi không khí ngoài trời nằm về phía mục tiêu. Khi không phải vậy, mở cửa thông gió rộng hơn sẽ kéo số đo ra xa mục tiêu hơn."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:264
msgid "Night Vent Parking"
msgstr "Vị trí đỗ cửa thông gió ban đêm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:271
msgid "Close at Night"
msgstr "Đóng vào ban đêm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:273
msgid ""
"Keep the vents closed overnight and let heating, cooling and drying carry"
" the load."
msgstr "Giữ cửa thông gió đóng qua đêm và để sưởi, làm mát và sấy khô đảm nhận tải."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:284
msgid "Sunset to sunrise"
msgstr "Từ hoàng hôn đến bình minh"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:285
msgid "Fixed clock times"
msgstr "Giờ đồng hồ cố định"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:287
msgid "Night Starts At"
msgstr "Ban đêm bắt đầu lúc"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:289
msgid "Whether night is measured from sunset to sunrise, or by fixed clock times."
msgstr "Ban đêm được tính từ hoàng hôn đến bình minh, hay theo giờ cố định."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:299
msgid "Close Before Sunset (min)"
msgstr "Đóng trước khi mặt trời lặn (phút)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:301
msgid "Start closing this many minutes before sunset."
msgstr "Bắt đầu đóng trước hoàng hôn bấy nhiêu phút."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:311
msgid "Night Start (HH:MM)"
msgstr "Bắt đầu ban đêm (HH:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:313
msgid "When night starts, if you chose fixed clock times."
msgstr "Khi ban đêm bắt đầu, nếu bạn chọn giờ cố định."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:323
msgid "Night End (HH:MM)"
msgstr "Kết thúc ban đêm (HH:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:325
msgid "When night ends, if you chose fixed clock times."
msgstr "Khi ban đêm kết thúc, nếu bạn chọn giờ cố định."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:332
msgid "Heating / Cooling Interlock"
msgstr "Khóa liên động sưởi/làm mát"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:340
msgid "Rest Heating and Cooling When Venting Can Reach the Target"
msgstr "Tạm nghỉ sưởi và làm mát khi thông gió có thể đạt mục tiêu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:342
msgid "No point burning fuel for what an open vent already does."
msgstr "Không cần đốt nhiên liệu cho việc mà cửa thông gió mở đã làm được."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:351
msgid "Keep Vents Closed While Heating or Cooling Runs"
msgstr "Giữ cửa thông gió đóng khi sưởi hoặc làm mát đang chạy"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:353
msgid "Venting against a running unit throws that heat or cold straight outside."
msgstr "Mở thông gió trong khi thiết bị đang chạy sẽ đẩy thẳng lượng nhiệt hoặc lạnh đó ra ngoài."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:367
msgid "Heating / Cooling Running Signal"
msgstr "Tín hiệu hoạt động sưởi/làm mát"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:369
msgid ""
"Only for units this coordinator does not switch itself — it already knows"
" about the ones it commands. Not an indoor temperature: something that "
"reports the unit running, such as a power reading or a relay state."
msgstr "Chỉ dành cho các thiết bị mà bộ điều phối này không tự bật/tắt — vì nó đã biết về những thiết bị mà nó điều khiển. Không phải nhiệt độ trong nhà: mà là thứ báo cáo thiết bị đang chạy, chẳng hạn như chỉ số công suất hoặc trạng thái relay."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:379
msgid "Running Signal Threshold"
msgstr "Ngưỡng tín hiệu đang chạy"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:381
msgid ""
"Read on the signal chosen above, in whatever unit that signal uses. For "
"an on/off signal (0 or 1) leave it at 0.5."
msgstr "Đọc theo tín hiệu đã chọn ở trên, theo đơn vị mà tín hiệu đó sử dụng. Đối với tín hiệu bật/tắt (0 hoặc 1), giữ nguyên giá trị 0.5."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:389
msgid "Facility (optional)"
msgstr "Cơ sở (tùy chọn)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:397
msgid "Linked Facility"
msgstr "Cơ sở đã liên kết"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:399
msgid "Which facility this coordinator runs. Actuators and sensors come from it."
msgstr "Bộ điều phối này vận hành cơ sở nào. Cơ cấu chấp hành và cảm biến đến từ cơ sở đó."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:414
msgid "Bay Scope (optional)"
msgstr "Phạm vi gian (tùy chọn)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:416
msgid "Limit this coordinator to one bay. Leave blank for the whole facility."
msgstr "Giới hạn bộ điều phối này trong một khoang. Để trống để áp dụng cho toàn bộ cơ sở."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:423
msgid "Time Control"
msgstr "Điều khiển theo Thời gian"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:430
msgid "Enable Time Window"
msgstr "Bật khung thời gian"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:432
msgid ""
"Outside this window the coordinator stops entirely — heating and cooling "
"included. Safety limits still act."
msgstr "Ngoài khung thời gian này, bộ điều phối sẽ dừng hoàn toàn — bao gồm cả sưởi ấm và làm mát. Các giới hạn an toàn vẫn có hiệu lực."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:443
msgid "When the coordinator starts working each day."
msgstr "Khi bộ điều phối bắt đầu làm việc mỗi ngày."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:454
msgid "When it stops. What each device does at that moment is set in its Action."
msgstr "Khi nó dừng lại. Việc mỗi thiết bị làm vào thời điểm đó được đặt trong Hành động của thiết bị."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:464
msgid "Photoperiod Method"
msgstr "Phương pháp chu kỳ quang"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:466
msgid ""
"Sets the window above from a day-length curve instead of fixed times. "
"Careful: a short day length means the coordinator runs for only those "
"hours, so nothing is heated overnight."
msgstr "Đặt khung giờ ở trên theo đường cong độ dài ngày thay vì thời gian cố định. Lưu ý: độ dài ngày ngắn nghĩa là bộ điều phối chỉ hoạt động trong khoảng giờ đó, do đó không có sưởi ấm qua đêm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:477
msgid "Photoperiod Anchor (HH:MM)"
msgstr "Điểm neo chu kỳ quang (HH:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:479
msgid "The window is centred on this time."
msgstr "Khoảng thời gian được canh giữa tại thời điểm này."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:493
msgid "VPD Priority"
msgstr "Ưu tiên VPD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:494
msgid "Higher value = processed first. Default 1.2."
msgstr "Giá trị cao hơn = được xử lý trước. Mặc định là 1.2."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:501
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1070
msgid "Moves equipment less"
msgstr "Di chuyển thiết bị ít hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:502
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1071
msgid "Tracks the target closely"
msgstr "Bám sát mục tiêu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:503
msgid "Loose"
msgstr "Lỏng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:503
msgid "Tight"
msgstr "Chặt"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:506
msgid "VPD Tolerance (kPa)"
msgstr "Dung sai VPD (kPa)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:508
msgid ""
"Dead-band half-width around the VPD setpoint. Adjustments are skipped "
"when the deviation is within this range, reducing unnecessary actuator "
"cycling. Typical value: 0.05–0.15 kPa."
msgstr "Nửa độ rộng vùng chết quanh điểm đặt VPD. Việc điều chỉnh sẽ bị bỏ qua khi độ lệch nằm trong phạm vi này, giúp giảm số lần đóng/mở không cần thiết của bộ truyền động. Giá trị điển hình: 0.05–0.15 kPa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:525
msgid "Max Light Threshold"
msgstr "Ngưỡng ánh sáng tối đa"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:527
msgid ""
"Close the shade screen above this light level. 0 = never shade. This is a"
" shading choice only — how much light the crop can use comes from its "
"program."
msgstr "Đóng màn che nắng khi vượt quá mức ánh sáng này. 0 = không bao giờ che. Đây chỉ là lựa chọn che nắng — lượng ánh sáng cây trồng có thể sử dụng được xác định bởi chương trình của nó."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:536
msgid "Min Light Threshold (Supplemental)"
msgstr "Ngưỡng ánh sáng tối thiểu (Bổ sung)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:538
msgid ""
"Switch supplemental lighting on below this light level. 0 = no "
"supplemental lighting, which is most facilities."
msgstr "Bật đèn chiếu sáng bổ sung khi mức ánh sáng thấp hơn giá trị này. 0 = không có đèn bổ sung, áp dụng cho hầu hết các cơ sở."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:546
msgid "CO₂"
msgstr "CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:554
msgid "CO₂ Priority"
msgstr "Ưu tiên CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:556
msgid ""
"Processing order weight for CO₂ relative to other control variables. "
"Higher value = processed earlier in each cycle. Default 0.8 (lower than "
"VPD 1.2, since CO₂ enrichment is secondary)."
msgstr "Trọng số thứ tự xử lý cho CO₂ so với các biến điều khiển khác. Giá trị càng cao = được xử lý càng sớm trong mỗi chu kỳ. Mặc định là 0.8 (thấp hơn VPD 1.2, vì việc bổ sung CO₂ là thứ yếu)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:566
msgid "CO₂ Tolerance (ppm)"
msgstr "Dung sai CO₂ (ppm)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:568
msgid ""
"Dead-band half-width around the CO₂ setpoint. Adjustments are skipped "
"when the deviation is within this range. Typical value: 50–150 ppm."
msgstr "Nửa độ rộng vùng chết quanh điểm đặt CO₂. Việc điều chỉnh sẽ bị bỏ qua khi độ lệch nằm trong phạm vi này. Giá trị điển hình: 50–150 ppm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:585
msgid "Max Temperature (°C)"
msgstr "Nhiệt độ tối đa (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:587
msgid "Hard upper limit. Forces cooling when exceeded, regardless of VPD target."
msgstr "Giới hạn trên tuyệt đối. Buộc làm mát khi vượt mức này, bất kể mục tiêu VPD."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:596
msgid "Min Temperature (°C)"
msgstr "Nhiệt độ tối thiểu (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:598
msgid "Hard lower limit. Forces heating when below, regardless of VPD target."
msgstr "Giới hạn dưới tuyệt đối. Buộc sưởi khi thấp hơn mức này, bất kể mục tiêu VPD."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:613
msgid "Max Humidity (%)"
msgstr "Độ ẩm tối đa (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:615
msgid "Hard upper limit. Prevents VPD bypass via extreme humidity."
msgstr "Giới hạn trên tuyệt đối. Ngăn VPD bị bỏ qua do độ ẩm cực đoan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:624
msgid "Min Humidity (%)"
msgstr "Độ ẩm tối thiểu (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:626
msgid "Hard lower limit. Prevents VPD bypass via extreme dryness."
msgstr "Giới hạn dưới tuyệt đối. Ngăn VPD bị bỏ qua do độ khô cực đoan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:635
msgid "Use Micro Sprinklers to Raise Humidity"
msgstr "Dùng Vòi phun sương Micro để Tăng Độ ẩm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:637
msgid ""
"Use the micro sprinklers for humidity too. Turn off when they are your "
"irrigation."
msgstr "Cũng dùng vòi phun sương micro cho độ ẩm. Tắt khi chúng là hệ thống tưới của bạn."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:673
msgid "Enable Sunburn/Evening Protection"
msgstr "Bật bảo vệ cháy nắng/buổi tối"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:675
msgid ""
"Blocks wetting-type misting in strong light (droplets can lens sunlight "
"onto leaves) and, if set below, before sunset. Independent of how often "
"misting runs — turn this on or off at any misting frequency."
msgstr "Chặn phun sương làm ướt khi ánh sáng mạnh (giọt nước có thể hội tụ ánh nắng lên lá) và, nếu đặt bên dưới, trước khi mặt trời lặn. Không phụ thuộc vào tần suất phun sương — có thể bật hoặc tắt tùy chọn này ở bất kỳ tần suất phun sương nào."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:688
msgid "Misting Lockout Irradiance (W/m²)"
msgstr "Cường độ bức xạ khóa phun sương (W/m²)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:690
msgid ""
"Wetting-type misting is blocked outright at or above this indoor light "
"level. The estimated indoor level is used, so closing the shade screen "
"relaxes the lockout."
msgstr "Phun sương làm ướt bị chặn hoàn toàn khi mức ánh sáng trong nhà đạt hoặc vượt ngưỡng này. Mức trong nhà ước tính được sử dụng, nên đóng màn che sẽ nới lỏng việc khóa này."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:702
msgid "Misting Release Irradiance (W/m²)"
msgstr "Cường độ bức xạ mở khóa phun sương (W/m²)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:704
msgid ""
"Misting is released again once the light falls below this level, and is "
"tapered linearly between here and the lockout threshold. The gap between "
"the two prevents the mist from switching on and off as clouds pass."
msgstr "Phun sương được mở lại khi ánh sáng giảm xuống dưới mức này, và giảm dần tuyến tính giữa mức này và ngưỡng khóa. Khoảng cách giữa hai ngưỡng giúp phun sương không bật tắt liên tục khi mây trôi qua."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:720
msgid "Max Spray Duration (s)"
msgstr "Thời lượng phun tối đa (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:722
msgid ""
"Longest single spray. Humidification is regulated by how often it sprays,"
" not by how long — the same way irrigation doses a fixed amount at "
"intervals."
msgstr "Lần phun dài nhất. Việc làm ẩm được điều chỉnh bằng tần suất phun, không phải bằng thời gian phun — giống như cách tưới tiêu định lượng cố định theo từng khoảng thời gian."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:732
msgid "Humidity rises faster"
msgstr "Độ ẩm tăng nhanh hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:733
msgid "More time for leaves to dry"
msgstr "Thêm thời gian để lá khô"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
#: functions/custom_functions/env_coordinator_impl/_function_info.py:997
msgid "Short"
msgstr "Ngắn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
#: functions/custom_functions/env_coordinator_impl/_function_info.py:997
msgid "Long"
msgstr "Kinh độ"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
msgid "Very long"
msgstr "Rất dài"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:737
msgid "Enforced Drying Interval (s)"
msgstr "Khoảng thời gian sấy khô bắt buộc (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:739
msgid ""
"No spraying at all for this long after one finishes, so the leaves get a "
"chance to dry."
msgstr "Không phun trong khoảng thời gian này sau khi lần phun trước kết thúc, để lá có cơ hội khô."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:750
msgid "Allow Misting Before Sunset"
msgstr "Cho phép phun sương trước khi mặt trời lặn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:752
msgid "Allow misting near sunset. Turn off to leave the leaves dry overnight."
msgstr "Cho phép phun sương gần thời điểm mặt trời lặn. Tắt để giữ lá khô suốt đêm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:762
msgid "Stop Misting Before Sunset (min)"
msgstr "Dừng phun sương trước hoàng hôn (phút)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:764
msgid "How long before sunset misting stops."
msgstr "Bao lâu trước khi mặt trời lặn thì phun sương dừng lại."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:775
msgid "Groundwater (untreated)"
msgstr "Nước ngầm (chưa xử lý)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:776
msgid "Treated (RO, softened, filtered)"
msgstr "Đã xử lý (RO, làm mềm, lọc)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:777
msgid "Rainwater"
msgstr "Nước mưa"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:779
msgid "Misting Water Source"
msgstr "Nguồn nước phun sương"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:781
msgid ""
"Harder or colder water needs a lower sunburn threshold, which this sets "
"for you."
msgstr "Nước cứng hơn hoặc lạnh hơn cần ngưỡng cháy nắng thấp hơn, mục này sẽ tự đặt cho bạn."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:788
msgid "VPD Decomposition"
msgstr "Phân rã VPD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:795
msgid "T Weight (0-1)"
msgstr "Trọng số T (0-1)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:797
msgid ""
"VPD decomposition: fraction of adjustment via temperature (rest via "
"humidity). 0.6 = favour temperature adjustment. Range 0.0~1.0."
msgstr "Phân rã VPD: tỷ lệ điều chỉnh qua nhiệt độ (phần còn lại qua độ ẩm). 0,6 = ưu tiên điều chỉnh nhiệt độ. Phạm vi 0,0~1,0."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:805
msgid "Photosynthesis Model"
msgstr "Mô hình quang hợp"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:812
msgid "Enable Photosynthesis-Oriented Control"
msgstr "Bật điều khiển định hướng quang hợp"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:814
msgid ""
"Let the model decide which of light, CO₂, temperature or VPD is limiting "
"right now."
msgstr "Để mô hình tự quyết định yếu tố nào trong ánh sáng, CO₂, nhiệt độ hoặc VPD đang là yếu tố giới hạn hiện tại."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:823
msgid "Reference Plot (optional)"
msgstr "Khu đất tham chiếu (tùy chọn)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:825
msgid ""
"Which plot this coordinator follows, when more than one is growing in its"
" scope. Leave empty when there is only one — it is picked automatically. "
"When more than one is growing, pick it from the summary under the linked "
"facility above."
msgstr "Bộ điều phối này theo dõi khu đất nào, khi có nhiều hơn một khu đất đang canh tác trong phạm vi. Để trống khi chỉ có một khu đất — nó sẽ được chọn tự động. Khi có nhiều khu đất đang canh tác, hãy chọn từ bảng tóm tắt bên dưới cơ sở đã liên kết ở trên."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:834
msgid "Guide Ranges (T / RH)"
msgstr "Phạm vi tham chiếu (Nhiệt độ / Độ ẩm)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:842
msgid "Guide T Min (°C)"
msgstr "Nhiệt độ tối thiểu tham chiếu (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:844
msgid ""
"Advisory lower bound for temperature. Triggers forced heating when "
"exceeded (replaces Min Temperature setting when using crop-preset-derived"
" guide ranges)."
msgstr "Giới hạn dưới khuyến nghị cho nhiệt độ. Kích hoạt sưởi ấm bắt buộc khi vượt quá (thay thế cài đặt Nhiệt độ tối thiểu khi sử dụng phạm vi hướng dẫn theo cài đặt sẵn của cây trồng)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:855
msgid "Guide T Max (°C)"
msgstr "Nhiệt độ tối đa tham chiếu (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:856
msgid "Advisory upper bound for temperature."
msgstr "Giới hạn trên khuyến nghị cho nhiệt độ."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:864
msgid "Guide RH Min (%)"
msgstr "RH tối thiểu tham chiếu (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:865
msgid "Advisory lower bound for relative humidity."
msgstr "Giới hạn dưới khuyến nghị cho độ ẩm tương đối."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:873
msgid "Guide RH Max (%)"
msgstr "RH tối đa tham chiếu (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:874
msgid "Advisory upper bound for relative humidity."
msgstr "Giới hạn trên khuyến nghị cho độ ẩm tương đối."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:880
msgid "Cumulative Goal Tracker"
msgstr "Trình theo dõi mục tiêu tích lũy"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:887
msgid "Enable DLI / GDD Tracker"
msgstr "Bật theo dõi DLI / GDD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:889
msgid ""
"Tracks daily light integral (DLI) and growing degree-days (GDD), rolling "
"over at the facility-local midnight (device timezone). Light is converted"
" to PPFD by sensor unit (W/m² assumed if unknown). Generates compensation"
" suggestions when debt accumulates. Requires a Light sensor for DLI "
"tracking."
msgstr "Theo dõi tổng tích lũy ánh sáng hàng ngày (DLI) và số ngày độ tăng trưởng (GDD), luân chuyển vào lúc nửa đêm theo giờ địa phương của cơ sở (múi giờ thiết bị). Ánh sáng được chuyển đổi sang PPFD theo đơn vị cảm biến (giả định W/m² nếu không rõ). Tạo đề xuất bù đắp khi có sự thiếu hụt tích lũy. Cần có cảm biến Ánh sáng để theo dõi DLI."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:909
msgid "Strong Wind Threshold (m/s)"
msgstr "Ngưỡng gió mạnh (m/s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:911
msgid "Openings (vents, side walls) are forced closed above this wind speed."
msgstr "Các cửa mở (cửa thông gió, tường bên) sẽ bị buộc đóng khi vượt quá tốc độ gió này."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:918
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1482
msgid "Effect Calibration"
msgstr "Hiệu chỉnh hiệu ứng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:926
msgid "Legacy (built-in K constants)"
msgstr "Kế thừa (hằng số K tích hợp sẵn)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:927
msgid "Shadow (grey-box logged, legacy controls)"
msgstr "Bóng mờ (ghi log dạng grey-box, điều khiển cũ)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:928
msgid "Grey-box (physics model controls)"
msgstr "Hộp xám (điều khiển theo mô hình vật lý)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:930
msgid "Effect Engine"
msgstr "Công cụ hiệu ứng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:932
msgid ""
"Which model computes the effect of each actuator. Change only while "
"testing."
msgstr "Mô hình nào tính toán tác động của mỗi cơ cấu chấp hành. Chỉ thay đổi trong khi thử nghiệm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:940
msgid "Enable RLS Calibration"
msgstr "Bật hiệu chỉnh RLS"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:942
msgid ""
"Learn per-actuator effect coefficients (K_*) from sensor response. "
"Requires several days of data to converge. Falls back to built-in "
"defaults until convergence."
msgstr "Học các hệ số hiệu ứng theo từng cơ cấu chấp hành (K_*) từ phản hồi cảm biến. Cần vài ngày dữ liệu để hội tụ. Sử dụng giá trị mặc định tích hợp sẵn cho đến khi hội tụ."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:952
msgid "Enable Active Probing"
msgstr "Bật dò tìm chủ động"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:954
#, python-format
msgid ""
"Periodically perturb one actuator by ±10 %% to improve calibration "
"identifiability. Only triggers when load is low and no safety gate is "
"active. Requires RLS Calibration to be enabled."
msgstr "Định kỳ nhiễu loạn một bộ truyền động ±10 %% để cải thiện khả năng nhận dạng hiệu chuẩn. Chỉ kích hoạt khi tải thấp và không có cổng an toàn nào đang hoạt động. Yêu cầu bật Hiệu chuẩn RLS."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:963
msgid "Probes more often"
msgstr "Dò thường xuyên hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:964
msgid "Probes rarely"
msgstr "Dò hiếm khi"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:965
msgid "Often"
msgstr "Thường xuyên"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:965
msgid "Rare"
msgstr "Hiếm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:968
msgid "Probe Interval (seconds)"
msgstr "Khoảng thời gian dò (giây)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:970
msgid "Minimum time between active probing events. Default 3600 s (1 hour)."
msgstr "Thời gian tối thiểu giữa các lần dò chủ động. Mặc định 3600 giây (1 giờ)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:977
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1485
msgid "Forecast Feedforward"
msgstr "Dự báo tiến (feedforward)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:984
msgid "Enable Forecast Feedforward"
msgstr "Bật bù trừ theo dự báo"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:986
msgid ""
"Use KMA short-term weather forecast (forecast.json) to proactively shift "
"temperature/humidity setpoints and inhibit ventilation before adverse "
"weather arrives."
msgstr "Dùng dự báo thời tiết ngắn hạn của KMA (forecast.json) để chủ động điều chỉnh điểm đặt nhiệt độ/độ ẩm và ngăn thông gió trước khi thời tiết xấu ập đến."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:995
msgid "Reacts to what is here now"
msgstr "Phản ứng với những gì đang có ở đây ngay bây giờ"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:996
msgid "Prepares further ahead"
msgstr "Chuẩn bị trước xa hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1000
msgid "Forecast Lookahead (hours)"
msgstr "Thời gian nhìn trước dự báo (giờ)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1002
msgid ""
"How many hours ahead to check for incoming adverse weather (1–6 h). "
"Longer lookahead gives earlier warning but may over-correct."
msgstr "Kiểm tra trước bao nhiêu giờ để phát hiện thời tiết bất lợi sắp tới (1–6 giờ). Thời gian dự báo dài hơn cho cảnh báo sớm hơn nhưng có thể gây điều chỉnh quá mức."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1065
msgid "Control Temperament"
msgstr "Tính khí điều khiển"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1067
msgid ""
"How hard the system chases the target. Sets the cycle, how often vents "
"may move, the dead-band and the emergency thresholds together."
msgstr "Mức độ hệ thống bám theo mục tiêu. Cùng thiết lập chu kỳ, tần suất cửa thông gió có thể di chuyển, dải chết và các ngưỡng khẩn cấp."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1127
msgid "Ventilation and HVAC Teamwork"
msgstr "Phối hợp thông gió và HVAC"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1134
msgid ""
"Keeps venting and HVAC from working against each other. At [Energy "
"saving] the HVAC rests when venting alone can reach the target, and the "
"vents close while it runs. At [High performance] both act freely so the "
"target is reached sooner."
msgstr "Ngăn thông gió và HVAC hoạt động ngược chiều nhau. Ở chế độ [Tiết kiệm năng lượng], HVAC nghỉ khi chỉ riêng thông gió cũng có thể đạt mục tiêu, và cửa thông gió đóng lại trong khi HVAC hoạt động. Ở chế độ [Hiệu suất cao], cả hai hoạt động tự do để đạt mục tiêu nhanh hơn."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1139
msgid "Reaches the target sooner"
msgstr "Đạt mục tiêu sớm hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1140
msgid "Wastes less"
msgstr "Ít lãng phí hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1148
msgid "High performance"
msgstr "Hiệu năng cao"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1154
msgid "Energy saving"
msgstr "Tiết kiệm năng lượng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1163
msgid "Misting Frequency"
msgstr "Tần suất phun sương"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1178
msgid "How often the misting runs — the run time and the gap until the next run."
msgstr "Tần suất phun sương chạy — thời gian chạy và khoảng cách đến lần chạy tiếp theo."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1181
msgid "Drier"
msgstr "Khô hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1182
msgid "Moister"
msgstr "Ẩm hơn"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1198
msgid "Infrequent"
msgstr "Không thường xuyên"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1200
msgid "Moderate"
msgstr "Trung bình"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1202
msgid "Frequent"
msgstr "Thường xuyên"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1204
msgid "Very frequent"
msgstr "Rất thường xuyên"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1213
msgid "Temperature Range"
msgstr "Phạm vi nhiệt độ"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1215
msgid ""
"Aims to stay inside this range. Past a limit it stops whatever pushes the"
" wrong way — too warm: heating off and the shade screen drawn; too cold: "
"cooling off, vents and thermal curtain closed. It does not slam anything "
"to full."
msgstr "Nhằm giữ trong phạm vi này. Khi vượt quá giới hạn, hệ thống sẽ dừng bất kỳ hoạt động nào đẩy sai hướng — quá nóng: tắt sưởi và kéo màn che nắng; quá lạnh: tắt làm mát, đóng cửa thông gió và màn cách nhiệt. Hệ thống sẽ không đột ngột đẩy bất kỳ thiết bị nào lên mức tối đa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1255
msgid "never past"
msgstr "không bao giờ ở quá khứ"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1232
msgid "Misting by Sunlight Level"
msgstr "Phun sương theo mức ánh sáng mặt trời"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1240
msgid ""
"Applies to leaf-wetting misting only — fog-type misting runs in strong "
"sun too. Darker than the range it runs freely; brighter than the range it"
" stops; inside the range it tapers off."
msgstr "Chỉ áp dụng cho phun sương làm ướt lá — phun sương dạng sương mù vẫn chạy cả khi nắng gắt. Tối hơn phạm vi thì chạy tự do; sáng hơn phạm vi thì dừng; trong phạm vi thì giảm dần."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1251
msgid "Humidity Range"
msgstr "Phạm vi độ ẩm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1253
msgid ""
"Aims to stay inside this range. Past a limit it stops whatever pushes the"
" wrong way — too damp: misting off; too dry: exhaust fans off. It does "
"not slam anything to full."
msgstr "Nhằm giữ trong phạm vi này. Khi vượt quá giới hạn, hệ thống sẽ dừng bất kỳ hoạt động nào đẩy sai hướng — quá ẩm: tắt phun sương; quá khô: tắt quạt hút. Hệ thống sẽ không đột ngột đẩy bất kỳ thiết bị nào lên mức tối đa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1270
msgid "Shading and Supplemental Light"
msgstr "Che nắng và chiếu sáng bổ sung"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1277
msgid ""
"Darker than the range: the supplemental lights come on and the shade "
"screen opens. Brighter than the range: the shade screen closes. Inside "
"the range nothing happens. Either end can be turned off."
msgstr "Tối hơn phạm vi: đèn bổ sung bật lên và màn che nắng mở ra. Sáng hơn phạm vi: màn che nắng đóng lại. Trong phạm vi thì không có gì xảy ra. Có thể tắt bất kỳ đầu nào."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1285
msgid "no supplemental light"
msgstr "không có đèn bổ sung"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1286
msgid "no shading"
msgstr "không có che nắng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1360
msgid "Facility Settings"
msgstr "Cài đặt cơ sở"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1380
msgid "Working Hours"
msgstr "Giờ làm việc"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1398
msgid "Target and Temperament"
msgstr "Mục tiêu và tính chất"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1412
msgid "Ventilation"
msgstr "Thông gió"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1422
msgid "Heating, Cooling and Misting"
msgstr "Sưởi, làm mát và phun sương"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1454
msgid "Light and Shading"
msgstr "Ánh sáng và che nắng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1478
msgid "Advanced Settings"
msgstr "Cài đặt nâng cao"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1627
msgid "Not Yet Categorised"
msgstr "Chưa phân loại"

#: aot_flask/static/js/widgets/AoT_map/aot-map-popup.js:2457
msgid "Estimated"
msgstr "Ước tính"

#: aot_flask/static/js/widgets/AoT_map/aot-map-popup.js:2470
msgid "Cumulative since start"
msgstr "Tích lũy kể từ khi bắt đầu"

#: aot/aot_flask/static/js/geo/journal-page.js
msgid "Weather station measurements to include"
msgstr "Các phép đo từ trạm thời tiết cần đưa vào"

msgid "(currently off)"
msgstr "(hiện đang tắt)"

#: aot/aot_flask/static/js/geo/journal-page.js
msgid "On-site sensor measurements to include"
msgstr "Số liệu cảm biến tại chỗ cần đưa vào"

#: aot/aot_flask/templates/pages/geo/journal.html
msgid "Record by"
msgstr "Ghi bởi"

#: aot/aot_flask/templates/pages/geo/journal.html
msgid ""
"A coarser unit makes a smaller document. Daily detail cannot be recovered"
" later, so pick it only if you do not need it."
msgstr "Đơn vị thô hơn tạo ra tài liệu nhỏ hơn. Chi tiết hàng ngày không thể khôi phục lại sau này, vì vậy chỉ chọn nếu bạn không cần đến nó."

#: aot/aot_flask/templates/pages/geo/journal.html
msgid "Pick daily, weekly or monthly."
msgstr "Chọn hằng ngày, hằng tuần hoặc hằng tháng."

#: aot/aot_flask/static/js/geo/journal-page.js
#, python-format
msgid "%(n)s notes"
msgstr "%(n)s ghi chú"

#: config_devices_units.py:342
msgid "Vapor Pressure Deficit"
msgstr "Độ thiếu hụt áp suất hơi (VPD)"

#: widgets/widget_function_status.py:68
msgid "Value Font Size (em)"
msgstr "Cỡ chữ Giá trị (em)"

#: widgets/widget_function_status.py:69
msgid "The font size of the measurement"
msgstr "Cỡ chữ của số liệu đo"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:391
msgid "Growth Schedule"
msgstr "Lịch trình sinh trưởng"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:399
msgid "Stop Control On"
msgstr "Dừng điều khiển khi"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:401
msgid "Control stops for good after this date. Leave blank to keep running."
msgstr "Việc điều khiển sẽ dừng hẳn sau ngày này. Để trống để tiếp tục chạy."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:667
msgid "Misting Sunburn Protection"
msgstr "Bảo vệ cháy nắng bằng phun sương"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:701
msgid "Nursery Mode"
msgstr "Chế độ vườn ươm"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:709
msgid "Nursery (Seedling) Mode"
msgstr "Chế độ vườn ươm (cây con)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:711
msgid ""
"Tighter misting limits for seedlings, which scorch more easily than grown"
" leaves."
msgstr "Giới hạn phun sương chặt chẽ hơn cho cây con, vì chúng dễ bị cháy lá hơn lá đã trưởng thành."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1192
msgid "Not used"
msgstr "Không sử dụng"

#: aot_flask/static/js/geo/journal-page.js:78
#: aot_flask/templates/pages/geo/journal.html:47
msgid "Whole area"
msgstr "Toàn bộ khu vực"

#: aot_flask/templates/pages/geo/journal_view.html:182
msgid "h"
msgstr "giờ"

#: aot_flask/templates/pages/geo/journal_view.html:194
msgid "attachment(s)"
msgstr "tệp đính kèm"

#: aot_flask/static/js/geo/journal-page.js:123
msgid "Select an area first."
msgstr "Hãy chọn khu vực trước."

#: aot_flask/geo/plot_journal.py
msgid ""
"Daily averages are the mean of hourly means, not a true time-weighted "
"average of every reading."
msgstr "Trung bình hàng ngày là giá trị trung bình của các trung bình hàng giờ, không phải là trung bình có trọng số thời gian thực sự của từng số liệu đo."

#: aot_flask/geo/plot_journal.py
msgid ""
"Runtime is read from the first channel only, even for multi-channel "
"outputs."
msgstr "Thời gian chạy chỉ được đọc từ kênh đầu tiên, ngay cả với đầu ra nhiều kênh."

#: aot_flask/geo/plot_journal.py
#, python-format
msgid "%(n)s channel(s) could not be read and are missing from this journal."
msgstr "%(n)s kênh không thể đọc được và bị thiếu trong nhật ký này."

#: aot_flask/geo/plot_journal.py
#, python-format
msgid "%(n)s device area(s) overlap this plot with no device assigned yet."
msgstr "%(n)s khu vực thiết bị chồng lấn lô đất này nhưng chưa được gán thiết bị."

#: aot_flask/geo/plot_journal.py
msgid ""
"Notes pinned to a map location are not included for facility plots — "
"their outline is derived from the facility, not their own."
msgstr "Ghi chú được ghim tại một vị trí trên bản đồ không được đưa vào cho các khu đất thuộc cơ sở — ranh giới của chúng được suy ra từ cơ sở, không phải của riêng chúng."

#: aot_flask/geo/plot_journal.py
msgid "Notes pinned to a map location were not checked."
msgstr "Ghi chú được ghim tại một vị trí trên bản đồ chưa được kiểm tra."

#: aot_flask/static/js/geo/journal-page.js
msgid "No plots found."
msgstr "Không tìm thấy khu đất nào."

#: aot_flask/static/js/geo/journal-page.js
msgid "Pick a plot, or a site or zone."
msgstr "Chọn một khu đất, hoặc một địa điểm hoặc khu vực."

#: aot_flask/static/js/geo/journal-page.js
msgid "Looking up when data starts…"
msgstr "Đang tra cứu thời điểm dữ liệu bắt đầu…"

#: aot_flask/static/js/geo/journal-page.js
#, python-format
msgid "Data for this area starts on %(d)s."
msgstr "Dữ liệu cho khu vực này bắt đầu từ %(d)s."

#: aot_flask/static/js/geo/journal-page.js
msgid "No measurements found for this area yet."
msgstr "Chưa tìm thấy phép đo nào cho khu vực này."

#: aot_flask/geo/plot_journal.py
msgid ""
"This period was too large to store day by day, so it was saved in weekly "
"buckets — daily detail is not available for it."
msgstr "Khoảng thời gian này quá dài để lưu theo từng ngày, nên đã được lưu theo từng nhóm tuần — không có chi tiết theo ngày cho khoảng thời gian này."

#: aot_flask/static/js/geo/journal-page.js
#, python-format
msgid "%(on)s of %(all)s"
msgstr "%(on)s trong %(all)s"

#: aot_flask/geo/plot_journal.py
#, python-format
msgid "Device diagnostics were left out of this journal: %(names)s."
msgstr "Chẩn đoán thiết bị đã bị bỏ qua trong nhật ký này: %(names)s."

#: aot_flask/templates/pages/geo/journal_view.html
msgid "Outdoor (weather)"
msgstr "Ngoài trời (thời tiết)"

#: aot_flask/geo/plot_journal.py
msgid "NNE"
msgstr "BĐB"

#: aot_flask/geo/plot_journal.py
msgid "ENE"
msgstr "ENE"

#: aot_flask/geo/plot_journal.py
msgid "ESE"
msgstr "ESE"

#: aot_flask/geo/plot_journal.py
msgid "SSE"
msgstr "ĐĐN"

#: aot_flask/geo/plot_journal.py
msgid "SSW"
msgstr "TTN"

#: aot_flask/geo/plot_journal.py
msgid "WSW"
msgstr "TTN"

#: aot_flask/geo/plot_journal.py
msgid "WNW"
msgstr "TTB"

#: aot_flask/geo/plot_journal.py
msgid "NNW"
msgstr "BTB"

#: aot_flask/geo/plot_journal.py
msgid ""
"Daily light integral is estimated from solar radiation (W/m2), assuming "
"sunlight. A PAR sensor would measure it directly."
msgstr "Tích phân ánh sáng ngày được ước tính từ bức xạ mặt trời (W/m2), giả định là ánh sáng mặt trời. Cảm biến PAR sẽ đo trực tiếp giá trị này."

#: aot_flask/geo/plot_journal.py
msgid ""
"Light is measured outdoors, so the daily light integral is what reached "
"the site — not what reached the crop under cover or supplemental "
"lighting."
msgstr "Ánh sáng được đo ở ngoài trời, vì vậy tổng tích phân ánh sáng hàng ngày là lượng ánh sáng đến khu vực — không phải lượng ánh sáng đến cây trồng dưới mái che hoặc dưới ánh sáng bổ sung."

#: aot_flask/geo/plot_journal.py
msgid ""
"Water volumes are estimated from the designed nozzle flow and run time, "
"and split by the plot's share of the bay — not measured by a flow meter."
msgstr "Thể tích nước được ước tính từ lưu lượng vòi phun theo thiết kế và thời gian vận hành, rồi chia theo tỷ lệ diện tích khu đất trong dãy — không phải đo bằng đồng hồ đo lưu lượng."

#: aot_flask/geo/plot_journal.py
msgid "s"
msgstr "giây"

#: aot/aot_flask/geo/plot_journal.py
#, python-format
msgid ""
"Light is measured outdoors, so the daily light integral shown is what got"
" through the cover: the outdoor figure multiplied by %(tau)s for "
"%(material)s. The cover's material is used; its thickness, age and dust "
"are not, so the real figure is usually a little lower."
msgstr "Ánh sáng được đo ở ngoài trời, vì vậy tổng tích phân ánh sáng hàng ngày hiển thị là lượng đã xuyên qua mái che: giá trị ngoài trời nhân với %(tau)s cho %(material)s. Chất liệu của mái che được sử dụng; độ dày, tuổi và bụi bẩn của nó thì không, vì vậy giá trị thực tế thường thấp hơn một chút."

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"This facility has a shade screen. Whether it was drawn on any given day "
"is not recorded, so it is not counted — on days it was drawn, the crop "
"got less light than shown."
msgstr "Cơ sở này có màn che nắng. Việc màn có được kéo vào một ngày cụ thể hay không không được ghi lại, vì vậy không được tính đến — vào những ngày màn được kéo, cây trồng nhận được ít ánh sáng hơn so với những gì được hiển thị."

#: aot/aot_flask/geo/plot_journal.py
msgid "Single-layer vinyl"
msgstr "Vinyl một lớp"

#: aot/aot_flask/geo/plot_journal.py
msgid "Double-layer vinyl"
msgstr "Màng vinyl hai lớp"

#: aot/aot_flask/geo/plot_journal.py
msgid "Air-cushion film"
msgstr "Màng đệm khí"

#: aot/aot_flask/geo/plot_journal.py
msgid "GDD (growing degree days)"
msgstr "GDD (độ ngày sinh trưởng)"

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"A running total of warmth. Each day adds how much the day's average "
"temperature sat above the temperature this crop needs to grow at all, so "
"a warm day adds more than a cool one. Crops move through their stages on "
"accumulated warmth rather than on the calendar, which is why a stage can "
"arrive early in a hot season."
msgstr "Tổng tích lũy nhiệt liên tục. Mỗi ngày cộng thêm phần nhiệt độ trung bình của ngày đó vượt trên nhiệt độ tối thiểu mà cây trồng này cần để sinh trưởng, vì vậy một ngày ấm sẽ cộng nhiều hơn một ngày mát. Cây trồng chuyển qua các giai đoạn dựa trên nhiệt tích lũy chứ không phải theo lịch, đó là lý do một giai đoạn có thể đến sớm trong mùa nóng."

#: aot/aot_flask/geo/plot_journal.py
msgid "DLI (daily light integral)"
msgstr "DLI (tích phân ánh sáng ngày)"

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"How much light the crop received over a whole day, added up rather than "
"measured at one moment. Brightness alone does not say much — a bright but"
" short day and a dim but long one can come to the same total. Measured in"
" mol/m2/day."
msgstr "Tổng lượng ánh sáng cây trồng nhận được trong cả ngày, được cộng dồn thay vì đo tại một thời điểm. Độ sáng đơn thuần không nói lên nhiều điều — một ngày sáng nhưng ngắn và một ngày mờ nhưng dài có thể có tổng bằng nhau. Đo bằng mol/m2/ngày."

#: aot/aot_flask/geo/plot_journal.py
msgid "VPD (vapour pressure deficit)"
msgstr "VPD (độ thiếu hụt áp suất hơi)"

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"How dry the air feels to the plant, in kPa. It combines temperature and "
"humidity, because the same humidity is drying on a warm day and not on a "
"cool one. High VPD pushes the plant to transpire; too high and it closes "
"up and stops growing."
msgstr "Mức độ khô của không khí mà cây cảm nhận được, tính bằng kPa. Chỉ số này kết hợp nhiệt độ và độ ẩm, vì cùng một độ ẩm gây khô vào ngày ấm nhưng không gây khô vào ngày mát. VPD cao thúc đẩy cây thoát hơi nước; quá cao khiến cây khép lại và ngừng phát triển."

#: aot/aot_flask/static/js/widgets/AoT_map/aot-map-popup.js
msgid "Set a base temperature in the program to see this."
msgstr "Đặt nhiệt độ cơ sở trong chương trình để xem nội dung này."

#: aot/aot_flask/static/js/widgets/AoT_map/aot-map-popup.js
msgid "No temperature sensor covers this plot."
msgstr "Không có cảm biến nhiệt độ nào bao phủ khu đất này."

#: aot/aot_flask/static/js/widgets/AoT_map/aot-map-popup.js
#, python-format
msgid "%(v)s so far, but only %(pct)s of the days have data."
msgstr "%(v)s tính đến hiện tại, nhưng chỉ %(pct)s số ngày có dữ liệu."

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"Water volume is only filled in for devices whose flow rate is known, and "
"none here is — so this journal shows run times only. Facilities get flow "
"from their piping layout; equipment drawn straight onto the map carries a"
" flow rate but is not linked to the valve that opens it, so it cannot be "
"attributed."
msgstr "Thể tích nước chỉ được điền cho các thiết bị đã biết lưu lượng, và ở đây không có thiết bị nào như vậy — nên nhật ký này chỉ hiển thị thời gian vận hành. Cơ sở lấy lưu lượng từ sơ đồ đường ống của mình; thiết bị vẽ trực tiếp lên bản đồ có mang lưu lượng nhưng không liên kết với van mở nó, nên không thể quy về được."

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"Water volumes are estimated from the sprinklers drawn on the map inside "
"the area each valve covers, and how long that valve ran — not measured by"
" a flow meter. Only the part that overlaps this plot is counted, so no "
"share is guessed."
msgstr "Thể tích nước được ước tính từ các vòi phun vẽ trên bản đồ trong phạm vi mà mỗi van bao phủ, cùng với thời gian van đó chạy — không phải đo bằng đồng hồ đo lưu lượng. Chỉ phần chồng lấn với khu đất này mới được tính, nên không có tỷ lệ nào bị suy đoán."

#: aot/aot_flask/geo/plot_journal.py
#, python-format
msgid ""
"These devices belong to this target but left no record in this period, so"
" they are not in the tables: %(names)s. That is not the same as running "
"for zero hours — it means nothing was written."
msgstr "Các thiết bị này thuộc mục tiêu này nhưng không để lại bản ghi trong khoảng thời gian này, vì vậy chúng không có trong các bảng: %(names)s. Điều đó không giống với việc chạy trong 0 giờ — nó có nghĩa là không có gì được ghi lại."

#: aot/aot_flask/geo/plot_journal.py
#, python-format
msgid ""
"No sensor sits inside this plot, so the nearest one in the same zone was "
"used — about %(m)s m away. It is the closest reading available, not a "
"reading of this plot."
msgstr "Không có cảm biến nào nằm trong khu đất này, nên cảm biến gần nhất trong cùng khu vực đã được sử dụng — cách khoảng %(m)s m. Đây là giá trị đo gần nhất hiện có, không phải giá trị đo của chính khu đất này."

#: aot/aot_flask/geo/plot_journal.py
#, python-format
msgid "Weather station %(name)s"
msgstr "Trạm thời tiết %(name)s"

#: aot_flask/templates/pages/geo/journal_view.html
msgid "Field sensor and weather station"
msgstr "Cảm biến hiện trường và trạm thời tiết"

#: aot/aot_flask/geo/plot_journal.py
msgid "Runtime (h)"
msgstr "Thời gian chạy (giờ)"

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"Photo links below point to `/note_attachment/...` and stay valid only "
"while the server is running."
msgstr "Các liên kết ảnh bên dưới trỏ đến `/note_attachment/...` và chỉ còn hiệu lực khi máy chủ đang chạy."

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"Some devices in this journal have no mapped coverage area, so their water"
" column stays blank — that does not mean they used no water."
msgstr "Một số thiết bị trong nhật ký này không có khu vực bao phủ được ánh xạ, nên cột lượng nước của chúng để trống — điều đó không có nghĩa là chúng không sử dụng nước."

#: aot_flask/templates/pages/geo/journal_view.html
msgid "Full numbers for this period"
msgstr "Số liệu đầy đủ cho giai đoạn này"

#: aot_flask/templates/pages/geo/journal_view.html
msgid "Same targets as the previous stage."
msgstr "Mục tiêu giống giai đoạn trước."

#: aot/aot_flask/geo/plot_journal.py
msgid ""
"No rainfall total is given. Each stored reading covers its own window, "
"and this system cannot tell whether those windows overlap — the weather-"
"station channel, for one, repeats a 15-minute total every 5 minutes. Read"
" the maximum as the wettest single window, and the average as the mean of"
" those windows, not an hourly rate."
msgstr "Không có tổng lượng mưa nào được cung cấp. Mỗi giá trị đo được lưu tương ứng với một khoảng thời gian riêng, và hệ thống này không thể biết liệu các khoảng đó có chồng lấn hay không — ví dụ kênh trạm thời tiết lặp lại tổng 15 phút mỗi 5 phút. Hãy hiểu giá trị lớn nhất là khoảng thời gian ẩm ướt nhất, và giá trị trung bình là trung bình của các khoảng đó, không phải tốc độ theo giờ."

#: aot/aot_flask/geo/plot_journal.py
#, python-format
msgid "D%(n)s"
msgstr "D%(n)s"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "Show %(n)s more"
msgstr "Hiển thị thêm %(n)s mục"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Show less"
msgstr "Thu gọn"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "%(n)s stages, %(m)s periods"
msgstr "%(n)s giai đoạn, %(m)s khoảng thời gian"

#: aot/aot_flask/geo/plot_journal.py
msgid "GDD (accumulated)"
msgstr "GDD (tích lũy)"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "accumulated %(v)s"
msgstr "tích lũy %(v)s"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Show plan"
msgstr "Hiển thị kế hoạch"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "%(n)s of %(d)s days above target"
msgstr "%(n)s trong %(d)s ngày trên mục tiêu"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "%(n)s of %(d)s days below target"
msgstr "%(n)s trong %(d)s ngày dưới mục tiêu"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "on target for all %(d)s days"
msgstr "đạt mục tiêu trong cả %(d)s ngày"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "average %(v)s"
msgstr "trung bình %(v)s"

#: aot/aot_flask/templates/pages/geo/journal_view.html
#, python-format
msgid "of %(d)s days: %(a)s above, %(b)s below"
msgstr "trong %(d)s ngày: %(a)s trên, %(b)s dưới"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Measurement trends"
msgstr "Xu hướng phép đo"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Crop schedule"
msgstr "Lịch trình cây trồng"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Against target"
msgstr "So với mục tiêu"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Above"
msgstr "Trên"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Below"
msgstr "Bên dưới"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Day count"
msgstr "Số ngày"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Shape and sensor positions are current, not from this period."
msgstr "Vị trí hình dạng và cảm biến là vị trí hiện tại, không phải từ giai đoạn này."

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "The outline is derived from the facility."
msgstr "Đường viền được lấy từ cơ sở."

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Sensors shown belong to the surrounding area."
msgstr "Các cảm biến hiển thị thuộc khu vực xung quanh."

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "Stage timeline"
msgstr "Dòng thời gian giai đoạn"

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid ""
"Rows marked \"Weather station\" and set off by a left border come from "
"the site weather station, not a sensor placed at this target. Where both "
"exist for the same measurement, targets are compared against the field "
"sensor only."
msgstr "Các hàng được đánh dấu \"Trạm thời tiết\" và có đường viền trái là dữ liệu từ trạm thời tiết của khu vực, không phải từ cảm biến đặt tại vị trí này. Khi cả hai cùng tồn tại cho một chỉ số, mục tiêu chỉ được so sánh với cảm biến thực địa."

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid ""
"Targets come from the program attached to this plot. Δ is the measured "
"average minus that target. Day/night targets and curve-based targets are "
"marked instead of differenced, because comparing them against a whole-day"
" average produces false alarms."
msgstr "Các mục tiêu đến từ chương trình gắn với khu vực này. Δ là giá trị trung bình đo được trừ đi mục tiêu đó. Mục tiêu ngày/đêm và mục tiêu theo đường cong được đánh dấu thay vì tính chênh lệch, vì so sánh chúng với mức trung bình cả ngày sẽ tạo ra cảnh báo sai."

#: aot/aot_flask/templates/pages/geo/journal_view.html
msgid "By stage"
msgstr "Theo giai đoạn"


msgid "Vent"
msgstr "Cửa thông gió"

msgid "Mist"
msgstr "Phun sương"

msgid "Devices under automatic control"
msgstr "Thiết bị được điều khiển tự động"

msgid "%(n)s excluded"
msgstr "%(n)s bị loại trừ"

msgid "Turn a device off to keep automatic control from moving it."
msgstr "Tắt thiết bị để điều khiển tự động không tác động đến nó."

msgid "Safety gates will not move it either."
msgstr "Cổng an toàn cũng sẽ không tác động đến thiết bị đó."

msgid "Select a linked facility first."
msgstr "Hãy chọn cơ sở đã liên kết trước."

msgid "This facility has no actuators yet."
msgstr "Cơ sở này chưa có bộ truyền động nào."

msgid "Could not load the device list. Existing settings are kept."
msgstr "Không thể tải danh sách thiết bị. Các cài đặt hiện có vẫn được giữ nguyên."

msgid "Excluded actuators (raw)"
msgstr "Bộ truyền động bị loại trừ (dữ liệu thô)"

msgid "Comma-separated Output IDs excluded from automatic control. Normally set with the toggles above rather than typed here."
msgstr "Danh sách ID đầu ra bị loại trừ khỏi điều khiển tự động, cách nhau bằng dấu phẩy. Thông thường được thiết lập bằng các công tắc bật/tắt phía trên thay vì gõ trực tiếp ở đây."

msgid "Proactively shift temperature/humidity setpoints and inhibit ventilation before adverse weather arrives. Uses this facility's own forecast source if one is linked in the facility editor's weather bindings (any service — KMA, OpenWeatherMap, Open-Meteo); otherwise falls back to the system-wide KMA short-term forecast."
msgstr "Chủ động dịch chuyển các điểm đặt nhiệt độ/độ ẩm và ngăn thông gió trước khi thời tiết bất lợi ập đến. Sử dụng nguồn dự báo riêng của cơ sở này nếu có liên kết trong mục liên kết thời tiết của trình chỉnh sửa cơ sở (bất kỳ dịch vụ nào — KMA, OpenWeatherMap, Open-Meteo); nếu không, sẽ chuyển sang dùng dự báo ngắn hạn KMA áp dụng cho toàn hệ thống."

msgid "How many hours ahead to check for incoming adverse weather (1–6 h) when using the system-wide KMA fallback above. Longer lookahead gives earlier warning but may over-correct. Ignored when this facility has its own forecast source linked — that source already applies its own lookahead."
msgstr "Số giờ cần kiểm tra trước để phát hiện thời tiết bất lợi sắp đến (1–6 giờ) khi sử dụng dự báo dự phòng KMA toàn hệ thống nêu trên. Thời gian nhìn trước dài hơn giúp cảnh báo sớm hơn nhưng có thể gây điều chỉnh quá mức. Bị bỏ qua khi cơ sở này đã liên kết nguồn dự báo riêng — nguồn đó đã tự áp dụng thời gian nhìn trước của nó."

