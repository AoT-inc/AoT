msgstr "Dịch vụ tạm thời không khả dụng. Vui lòng thử lại."

#: ai/ai_routing_service.py:453 ai/services/ai_agent_service.py:1042
msgid "I'm not sure I understood your request. Could you please clarify?"
msgstr "Tôi không chắc mình đã hiểu đúng yêu cầu của bạn. Bạn có thể làm rõ hơn được không?"

#: ai/agents/ai_router.py:15
msgid ""
"Gatekeeper agent that classifies user intent into 5 categories (Control, "
"Data Query, Schedule, Composite, Chat) for v6 pipeline routing."
msgstr "Tác nhân gác cổng phân loại ý định người dùng thành 5 danh mục (Điều khiển, Truy vấn dữ liệu, Lịch trình, Kết hợp, Trò chuyện) để định tuyến quy trình v6."

#: ai/agents/anthropic.py:30
msgid ""
"Anthropic's Claude engine, known for human-like reasoning, sophisticated "
"analysis, and safe response generation."
msgstr "Công cụ Claude của Anthropic, nổi tiếng với khả năng suy luận giống con người, phân tích tinh vi và tạo phản hồi an toàn."

#: ai/agents/gemini.py:30
msgid ""
"Google's state-of-the-art multimodal AI engine, capable of understanding "
"and generating text, code, and images with a massive context window."
msgstr "Công cụ AI đa phương thức tiên tiến nhất của Google, có khả năng hiểu và tạo văn bản, mã nguồn và hình ảnh với cửa sổ ngữ cảnh cực lớn."

#: ai/agents/groq.py:26
msgid ""
"Provides extremely fast inference speeds using Groq's LPU (Language "
"Processing Unit) technology, supporting models like Llama 3.3 and GPT-"
"OSS."
msgstr "Cung cấp tốc độ suy luận cực nhanh bằng công nghệ LPU (Language Processing Unit) của Groq, hỗ trợ các mô hình như Llama 3.3 và GPT-OSS."

#: ai/agents/mcp_aot.py:15
msgid ""
"AoT System Specialist. Queries sensor history, spatial hierarchy, device "
"search, and energy reports via internal system tools."
msgstr "Chuyên gia hệ thống AoT. Truy vấn lịch sử cảm biến, cấu trúc phân cấp không gian, tìm kiếm thiết bị, và báo cáo năng lượng thông qua các công cụ hệ thống nội bộ."

#: ai/agents/mcp_database.py:8
msgid ""
"Analyzes data by querying PostgreSQL/SQLite databases using natural "
"language."
msgstr "Phân tích dữ liệu bằng cách truy vấn cơ sở dữ liệu PostgreSQL/SQLite bằng ngôn ngữ tự nhiên."

#: ai/agents/mcp_excel.py:8
msgid ""
"Generates professional environmental reports in Excel based on analyzed "
"data."
msgstr "Tạo báo cáo môi trường chuyên nghiệp trong Excel dựa trên dữ liệu đã phân tích."

#: ai/agents/mcp_fetch.py:8
msgid ""
"Collects real-time information by directly reading or exploring web page "
"content."
msgstr "Thu thập thông tin theo thời gian thực bằng cách đọc hoặc khám phá trực tiếp nội dung trang web."

#: ai/agents/mcp_google_maps.py:10
msgid ""
"Provides location-based information and geographical analysis using "
"Google Maps data."
msgstr "Cung cấp thông tin dựa trên vị trí và phân tích địa lý bằng dữ liệu Google Maps."

#: ai/agents/mcp_grafana.py:10
msgid ""
"Provides visual insights by analyzing Grafana dashboards and data, "
"reporting on detected anomalies."
msgstr "Cung cấp thông tin trực quan bằng cách phân tích bảng điều khiển và dữ liệu Grafana, báo cáo các bất thường phát hiện được."

#: ai/agents/mcp_influxdb.py:9
msgid "Analyzes InfluxDB v2 time-series data and performs Flux queries."
msgstr "Phân tích dữ liệu chuỗi thời gian InfluxDB v2 và thực hiện các truy vấn Flux."

#: ai/agents/mcp_iotdb.py:10
msgid ""
"Performs precise analysis of large-scale time-series sensor data stored "
"in Apache IoTDB."
msgstr "Thực hiện phân tích chính xác dữ liệu cảm biến chuỗi thời gian quy mô lớn được lưu trữ trong Apache IoTDB."

#: ai/agents/minimax.py:26
msgid ""
"MiniMax M2 series MoE models — optimized for coding, agentic workflows, "
"and multilingual tasks. OpenAI-compatible API."
msgstr "Dòng mô hình MoE MiniMax M2 — được tối ưu hóa cho lập trình, quy trình tác nhân (agentic) và các tác vụ đa ngôn ngữ. API tương thích với OpenAI."

#: ai/agents/mistral.py:24
msgid ""
"Mistral engine, a powerful open/closed-source model developed in Europe, "
"boasting multilingual capabilities and exceptional efficiency."
msgstr "Công cụ Mistral, một mô hình mã nguồn mở/đóng mạnh mẽ được phát triển tại châu Âu, nổi bật với khả năng đa ngôn ngữ và hiệu suất vượt trội."

#: ai/agents/ollama.py:25
msgid ""
"An open-source LLM engine that runs on the user's local PC, ensuring "
"privacy and functioning without an internet connection."
msgstr "Một công cụ LLM mã nguồn mở chạy trên máy tính cục bộ của người dùng, đảm bảo quyền riêng tư và hoạt động không cần kết nối internet."

#: ai/agents/openai.py:23
msgid ""
"OpenAI's widely recognized GPT engine, featuring powerful logical "
"reasoning and creative writing capabilities."
msgstr "Công cụ GPT nổi tiếng của OpenAI, có khả năng suy luận logic mạnh mẽ và viết sáng tạo."

#: ai/agents/openai_compatible.py:43
msgid ""
"A generic driver for any provider that speaks the OpenAI Chat Completions"
" wire format but does not have a dedicated engine here yet. Use this to "
"connect a new provider without writing code."
msgstr "Một trình điều khiển chung cho bất kỳ nhà cung cấp nào sử dụng định dạng giao tiếp OpenAI Chat Completions nhưng chưa có engine chuyên dụng ở đây. Sử dụng cái này để kết nối một nhà cung cấp mới mà không cần viết mã."

#: ai/services/agent_loop_service.py:173
#, python-format
msgid ""
"'%(name)s' doesn't match a single known place in the system. Which "
"location did you mean?"
msgstr "'%(name)s' không khớp với một địa điểm duy nhất đã biết trong hệ thống. Bạn muốn nói đến vị trí nào?"

#: ai/services/agent_loop_service.py:697
msgid ""
"I went through several steps but couldn't reach a conclusion. Could you "
"break the request down and try again?"
msgstr "Tôi đã thực hiện qua nhiều bước nhưng không đưa ra được kết luận. Bạn có thể chia nhỏ yêu cầu và thử lại được không?"

#: ai/services/ai_agent_service.py:946
msgid ""
"This month's AI usage limit has been reached; AI features are paused. "
"They resume automatically on the 1st of next month."
msgstr "Đã đạt đến giới hạn sử dụng AI của tháng này; các tính năng AI đang tạm dừng. Chúng sẽ tự động khôi phục vào ngày 1 tháng sau."

