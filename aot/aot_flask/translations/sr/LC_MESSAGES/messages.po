msgstr "Одлука"

#: functions/lorawan_class_scheduler.py:181
msgid "Score >= -> ACTIVE"
msgstr "Резултат >= -> АКТИВНО"

#: functions/lorawan_class_scheduler.py:183
msgid "Score < -> REST"
msgstr "Резултат < -> МИРОВАЊЕ"

#: functions/lorawan_class_scheduler.py:185
msgid "Minimum dwell (min)"
msgstr "Минимално задржавање (мин)"

#: functions/lorawan_class_scheduler.py:187
msgid "Class / HB Periods"
msgstr "Класа / HB периоди"

#: functions/lorawan_class_scheduler.py:189
