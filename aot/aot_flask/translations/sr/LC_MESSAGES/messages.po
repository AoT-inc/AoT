msgstr "Сензор влажности, температуре и EC земљишта"

#: inputs/sensecap_weather.py:85
msgid "LoRaWAN 8-in-1 Compact Weather Station (S2120)"
msgstr "LoRaWAN компактна метеоролошка станица 8-у-1 (S2120)"

