#: aot_flask/templates/settings/user_detail.html:149
msgid "No API keys issued."
msgstr "Нема издатих API кључева."

#: aot_flask/templates/settings/user_detail.html:161
msgid "Read-only keys can fetch data but cannot change anything."
msgstr ""
"Кључеви само за читање могу да преузму податке, али не могу ништа да "
