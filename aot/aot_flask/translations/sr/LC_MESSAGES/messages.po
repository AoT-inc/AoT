msgstr "АКТИВНИ HB класе C (мин)"

#: functions/lorawan_class_scheduler.py:191
msgid "REST Class A HB (min)"
msgstr "HB класе A у мировању (мин)"

#: functions/lorawan_class_scheduler.py:193
