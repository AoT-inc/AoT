msgstr "Почетак зиме (MM-DD)"

#: functions/lorawan_class_scheduler.py:199
msgid "Winter end (MM-DD)"
msgstr "Крај зиме (MM-DD)"

#: functions/lorawan_class_scheduler.py:202
#: functions/lorawan_mode_manager.py:312
msgid "Battery Management"
msgstr "Управљање батеријом"

#: functions/lorawan_class_scheduler.py:207
msgid "Not configured (no battery gate)"
msgstr "Није подешено (без контроле батерије)"

#: functions/lorawan_class_scheduler.py:208
msgid "Lead-acid  (low < 11.7 V / critical < 11.4 V)"
msgstr "Оловно-киселинска (ниска < 11.7 V / критична < 11.4 V)"

#: functions/lorawan_class_scheduler.py:209
msgid "LiFePO4    (low < 12.8 V / critical < 12.0 V)"
msgstr "LiFePO4    (ниска < 12.8 V / критична < 12.0 V)"

#: functions/lorawan_class_scheduler.py:213
msgid ""
"Reads battery_V from ChirpStack metrics (requires INA219 wired). Low: "
"forces REST unless manual override is active. Critical: forces REST "
"unconditionally; valve-open interlock still applies."
msgstr ""
"Чита battery_V из ChirpStack метрика (захтева повезан INA219). Ниска: "
"принудно мировање осим ако је активно ручно прегазивање. Критична: "
"принудно мировање безусловно; блокада отворене вентила и даље важи."

#: functions/lorawan_class_scheduler.py:218
msgid "Low-battery HB (min)"
msgstr "HB при ниској батерији (мин)"

#: functions/lorawan_class_scheduler.py:220
msgid ""
"Heartbeat period (minutes) applied when battery is low or critical. "
"Should be >= REST HB to maximise sleep time."
msgstr ""
"Период откуцаја срца (минути) који се примењује када је батерија ниска "
"или критична. Требало би да буде >= HB мировања ради максимизирања "
"времена спавања."

#: functions/lorawan_mode_manager.py:44
msgid "LoRaWAN Mode/Period Manager (RAK3172E)"
msgstr "LoRaWAN менаџер режима/периода (RAK3172E)"

#: functions/lorawan_mode_manager.py:47
msgid ""
"Determines the Class/heartbeat period based on battery, time of day, "
"valve activity, and link quality. Queues downlinks directly via "
"ChirpStack gRPC (DeviceService.Enqueue)."
msgstr ""
"Одређује класу/период откуцаја срца на основу батерије, доба дана, "
"активности вентила и квалитета везе. Ставља силазне линкове у ред "
"директно преко ChirpStack gRPC (DeviceService.Enqueue)."

#: functions/lorawan_mode_manager.py:62
msgid "Controller (valve/actuator) — Class C preferred"
msgstr "Контролер (вентил/актуатор) — предност има класа C"

#: functions/lorawan_mode_manager.py:63
msgid "Sensor — Class A, low power (no gateway GPS required)"
msgstr "Сензор — класа A, ниска потрошња (GPS мрежног пролаза није потребан)"

#: functions/lorawan_mode_manager.py:64
msgid "Hybrid — manual configuration"
msgstr "Хибридно — ручна конфигурација"

#: functions/lorawan_mode_manager.py:66
msgid "Device Role"
msgstr "Улога уређаја"

#: functions/lorawan_mode_manager.py:68
msgid ""
"controller: Class C during operating hours, B at night. sensor: Class A "
"always (no gateway GPS required), longer HB at night. hybrid: follow the "
"settings below exactly."
msgstr ""
"контролер: класа C током радног времена, B ноћу. сензор: увек класа A "
"(GPS мрежног пролаза није потребан), дужи HB ноћу. хибридно: пратите "
"тачно подешавања испод."

#: functions/lorawan_mode_manager.py:81
msgid "Evaluation and apply period (seconds)"
msgstr "Период процене и примене (секунде)"

#: functions/lorawan_mode_manager.py:85
msgid "Server Connection"
msgstr "Веза са сервером"

#: functions/lorawan_mode_manager.py:93
msgid "host:port format (e.g. 127.0.0.1:8080) or http(s)://host:port"
msgstr "формат домаћин:порт (нпр. 127.0.0.1:8080) или http(s)://домаћин:порт"

#: functions/lorawan_mode_manager.py:101
msgid "Enter the JWT token value (without \"Bearer\")"
msgstr "Унесите вредност JWT токена (без „Bearer“)"

#: functions/lorawan_mode_manager.py:109
msgid "16-digit hexadecimal DevEUI (separators allowed)"
msgstr "16-цифрени хексадецимални DevEUI (раздвајачи дозвољени)"

#: functions/lorawan_mode_manager.py:116
msgid "Measurement Inputs"
msgstr "Улази мерења"

#: functions/lorawan_mode_manager.py:124
msgid "ChirpStack REST API port (default 8090)"
msgstr "Порт ChirpStack REST API-ја (подразумевано 8090)"

#: functions/lorawan_mode_manager.py:133
msgid "How far back (seconds) to look in ChirpStack metrics history"
msgstr "Колико уназад (секунде) тражити у историји ChirpStack метрика"

#: functions/lorawan_mode_manager.py:140
msgid "Retry Interval (min)"
msgstr "Интервал поновног покушаја (мин)"

#: functions/lorawan_mode_manager.py:141
msgid ""
"Interval at which to re-apply the same mode when there is no ACK (0 "
"disables retry)"
msgstr ""
"Интервал за поновну примену истог режима када нема потврде (ACK) (0 "
"онемогућава поновни покушај)"

#: functions/lorawan_mode_manager.py:154
msgid "LoRa Class Policy"
msgstr "Политика LoRa класе"

#: functions/lorawan_mode_manager.py:155
msgid ""
"Only in Auto mode is the Class switched according to the mode; selecting "
"a specific class keeps that class."
msgstr ""
"Само у аутоматском режиму се класа пребацује у складу са режимом; избор "
"одређене класе задржава ту класу."

#: functions/lorawan_mode_manager.py:162
msgid "Switch Mode Only When Inputs Are Valid"
msgstr "Промени режим само када су улази важећи"

#: functions/lorawan_mode_manager.py:163
msgid "Apply the mode only when the input conditions/measurements are valid"
msgstr "Примени режим само када су улазни услови/мерења важећи"

#: functions/lorawan_mode_manager.py:171
msgid "Operating Hours"
msgstr "Радно време"

#: functions/lorawan_mode_manager.py:171
msgid ""
"Sets the hours during which performance mode operates. Enter 0–24, or if "
"the start and end times are equal it means 24 hours."
msgstr ""
"Подешава сате током којих ради режим перформанси. Унесите 0–24, или ако "
"су време почетка и завршетка једнаки, то значи 24 сата."

#: functions/lorawan_mode_manager.py:178
msgid "Fixed hours — the start and end hours below"
msgstr "Фиксни сати — сати почетка и завршетка испод"

#: functions/lorawan_mode_manager.py:179
msgid "Sunrise to sunset — follows the season at this location"
msgstr "Од изласка до заласка сунца — прати сезону на овој локацији"

#: functions/lorawan_mode_manager.py:181
msgid "Operating Hours Basis"
msgstr "Основа радног времена"

#: functions/lorawan_mode_manager.py:183
msgid ""
"Fixed hours keep the same clock times all year. Sunrise to sunset follows"
" the daylight at this device's location, so performance mode tracks the "
"season without being re-entered each month. The location is inherited "
"from the map; if it cannot be resolved, the fixed hours below are used "
"instead."
msgstr ""
"Фиксни сати одржавају исто време на сату током целе године. Од изласка до"
" заласка сунца прати дневну светлост на локацији овог уређаја, тако да "
"режим перформанси прати сезону без потребе за поновним уносом сваког "
"месеца. Локација се наслеђује са мапе; ако се не може одредити, уместо "
"тога се користе фиксни сати испод."

#: functions/lorawan_mode_manager.py:194
msgid ""
"Shifts the start of the operating window relative to sunrise. Negative "
"starts earlier (-30 begins 30 minutes before sunrise). Only used when the"
" basis is sunrise to sunset."
msgstr ""
"Помера почетак радног прозора у односу на излазак сунца. Негативна "
"вредност почиње раније (-30 значи почетак 30 минута пре изласка сунца). "
"Користи се само када је основа излазак до заласка сунца."

#: functions/lorawan_mode_manager.py:202
msgid ""
"Shifts the end of the operating window relative to sunset. Positive ends "
"later (30 keeps performance mode for 30 minutes after sunset). Only used "
"when the basis is sunrise to sunset."
msgstr ""
"Помера крај радног прозора у односу на залазак сунца. Позитивна вредност "
"завршава касније (30 задржава режим перформанси 30 минута након заласка "
"сунца). Користи се само када је основа излазак до заласка сунца."

#: functions/lorawan_mode_manager.py:209
msgid "Performance Mode Start (hour)"
msgstr "Почетак режима перформанси (сат)"

#: functions/lorawan_mode_manager.py:210
msgid "Performance mode start time (0–23)"
msgstr "Време почетка режима перформанси (0–23)"

#: functions/lorawan_mode_manager.py:217
msgid "Performance Mode End (hour)"
msgstr "Крај режима перформанси (сат)"

#: functions/lorawan_mode_manager.py:218
msgid "Performance mode end time (0–23)"
msgstr "Време краја режима перформанси (0–23)"

#: functions/lorawan_mode_manager.py:225
msgid "Performance Mode Lead (min)"
msgstr "Рано покретање режима перформанси (мин)"

#: functions/lorawan_mode_manager.py:226
msgid ""
"Specifies, in minutes, how far in advance of the daytime start to switch "
"to performance (Class C) mode."
msgstr ""
"Одређује, у минутима, колико унапред пре почетка дневног периода се "
"прелази у режим перформанси (класа C)."

#: functions/lorawan_mode_manager.py:233
msgid "HB Period per Mode"
msgstr "HB период по режиму"

#: functions/lorawan_mode_manager.py:233
msgid "Sets the heartbeat period for each mode."
msgstr "Поставља heartbeat период за сваки режим."

#: functions/lorawan_mode_manager.py:245
msgid "Performance Mode Class"
msgstr "Класа режима перформанси"

#: functions/lorawan_mode_manager.py:246
msgid "LoRa class to apply to the firmware under the performance (C) policy"
msgstr "LoRa класа која се примењује на фирмвер у оквиру политике перформанси (C)"

#: functions/lorawan_mode_manager.py:258
msgid "Power-saving Mode Class"
msgstr "Класа режима уштеде енергије"

#: functions/lorawan_mode_manager.py:259
msgid "LoRa class to apply to the firmware under the power-saving (B) policy"
msgstr ""
"LoRa класа која се примењује на фирмвер у оквиру политике уштеде енергије"
" (B)"

#: functions/lorawan_mode_manager.py:271
msgid "Ultra-saving Mode Class"
msgstr "Класа режима екстремне уштеде"

#: functions/lorawan_mode_manager.py:272
msgid "LoRa class to apply to the firmware under the ultra-saving (A) policy"
msgstr ""
"LoRa класа која се примењује на фирмвер у оквиру политике екстремне "
"уштеде (A)"

#: functions/lorawan_mode_manager.py:279
msgid "Performance Heartbeat (min)"
msgstr "Heartbeat режима перформанси (мин)"

#: functions/lorawan_mode_manager.py:280
msgid "Performance (C) mode heartbeat period (min)"
msgstr "Heartbeat период режима перформанси (C) (мин)"

#: functions/lorawan_mode_manager.py:287
msgid "Power-saving Heartbeat (min)"
msgstr "Heartbeat режима уштеде енергије (мин)"

#: functions/lorawan_mode_manager.py:288
msgid "Power-saving (B) mode heartbeat period (min)"
msgstr "Heartbeat период режима уштеде енергије (B) (мин)"

#: functions/lorawan_mode_manager.py:295
msgid "Ultra-saving Heartbeat (min)"
msgstr "Heartbeat режима екстремне уштеде (мин)"

#: functions/lorawan_mode_manager.py:296
msgid "Ultra-saving (A) mode heartbeat period (min)"
msgstr "Heartbeat период режима екстремне уштеде (A) (мин)"

#: functions/lorawan_mode_manager.py:305
msgid "Threshold Options"
msgstr "Опције прага"

#: functions/lorawan_mode_manager.py:305
msgid ""
"Sets the mode-switching thresholds. Defaults assume a 4S LiFePO4 pack "
"(12.8 V nominal). For a 12 V lead-acid pack use 12.00 / 11.70 / 11.40 "
"instead — the two chemistries have completely different voltage curves."
msgstr ""
"Поставља прагове за пребацивање режима. Подразумеване вредности "
"претпостављају 4S LiFePO4 батерију (номинално 12,8 V). За 12 V оловну "
"(lead-acid) батерију уместо тога користите 12,00 / 11,70 / 11,40 — ове "
"две хемије имају потпуно различите криве напона."

#: functions/lorawan_mode_manager.py:313
msgid ""
"Automatically switches the mode according to the battery voltage. (Active"
" only when the LoRa class policy is Auto.)"
msgstr ""
"Аутоматски мења режим у зависности од напона батерије. (Активно само када"
" је политика LoRa класе постављена на Auto.)"

#: functions/lorawan_mode_manager.py:320
msgid "Performance Mode Threshold (V)"
msgstr "Праг режима перформанси (V)"

#: functions/lorawan_mode_manager.py:321
msgid ""
"Voltage threshold at which stable operation is possible (4S LiFePO4: "
"13.20 V ≈ 70%; lead-acid 12 V: 12.00 V)"
msgstr ""
"Праг напона при коме је могућ стабилан рад (4S LiFePO4: 13,20 V ≈ 70%; "
"оловна 12 V: 12,00 V)"

#: functions/lorawan_mode_manager.py:328
msgid "Power-saving Threshold (V)"
msgstr "Праг режима уштеде енергије (V)"

#: functions/lorawan_mode_manager.py:329
msgid ""
"Voltage threshold for switching to power-saving mode (4S LiFePO4: 13.00 V"
" ≈ 25%; lead-acid 12 V: 11.70 V)"
msgstr ""
"Праг напона за пребацивање у режим уштеде енергије (4S LiFePO4: 13,00 V ≈"
" 25%; оловна 12 V: 11,70 V)"

#: functions/lorawan_mode_manager.py:336
msgid "Ultra-saving Threshold (V)"
msgstr "Праг режима екстремне уштеде (V)"

#: functions/lorawan_mode_manager.py:337
msgid ""
"Voltage threshold for switching to ultra-saving mode (4S LiFePO4: 12.80 V"
" ≈ 10%, past the knee; lead-acid 12 V: 11.40 V)"
msgstr ""
"Праг напона за пребацивање у режим екстремне уштеде (4S LiFePO4: 12,80 V "
"≈ 10%, након прегиба криве; оловна 12 V: 11,40 V)"

#: functions/lorawan_mode_manager.py:344
msgid "Halt Mode Application When Battery Is Missing"
msgstr "Заустави примену режима када батерија недостаје"

#: functions/lorawan_mode_manager.py:345
msgid ""
"Holds off on mode/period changes when the battery measurement is missing "
"or too old."
msgstr ""
"Одлаже промене режима/периода када мерење батерије недостаје или је "
"застарело."

#: functions/lorawan_mode_manager.py:352
msgid "Link RSSI Minimum (dBm)"
msgstr "Минимални RSSI везе (dBm)"

#: functions/lorawan_mode_manager.py:353 functions/lorawan_mode_manager.py:361
msgid "At or above this value, the link is considered good"
msgstr "На овој или вишој вредности веза се сматра добром"

#: functions/lorawan_mode_manager.py:360
msgid "Link SNR Minimum (dB)"
msgstr "Минимални SNR везе (dB)"

#: functions/lorawan_mode_manager.py:368
msgid "Valve Active Threshold (mA)"
msgstr "Праг активности вентила (mA)"

#: functions/lorawan_mode_manager.py:370
msgid ""
"If battery current exceeds this value, the valve is considered active and"
" the device stays in performance mode. 0 disables this check."
msgstr ""
"Ако струја батерије пређе ову вредност, вентил се сматра активним и "
"уређај остаје у режиму перформанси. Вредност 0 онемогућава ову проверу."

#: functions/lorawan_mode_manager.py:381
msgid ""
"Log \"no apply\" notices when mode/period is unchanged. Leave off in "
"production."
msgstr ""
"Бележи обавештења „no apply” када режим/период остане непромењен. "
"Искључите у производном окружењу."

#: functions/pid_autotune.py:41
msgid "PID Autotune"
msgstr "PID аутоматско подешавање"

#: functions/pid_autotune.py:43
msgid ""
"This function attempts to automatically tune a PID controller. That is, "
"it enables the output and measures the response from the sensor multiple "
"times to calculate the P, I, and D gain values. Updates on the operating "
"status are written to the daemon log, and when autotuning completes "
"successfully a summary is also stored in the daemon log. Only raising the"
" current measurement is supported; lowering the measurement may require "
"some modification of the controller code. To monitor whether the output "
"is normally raising the measurement above the setpoint, it is recommended"
" to graph the measurement and output on the dashboard. The autotune "
"feature is experimental and not fully developed. It is likely it will not"
" generate proper PID gains, so it is recommended not to rely on this "
"function for accurate PID controller tuning."
msgstr ""
"Ова функција покушава да аутоматски подеси PID контролер. Тачније, "
"укључује излаз и вишеструко мери одзив сензора како би израчунала "
"вредности P, I и D појачања. Ажурирања о статусу рада уписују се у "
"дневник демона (daemon log), а када аутоматско подешавање успешно заврши,"
" у дневник демона се такође чува сажетак. Подржано је само подизање "
"тренутног мерења; снижавање мерења може захтевати измену кода контролера."
" Да бисте пратили да ли излаз редовно подиже мерење изнад задате "
"вредности, препоручује се приказ мерења и излаза на графикону контролне "
"табле. Функција аутоматског подешавања је експериментална и није у "
"потпуности развијена. Вероватно неће генерисати исправне PID вредности "
"појачања, па се не препоручује ослањање на ову функцију за прецизно "
"подешавање PID контролера."

#: functions/pid_autotune.py:103
msgid "Noise Band"
msgstr "Појас шума"

#: functions/pid_autotune.py:112
msgid "Outstep"
msgstr "Корак излаза"

#: functions/redundancy.py:45
msgid "Redundant Sensor Data"
msgstr "Резервни подаци сензора"

#: functions/redundancy.py:49
msgid ""
"This function stores the first available measurement. It is useful when "
"you want to configure multiple sensors for backup. If you order the "
"sensors by priority, this function checks the first measurement for "
"existence, and if absent, checks the next measurement, repeating the "
"process. When a measurement is found, it is stored in the database with "
"the custom measurement and unit. The output of this function can be used "
"as an input throughout AoT. If you need to check three or more "
"measurements, you can chain multiple redundancy functions by setting the "
"output of the first function as the input of the second."
msgstr ""
"Ова функција чува прво доступно мерење. Корисна је када желите да "
"конфигуришете више сензора као резерву. Ако сензоре поређате по "
"приоритету, ова функција проверава постојање првог мерења, а ако оно "
"недостаје, проверава следеће мерење, понављајући поступак. Када се мерење"
" пронађе, чува се у бази података са прилагођеним мерењем и јединицом. "
"Излаз ове функције може се користити као улаз било где у AoT-у. Ако треба"
" да проверите три или више мерења, можете повезати више функција "
"резервисања тако што ћете излаз прве функције поставити као улаз друге."

#: functions/regulate_ph_ec.py:41
msgid "pH, EC Regulation"
msgstr "Регулација pH и EC"

#: functions/regulate_ph_ec.py:45
msgid ""
"This function uses two pumps (acid and base solutions) to regulate pH, "
"and can use up to four pumps (A, B, C, D nutrient solutions) to regulate "
"electrical conductivity (EC). You only need to configure the nutrient "
"solution outputs you intend to use. Outputs that are not configured are "
"not activated during EC adjustment, and you can use from one to four "
"pumps. Outputs can operate in units of duration (seconds) or volume (ml),"
" and each output type must be matched to the selected output channel (an "
"on/off output channel for duration control, a volume output channel for "
"volume control). The mixing ratio of the nutrient solutions is determined"
" by the duration or volume setting of each EC output. If you enter an "
"email address (or multiple addresses separated by commas) in the email "
"notification field, a notification email is sent in the following cases. "
"<br>1) when the pH value goes outside the configured danger range, 2) "
"when the EC value is too high and water must be added to the storage "
"tank, 3) when no measurement can be found in the database within a given "
"Max Age range. <br>Each email notification type has its own timer so that"
" the same notification is not sent repeatedly, and the same notification "
"is not sent for the duration of the configured email timer. <br>Once this"
" duration elapses, the timer resets automatically, allowing a new "
"notification to be sent. You can also manually reset the email timers "
"using the Custom Commands below. <br>When the function is enabled, status"
" text is displayed at the bottom of the screen showing the regulation "
"information and the total duration/volume of each output."
msgstr ""
"Ова функција користи две пумпе (раствори киселине и базе) за регулацију "
"pH вредности, а може користити до четири пумпе (хранљиви раствори A, B, "
"C, D) за регулацију електричне проводљивости (EC). Потребно је да "
"конфигуришете само оне излазе хранљивих раствора које намеравате да "
"користите. Неконфигурисани излази се не активирају током подешавања EC "
"вредности, тако да можете користити од једне до четири пумпе. Излази могу"
" радити по јединицама трајања (секунде) или запремине (ml), а сваки тип "
"излаза мора бити усклађен са изабраним излазним каналом (укључи/искључи "
"канал за контролу трајања, канал за контролу запремине за контролу "
"запремине). Однос мешања хранљивих раствора одређен је подешавањем "
"трајања или запремине сваког EC излаза. Ако унесете адресу е-поште (или "
"више адреса раздвојених зарезима) у поље за обавештење путем е-поште, "
"обавештење се шаље у следећим случајевима.<br>1) када pH вредност изађе "
"ван подешаваног опсега опасности, 2) када је EC вредност превисока и "
"потребно је додати воду у резервоар, 3) када се у бази података не "
"пронађе ниједно мерење у оквиру задатог опсега максималне старости (Max "
"Age).<br>Сваки тип обавештења путем е-поште има сопствени тајмер, тако да"
" се исто обавештење не шаље поновно, односно исто обавештење се не шаље "
"током трајања подешеног тајмера е-поште.<br>Када овај период истекне, "
"тајмер се аутоматски ресетује, омогућавајући слање новог обавештења. "
"Тајмере за е-пошту можете ручно ресетовати и путем прилагођених команди "
"(Custom Commands) испод.<br>Када је функција укључена, при дну екрана се "
"приказује статусни текст са информацијама о регулацији и укупним "
"трајањем/запремином сваког излаза."

#: functions/statistics_last_multiple.py:81
msgid "Statistics (Last, Multiple)"
msgstr "Статистика (последње, вишеструко)"

#: functions/statistics_last_multiple.py:85
msgid ""
"This function retrieves multiple measurements, calculates statistics, and"
" stores the results with the selected unit."
msgstr ""
"Ова функција преузима више мерења, израчунава статистику и чува резултате"
" са изабраном јединицом."

#: functions/statistics_past_single.py:79
msgid "Statistics (Past, Single)"
msgstr "Статистика (прошлост, једно)"

#: functions/statistics_past_single.py:83
msgid ""
"This function retrieves multiple values from a single measurement, "
"calculates statistics, and stores the results with the selected unit."
msgstr ""
"Ова функција преузима више вредности из једног мерења, израчунава "
"статистику и чува резултате са изабраном јединицом."

#: functions/sum_accumulate.py:59
msgid "Sum (Accumulate / Point)"
msgstr "Сума (акумулација / тачка)"

#: functions/sum_accumulate.py:64
msgid ""
"Sums a single measurement source over time. Interval mode sums every "
"value between cycles (per-cycle usage). Point mode samples one value at a"
" recurring time-of-day (every N hours, in the device timezone) and sums "
"the most recent N snapshots. The result is stored with the selected "
"measurement and unit."
msgstr ""
"Сабира вредности из једног извора мерења током времена. Режим интервала "
"сабира сваку вредност између циклуса (потрошња по циклусу). Режим тачке "
"узоркује једну вредност у понављајуће доба дана (сваких N сати, у "
"временској зони уређаја) и сабира N најновијих снимака. Резултат се чува "
"са изабраним мерењем и јединицом."

#: functions/sum_accumulate.py:82
msgid "Interval sum (between cycles)"
msgstr "Сума интервала (између циклуса)"

#: functions/sum_accumulate.py:83
msgid "Point sum (value at a recurring time)"
msgstr "Сума тачке (вредност у понављајуће време)"

#: functions/sum_accumulate.py:85
msgid "Sum Mode"
msgstr "Режим суме"

#: functions/sum_accumulate.py:87
msgid ""
"Interval: sum all values in the [previous run, now] window. Point: sum "
"the most recent N snapshot values."
msgstr ""
"Интервал: сабира све вредности у прозору [претходно извршавање, сада]. "
"Тачка: сабира N најновијих вредности снимака."

#: functions/sum_accumulate.py:100
msgid "The single measurement source to sum"
msgstr "Појединачни извор мерења за сабирање"

#: functions/sum_accumulate.py:118
msgid "[Interval mode] The duration between sums"
msgstr "[Режим интервала] Трајање између сабирања"

#: functions/sum_accumulate.py:125
msgid "Snapshot Time (HH:MM)"
msgstr "Време снимка (HH:MM)"

#: functions/sum_accumulate.py:127
msgid ""
"[Point mode] Time-of-day anchor for snapshots in the device timezone "
"(e.g. 00:00). Use 24:00 for midnight."
msgstr ""
"[Режим тачке] Референтно доба дана за снимке у временској зони уређаја "
"(нпр. 00:00). Користите 24:00 за поноћ."

#: functions/sum_accumulate.py:136
msgid "Snapshot Interval"
msgstr "Интервал снимка"

#: functions/sum_accumulate.py:136
msgid "Hours"
msgstr "Сати"

#: functions/sum_accumulate.py:138
msgid ""
"[Point mode] Hours between snapshots, starting from the anchor (e.g. 24 ="
" once daily, 6 = four times daily)"
msgstr ""
"[Режим тачке] Број сати између снимака, рачунајући од референтне тачке "
"(нпр. 24 = једном дневно, 6 = четири пута дневно)"

#: functions/sum_accumulate.py:147
msgid "Point Count (N)"
msgstr "Број тачака (N)"

#: functions/sum_accumulate.py:149
msgid "[Point mode] Number of most-recent snapshot values to sum"
msgstr "[Режим тачке] Број најновијих вредности снимака за сабирање"

#: functions/sum_accumulate.py:156
msgid "Force the sum logic to run immediately, regardless of the period timer"
msgstr "Присилно покреће логику сабирања одмах, без обзира на тајмер периода"

#: functions/sum_last_multiple.py:49
msgid "Sum (Last, Multiple)"
msgstr "Сума (последње, вишеструко)"

#: functions/sum_last_multiple.py:53
msgid ""
"This function retrieves the last value of each selected measurement, sums"
" them, and stores the result with the selected measurement and unit."
msgstr ""
"Ова функција преузима последњу вредност сваког изабраног мерења, сабира "
"их и чува резултат са изабраним мерењем и јединицом."

#: functions/sum_past_single.py:49
msgid "Sum (Past, Single)"
msgstr "Сума (прошлост, једно)"

#: functions/sum_past_single.py:53
msgid ""
"This function retrieves past measurements (within Max Age) of the "
"selected measurement, sums them, and stores the result with the selected "
"measurement and unit."
msgstr ""
"Ова функција преузима прошла мерења (у оквиру Max Age) изабраног мерења, "
"сабира их и чува резултат са изабраним мерењем и јединицом."

#: functions/vapor_pressure_deficit.py:50
msgid "Vapor Pressure Deficit (AVPD)"
msgstr "Дефицит притиска водене паре (AVPD)"

#: functions/vapor_pressure_deficit.py:53
msgid ""
"This function calculates the Vapor Pressure Deficit (AVPD) using leaf "
"temperature and humidity."
msgstr ""
"Ова функција израчунава дефицит притиска водене паре (AVPD) на основу "
"температуре листа и влажности."

#: functions/verification.py:45
msgid "Data Verification"
msgstr "Верификација података"

#: functions/verification.py:49
msgid ""
"This function acquires two measurements, calculates their difference, and"
" stores Measurement A if the difference is not greater than the "
"configured threshold. This lets you verify one sensor's measurement "
"against another sensor's measurement. Since the measurement is only "
"stored when the two sensors agree, you can use the stored measurement in "
"Conditional Functions and similar to notify the user when no measurement "
"is present, indicating a possible sensor problem."
msgstr ""
"Ова функција преузима два мерења, израчунава њихову разлику и чува мерење"
" A ако разлика није већа од подешеног прага. Ово омогућава проверу мерења"
" једног сензора у односу на мерење другог сензора. Пошто се мерење чува "
"само када се два сензора слажу, чувано мерење можете користити у условним"
" функцијама (Conditional Functions) и сличним алатима да обавестите "
"корисника када мерење недостаје, што указује на могући проблем са "
"сензором."

