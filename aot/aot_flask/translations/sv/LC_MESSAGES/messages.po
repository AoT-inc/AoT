#: functions/custom_functions/env_coordinator_impl/_function_info.py:69
msgid "Integrated Environment Control"
msgstr "Integrerad miljöstyrning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:73
msgid ""
"Coordinates registered Output actuators to optimise photosynthesis. VPD "
"is the primary control target; temperature and humidity act as safety "
"constraints. Add \"Environment Control: Register Actuator\" actions to "
"register devices. External environment data (outdoor temperature, "
"humidity, wind, rain, solar, CO₂) comes from the linked facility's "
"outdoor sensors, or optionally from the ext_context_collector function."
msgstr "Koordinerar registrerade utgångsaktuatorer för att optimera fotosyntesen. VPD är det primära styrmålet; temperatur och luftfuktighet fungerar som säkerhetsbegränsningar. Lägg till åtgärden \"Miljöstyrning: Registrera aktuator\" för att registrera enheter. Extern miljödata (utomhustemperatur, luftfuktighet, vind, regn, solinstrålning, CO₂) hämtas från den länkade anläggningens utomhussensorer, eller valfritt från funktionen ext_context_collector."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:85
msgid "Trigger an immediate cycle, reload actuators, or issue an emergency stop."
msgstr "Utlös en omedelbar cykel, ladda om aktuatorer eller utför ett nödstopp."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:93
msgid "Reload Actuators"
msgstr "Ladda om aktuatorer"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:95
msgid "Re-read the Actions table and rebuild actuator profiles."
msgstr "Läs om åtgärdstabellen och bygg om aktuatorprofiler."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:103
msgid "Run Now"
msgstr "Kör nu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:105
msgid "Execute one coordination cycle immediately using current sensor readings."
msgstr "Kör en koordineringscykel omedelbart med aktuella sensoravläsningar."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:113
msgid "Emergency Stop"
msgstr "Nödstopp"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:115
msgid "Immediately set all actuators to safe_default and pause control for 60 s."
msgstr "Ställ omedelbart in alla aktuatorer på safe_default och pausa styrningen i 60 s."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:132
msgid "Fewer decisions"
msgstr "Färre beslut"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:133
msgid "Faster response"
msgstr "Snabbare respons"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:522
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1080
msgid "Relaxed"
msgstr "Avslappnad"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
msgid "Slow"
msgstr "Långsam"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:134
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1088
msgid "Responsive"
msgstr "Responsiv"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:140
msgid ""
"Coordination cycle interval. Recommended: slowest actuator response time "
"× 1.5."
msgstr "Intervall för koordineringscykel. Rekommenderat: långsammaste aktuatorns svarstid × 1,5."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:148
msgid "Max Sensor Age (seconds)"
msgstr "Max sensorålder (sekunder)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:158
msgid ""
"Reject sensor readings older than this. Leave at 0 to let each sensor "
"decide from its own update interval."
msgstr "Avvisa sensoravläsningar som är äldre än detta. Lämna på 0 för att låta varje sensor avgöra utifrån sitt eget uppdateringsintervall."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:166
msgid "Actuation Rate"
msgstr "Manövreringsfrekvens"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:175
msgid "Responsive (60s)"
msgstr "Responsiv (60 s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:176
msgid "Standard (180s)"
msgstr "Standard (180 s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:177
msgid "Gentle — extend vent motor life (600s)"
msgstr "Skonsam — förlänger ventilationsmotorns livslängd (600 s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:178
msgid "Custom (set seconds below)"
msgstr "Anpassad (ange sekunder nedan)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:180
msgid "Vent Actuation Profile"
msgstr "Manövreringsprofil för ventilation"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:182
msgid "How often the vents may move. Emergencies and safety gates ignore this."
msgstr "Hur ofta ventilationsluckorna får röra sig. Nödlägen och säkerhetsspärrar ignorerar detta."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:191
msgid "Custom Actuation Period (seconds)"
msgstr "Anpassad manövreringsperiod (sekunder)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:193
msgid ""
"Used only when Vent Actuation Profile = Custom. 0 = fall back to the "
"selected profile default."
msgstr "Används endast när manövreringsprofilen för ventilation = Anpassad. 0 = återgå till den valda profilens standardvärde."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:204
msgid "Emergency Minimum Interval (seconds)"
msgstr "Minsta nödintervall (sekunder)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:206
msgid ""
"Even during an emergency, vents will not be re-commanded more often than "
"this — prevents rapid back-to-back moves."
msgstr "Även under ett nödläge kommer ventilationsluckorna inte att styras om oftare än detta — förhindrar snabba upprepade rörelser."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:215
#: functions/custom_functions/env_coordinator_impl/_function_info.py:233
msgid "Reacts later"
msgstr "Reagerar senare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:216
#: functions/custom_functions/env_coordinator_impl/_function_info.py:234
msgid "Reacts sooner"
msgstr "Reagerar tidigare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:235
msgid "Late"
msgstr "Sen"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:217
#: functions/custom_functions/env_coordinator_impl/_function_info.py:235
msgid "Early"
msgstr "Tidig"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:221
msgid "Emergency Deviation Threshold (× tolerance)"
msgstr "Tröskel för nödavvikelse (× tolerans)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:223
msgid ""
"If a variable deviates from its target by more than this many times its "
"tolerance, treat the cycle as an emergency and move vents immediately "
"(ignore the actuation period above)."
msgstr "Om en variabel avviker från sitt målvärde med mer än så här många gånger sin tolerans, behandlas cykeln som ett nödläge och ventilationsluckorna flyttas omedelbart (ignorerar manövreringsperioden ovan)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:239
msgid "Emergency Rate Threshold (°C / 10min)"
msgstr "Tröskel för nödändringshastighet (°C / 10 min)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:241
msgid ""
"If indoor temperature is changing faster than this rate, treat the cycle "
"as an emergency and move vents immediately."
msgstr "Om inomhustemperaturen ändras snabbare än denna hastighet, behandlas cykeln som ett nödläge och ventilationsluckorna flyttas omedelbart."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:251
msgid "Close Vents When Ventilation Cannot Help"
msgstr "Stäng ventilationsluckor när ventilation inte hjälper"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:253
msgid ""
"Opening helps only when the outdoor air is on the target side. When it is"
" not, wider vents drag the reading further away."
msgstr "Att öppna hjälper endast när utomhusluften ligger på målsidan. När så inte är fallet drar bredare öppningar avläsningen längre bort."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:264
msgid "Night Vent Parking"
msgstr "Nattparkering av ventilation"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:271
msgid "Close at Night"
msgstr "Stäng på natten"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:273
msgid ""
"Keep the vents closed overnight and let heating, cooling and drying carry"
" the load."
msgstr "Håll ventilationsluckorna stängda över natten och låt uppvärmning, kylning och torkning ta hand om belastningen."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:284
msgid "Sunset to sunrise"
msgstr "Solnedgång till soluppgång"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:285
msgid "Fixed clock times"
msgstr "Fasta klockslag"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:287
msgid "Night Starts At"
msgstr "Natten börjar vid"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:289
msgid "Whether night is measured from sunset to sunrise, or by fixed clock times."
msgstr "Om natten mäts från solnedgång till soluppgång, eller med fasta klockslag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:299
msgid "Close Before Sunset (min)"
msgstr "Stäng före solnedgång (min)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:301
msgid "Start closing this many minutes before sunset."
msgstr "Börja stänga så här många minuter före solnedgång."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:311
msgid "Night Start (HH:MM)"
msgstr "Nattens start (TT:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:313
msgid "When night starts, if you chose fixed clock times."
msgstr "När natten börjar, om du valde fasta klockslag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:323
msgid "Night End (HH:MM)"
msgstr "Nattens slut (TT:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:325
msgid "When night ends, if you chose fixed clock times."
msgstr "När natten slutar, om du valde fasta klockslag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:332
msgid "Heating / Cooling Interlock"
msgstr "Spärr för uppvärmning/kylning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:340
msgid "Rest Heating and Cooling When Venting Can Reach the Target"
msgstr "Vila uppvärmning och kylning när ventilation kan nå målet"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:342
msgid "No point burning fuel for what an open vent already does."
msgstr "Ingen mening att förbruka bränsle för det en öppen ventilationslucka redan gör."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:351
msgid "Keep Vents Closed While Heating or Cooling Runs"
msgstr "Håll ventilationsluckor stängda medan uppvärmning eller kylning körs"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:353
msgid "Venting against a running unit throws that heat or cold straight outside."
msgstr "Att ventilera mot en aktiv enhet kastar värmen eller kylan rakt ut."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:367
msgid "Heating / Cooling Running Signal"
msgstr "Signal för att uppvärmning/kylning körs"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:369
msgid ""
"Only for units this coordinator does not switch itself — it already knows"
" about the ones it commands. Not an indoor temperature: something that "
"reports the unit running, such as a power reading or a relay state."
msgstr "Endast för enheter som denna koordinator inte styr själv — den känner redan till de den styr. Inte en inomhustemperatur: något som rapporterar att enheten körs, till exempel en effektavläsning eller ett relästatus."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:379
msgid "Running Signal Threshold"
msgstr "Tröskel för driftsignal"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:381
msgid ""
"Read on the signal chosen above, in whatever unit that signal uses. For "
"an on/off signal (0 or 1) leave it at 0.5."
msgstr "Avläses på signalen som valts ovan, i vilken enhet den signalen än använder. För en på/av-signal (0 eller 1), lämna på 0,5."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:391
msgid "Growth Schedule"
msgstr "Tillväxtschema"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:399
msgid "Stop Control On"
msgstr "Stoppa styrning den"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:401
msgid "Control stops for good after this date. Leave blank to keep running."
msgstr "Styrningen stoppas permanent efter detta datum. Lämna tomt för att fortsätta köra."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:408
msgid "Facility (optional)"
msgstr "Anläggning (valfritt)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:416
msgid "Linked Facility"
msgstr "Länkad anläggning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:418
msgid "Which facility this coordinator runs. Actuators and sensors come from it."
msgstr "Vilken anläggning denna koordinator körs på. Aktuatorer och sensorer hämtas från den."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:433
msgid "Bay Scope (optional)"
msgstr "Fackomfattning (valfritt)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:435
msgid "Limit this coordinator to one bay. Leave blank for the whole facility."
msgstr "Begränsa denna koordinator till ett fack. Lämna tomt för hela anläggningen."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:442
msgid "Time Control"
msgstr "Tidsstyrning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:449
msgid "Enable Time Window"
msgstr "Aktivera tidsfönster"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:451
msgid ""
"Outside this window the coordinator stops entirely — heating and cooling "
"included. Safety limits still act."
msgstr "Utanför detta fönster stoppar koordinatorn helt — inklusive uppvärmning och kylning. Säkerhetsgränser gäller fortfarande."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:462
msgid "When the coordinator starts working each day."
msgstr "När koordinatorn börjar arbeta varje dag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:473
msgid "When it stops. What each device does at that moment is set in its Action."
msgstr "När den stoppar. Vad varje enhet gör vid det tillfället anges i dess åtgärd."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:483
msgid "Photoperiod Method"
msgstr "Metod för fotoperiod"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:485
msgid ""
"Sets the window above from a day-length curve instead of fixed times. "
"Careful: a short day length means the coordinator runs for only those "
"hours, so nothing is heated overnight."
msgstr "Ställer in fönstret ovan utifrån en daglängdskurva istället för fasta tider. Var försiktig: en kort daglängd innebär att koordinatorn endast körs under de timmarna, så inget värms upp över natten."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:496
msgid "Photoperiod Anchor (HH:MM)"
msgstr "Ankarpunkt för fotoperiod (TT:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:498
msgid "The window is centred on this time."
msgstr "Fönstret centreras kring denna tid."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:512
msgid "VPD Priority"
msgstr "VPD-prioritet"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:513
msgid "Higher value = processed first. Default 1.2."
msgstr "Högre värde = behandlas först. Standard 1,2."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:520
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1070
msgid "Moves equipment less"
msgstr "Rör utrustningen mindre"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:521
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1071
msgid "Tracks the target closely"
msgstr "Följer målet nära"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:522
msgid "Loose"
msgstr "Lös"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:522
msgid "Tight"
msgstr "Stram"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:525
msgid "VPD Tolerance (kPa)"
msgstr "VPD-tolerans (kPa)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:527
msgid ""
"Dead-band half-width around the VPD setpoint. Adjustments are skipped "
"when the deviation is within this range, reducing unnecessary actuator "
"cycling. Typical value: 0.05–0.15 kPa."
msgstr "Halva bredden av dödbandet kring VPD-börvärdet. Justeringar hoppas över när avvikelsen ligger inom detta intervall, vilket minskar onödig aktuatorcykling. Typiskt värde: 0,05–0,15 kPa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:544
msgid "Max Light Threshold"
msgstr "Max ljuströskel"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:546
msgid ""
"Close the shade screen above this light level. 0 = never shade. This is a"
" shading choice only — how much light the crop can use comes from its "
"program."
msgstr "Stäng skuggduken över denna ljusnivå. 0 = skugga aldrig. Detta är endast ett skuggningsval — hur mycket ljus grödan kan använda kommer från dess program."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:555
msgid "Min Light Threshold (Supplemental)"
msgstr "Min ljuströskel (tilläggsbelysning)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:557
msgid ""
"Switch supplemental lighting on below this light level. 0 = no "
"supplemental lighting, which is most facilities."
msgstr "Slå på tilläggsbelysning under denna ljusnivå. 0 = ingen tilläggsbelysning, vilket gäller de flesta anläggningar."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:565
msgid "CO₂"
msgstr "CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:573
msgid "CO₂ Priority"
msgstr "CO₂-prioritet"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:575
msgid ""
"Processing order weight for CO₂ relative to other control variables. "
"Higher value = processed earlier in each cycle. Default 0.8 (lower than "
"VPD 1.2, since CO₂ enrichment is secondary)."
msgstr "Viktning av behandlingsordning för CO₂ i förhållande till andra styrvariabler. Högre värde = behandlas tidigare i varje cykel. Standard 0,8 (lägre än VPD 1,2, eftersom CO₂-berikning är sekundär)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:585
msgid "CO₂ Tolerance (ppm)"
msgstr "CO₂-tolerans (ppm)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:587
msgid ""
"Dead-band half-width around the CO₂ setpoint. Adjustments are skipped "
"when the deviation is within this range. Typical value: 50–150 ppm."
msgstr "Halva bredden av dödbandet kring CO₂-börvärdet. Justeringar hoppas över när avvikelsen ligger inom detta intervall. Typiskt värde: 50–150 ppm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:604
msgid "Max Temperature (°C)"
msgstr "Max temperatur (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:606
msgid "Hard upper limit. Forces cooling when exceeded, regardless of VPD target."
msgstr "Hård övre gräns. Tvingar fram kylning när den överskrids, oavsett VPD-mål."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:615
msgid "Min Temperature (°C)"
msgstr "Min temperatur (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:617
msgid "Hard lower limit. Forces heating when below, regardless of VPD target."
msgstr "Hård nedre gräns. Tvingar fram uppvärmning när den underskrids, oavsett VPD-mål."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:632
msgid "Max Humidity (%)"
msgstr "Max luftfuktighet (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:634
msgid "Hard upper limit. Prevents VPD bypass via extreme humidity."
msgstr "Hård övre gräns. Förhindrar VPD-kringgående via extrem luftfuktighet."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:643
msgid "Min Humidity (%)"
msgstr "Min luftfuktighet (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:645
msgid "Hard lower limit. Prevents VPD bypass via extreme dryness."
msgstr "Hård nedre gräns. Förhindrar VPD-kringgående via extrem torrhet."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:654
msgid "Use Micro Sprinklers to Raise Humidity"
msgstr "Använd mikrospridare för att höja luftfuktigheten"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:656
msgid ""
"Use the micro sprinklers for humidity too. Turn off when they are your "
"irrigation."
msgstr "Använd även mikrospridarna för luftfuktighet. Stäng av om de är din bevattning."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:667
msgid "Misting Sunburn Protection"
msgstr "Solskyddsskydd för dimning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:676
msgid "Misting Lockout Irradiance (W/m²)"
msgstr "Spärrnivå för dimning, instrålning (W/m²)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:678
msgid ""
"Wetting-type misting is blocked outright at or above this indoor light "
"level. The estimated indoor level is used, so closing the shade screen "
"relaxes the lockout."
msgstr "Fuktande dimning blockeras helt vid eller över denna inomhusljusnivå. Den uppskattade inomhusnivån används, så att stänga skuggduken lättar på spärren."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:690
msgid "Misting Release Irradiance (W/m²)"
msgstr "Frisläppningsnivå för dimning, instrålning (W/m²)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:692
msgid ""
"Misting is released again once the light falls below this level, and is "
"tapered linearly between here and the lockout threshold. The gap between "
"the two prevents the mist from switching on and off as clouds pass."
msgstr "Dimning frisläpps igen när ljuset sjunker under denna nivå, och trappas ned linjärt mellan denna nivå och spärrtröskeln. Skillnaden mellan de två förhindrar att dimningen slås på och av när moln passerar."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:701
msgid "Nursery Mode"
msgstr "Plantskoleläge"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:709
msgid "Nursery (Seedling) Mode"
msgstr "Plantskoleläge (plantor)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:711
msgid ""
"Tighter misting limits for seedlings, which scorch more easily than grown"
" leaves."
msgstr "Striktare dimningsgränser för plantor, som bränns lättare än fullvuxna blad."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:720
msgid "Max Spray Duration (s)"
msgstr "Max sprejtid (s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:722
msgid ""
"Longest single spray. Humidification is regulated by how often it sprays,"
" not by how long — the same way irrigation doses a fixed amount at "
"intervals."
msgstr "Längsta enskilda sprejning. Luftfuktning regleras av hur ofta den sprejar, inte hur länge — på samma sätt som bevattning doserar en fast mängd med intervall."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:732
msgid "Humidity rises faster"
msgstr "Luftfuktigheten stiger snabbare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:733
msgid "More time for leaves to dry"
msgstr "Mer tid för bladen att torka"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
#: functions/custom_functions/env_coordinator_impl/_function_info.py:997
msgid "Short"
msgstr "Kort"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
#: functions/custom_functions/env_coordinator_impl/_function_info.py:997
msgid "Long"
msgstr "Lång"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
msgid "Very long"
msgstr "Mycket lång"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:737
msgid "Enforced Drying Interval (s)"
msgstr "Obligatoriskt torkningsintervall (s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:739
msgid ""
"No spraying at all for this long after one finishes, so the leaves get a "
"chance to dry."
msgstr "Ingen sprejning alls under denna tid efter att en avslutats, så att bladen får chans att torka."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:750
msgid "Allow Misting Before Sunset"
msgstr "Tillåt dimning före solnedgång"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:752
msgid "Allow misting near sunset. Turn off to leave the leaves dry overnight."
msgstr "Tillåt dimning nära solnedgång. Stäng av för att lämna bladen torra över natten."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:762
msgid "Stop Misting Before Sunset (min)"
msgstr "Stoppa dimning före solnedgång (min)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:764
msgid "How long before sunset misting stops."
msgstr "Hur lång tid före solnedgång dimningen stoppar."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:775
msgid "Groundwater (untreated)"
msgstr "Grundvatten (obehandlat)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:776
msgid "Treated (RO, softened, filtered)"
msgstr "Behandlat (RO, avhärdat, filtrerat)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:777
msgid "Rainwater"
msgstr "Regnvatten"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:779
msgid "Misting Water Source"
msgstr "Vattenkälla för dimning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:781
msgid ""
"Harder or colder water needs a lower sunburn threshold, which this sets "
"for you."
msgstr "Hårdare eller kallare vatten kräver en lägre tröskel för solskador, vilket detta ställer in åt dig."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:788
msgid "VPD Decomposition"
msgstr "VPD-uppdelning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:795
msgid "T Weight (0-1)"
msgstr "T-vikt (0–1)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:797
msgid ""
"VPD decomposition: fraction of adjustment via temperature (rest via "
"humidity). 0.6 = favour temperature adjustment. Range 0.0~1.0."
msgstr "VPD-uppdelning: andel av justeringen via temperatur (resten via luftfuktighet). 0,6 = prioritera temperaturjustering. Intervall 0,0–1,0."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:805
msgid "Photosynthesis Model"
msgstr "Fotosyntesmodell"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:812
msgid "Enable Photosynthesis-Oriented Control"
msgstr "Aktivera fotosyntesorienterad styrning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:814
msgid ""
"Let the model decide which of light, CO₂, temperature or VPD is limiting "
"right now."
msgstr "Låt modellen avgöra vilken av ljus, CO₂, temperatur eller VPD som är begränsande just nu."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:823
msgid "Reference Plot (optional)"
msgstr "Referensodlingsyta (valfritt)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:825
msgid ""
"Which plot this coordinator follows, when more than one is growing in its"
" scope. Leave empty when there is only one — it is picked automatically. "
"When more than one is growing, pick it from the summary under the linked "
"facility above."
msgstr "Vilken odlingsyta denna koordinator följer, när mer än en odlas inom dess omfattning. Lämna tomt när det bara finns en — den väljs automatiskt. När mer än en odlas, välj den från sammanfattningen under den länkade anläggningen ovan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:834
msgid "Guide Ranges (T / RH)"
msgstr "Riktvärdesintervall (T/RH)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:842
msgid "Guide T Min (°C)"
msgstr "Riktvärde T min (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:844
msgid ""
"Advisory lower bound for temperature. Triggers forced heating when "
"exceeded (replaces Min Temperature setting when using crop-preset-derived"
" guide ranges)."
msgstr "Rådgivande nedre gräns för temperatur. Utlöser tvingad uppvärmning när den överskrids (ersätter inställningen Min temperatur vid användning av riktvärdesintervall härledda från grödförinställningar)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:855
msgid "Guide T Max (°C)"
msgstr "Riktvärde T max (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:856
msgid "Advisory upper bound for temperature."
msgstr "Rådgivande övre gräns för temperatur."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:864
msgid "Guide RH Min (%)"
msgstr "Riktvärde RH min (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:865
msgid "Advisory lower bound for relative humidity."
msgstr "Rådgivande nedre gräns för relativ luftfuktighet."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:873
msgid "Guide RH Max (%)"
msgstr "Riktvärde RH max (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:874
msgid "Advisory upper bound for relative humidity."
msgstr "Rådgivande övre gräns för relativ luftfuktighet."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:880
msgid "Cumulative Goal Tracker"
msgstr "Kumulativ målspårning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:887
msgid "Enable DLI / GDD Tracker"
msgstr "Aktivera DLI-/GDD-spårning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:889
msgid ""
"Tracks daily light integral (DLI) and growing degree-days (GDD), rolling "
"over at the facility-local midnight (device timezone). Light is converted"
" to PPFD by sensor unit (W/m² assumed if unknown). Generates compensation"
" suggestions when debt accumulates. Requires a Light sensor for DLI "
"tracking."
msgstr "Spårar daglig ljusintegral (DLI) och groddagsgrader (GDD), som nollställs vid anläggningens lokala midnatt (enhetens tidszon). Ljus omvandlas till PPFD utifrån sensorenhet (W/m² antas om okänt). Genererar kompensationsförslag när underskott ackumuleras. Kräver en ljussensor för DLI-spårning."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:909
msgid "Strong Wind Threshold (m/s)"
msgstr "Tröskel för stark vind (m/s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:911
msgid "Openings (vents, side walls) are forced closed above this wind speed."
msgstr "Öppningar (ventilationsluckor, sidoväggar) tvingas stängas över denna vindhastighet."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:918
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1483
msgid "Effect Calibration"
msgstr "Effektkalibrering"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:926
msgid "Legacy (built-in K constants)"
msgstr "Äldre (inbyggda K-konstanter)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:927
msgid "Shadow (grey-box logged, legacy controls)"
msgstr "Skugga (grey-box loggad, äldre styrning)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:928
msgid "Grey-box (physics model controls)"
msgstr "Grey-box (fysikmodellstyrning)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:930
msgid "Effect Engine"
msgstr "Effektmotor"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:932
msgid ""
"Which model computes the effect of each actuator. Change only while "
"testing."
msgstr "Vilken modell som beräknar effekten av varje aktuator. Ändra endast vid testning."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:940
msgid "Enable RLS Calibration"
msgstr "Aktivera RLS-kalibrering"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:942
msgid ""
"Learn per-actuator effect coefficients (K_*) from sensor response. "
"Requires several days of data to converge. Falls back to built-in "
"defaults until convergence."
msgstr "Lär in effektkoefficienter per aktuator (K_*) utifrån sensorrespons. Kräver flera dagars data för att konvergera. Återgår till inbyggda standardvärden fram till konvergens."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:952
msgid "Enable Active Probing"
msgstr "Aktivera aktiv sondering"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:954
#, python-format
msgid ""
"Periodically perturb one actuator by ±10 %% to improve calibration "
"identifiability. Only triggers when load is low and no safety gate is "
"active. Requires RLS Calibration to be enabled."
msgstr "Störa periodiskt en aktuator med ±10 %% för att förbättra kalibreringens identifierbarhet. Utlöses endast när belastningen är låg och ingen säkerhetsspärr är aktiv. Kräver att RLS-kalibrering är aktiverad."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:963
msgid "Probes more often"
msgstr "Sonderar oftare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:964
msgid "Probes rarely"
msgstr "Sonderar sällan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:965
msgid "Often"
msgstr "Ofta"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:965
msgid "Rare"
msgstr "Sällan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:968
msgid "Probe Interval (seconds)"
msgstr "Sonderingsintervall (sekunder)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:970
msgid "Minimum time between active probing events. Default 3600 s (1 hour)."
msgstr "Minsta tid mellan aktiva sonderingshändelser. Standard 3600 s (1 timme)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:977
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1486
msgid "Forecast Feedforward"
msgstr "Prognosbaserad framkoppling"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:984
msgid "Enable Forecast Feedforward"
msgstr "Aktivera prognosbaserad framkoppling"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:986
msgid ""
"Use KMA short-term weather forecast (forecast.json) to proactively shift "
"temperature/humidity setpoints and inhibit ventilation before adverse "
"weather arrives."
msgstr "Använd KMA:s kortsiktiga väderprognos (forecast.json) för att proaktivt förskjuta börvärden för temperatur/luftfuktighet och hämma ventilation innan ogynnsamt väder anländer."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:995
msgid "Reacts to what is here now"
msgstr "Reagerar på det som är här nu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:996
msgid "Prepares further ahead"
msgstr "Förbereder längre i förväg"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1000
msgid "Forecast Lookahead (hours)"
msgstr "Prognoshorisont (timmar)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1002
msgid ""
"How many hours ahead to check for incoming adverse weather (1–6 h). "
"Longer lookahead gives earlier warning but may over-correct."
msgstr "Hur många timmar framåt som kontrolleras för inkommande ogynnsamt väder (1–6 tim). Längre horisont ger tidigare varning men kan överkorrigera."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1065
msgid "Control Temperament"
msgstr "Styrningens temperament"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1067
msgid ""
"How hard the system chases the target. Sets the cycle, how often vents "
"may move, the dead-band and the emergency thresholds together."
msgstr "Hur hårt systemet jagar målet. Ställer in cykeln, hur ofta ventilationsluckorna får röra sig, dödbandet och nödtrösklarna tillsammans."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1127
msgid "Ventilation and HVAC Teamwork"
msgstr "Samspel mellan ventilation och klimatanläggning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1134
msgid ""
"Keeps venting and HVAC from working against each other. At [Energy "
"saving] the HVAC rests when venting alone can reach the target, and the "
"vents close while it runs. At [High performance] both act freely so the "
"target is reached sooner."
msgstr "Förhindrar att ventilation och klimatanläggning motverkar varandra. Vid [Energibesparing] vilar klimatanläggningen när ventilation ensam kan nå målet, och ventilationsluckorna stängs medan den körs. Vid [Hög prestanda] agerar båda fritt så att målet nås snabbare."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1139
msgid "Reaches the target sooner"
msgstr "Når målet snabbare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1140
msgid "Wastes less"
msgstr "Slösar mindre"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1148
msgid "High performance"
msgstr "Hög prestanda"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1154
msgid "Energy saving"
msgstr "Energibesparing"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1163
msgid "Misting Frequency"
msgstr "Dimningsfrekvens"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1178
msgid "How often the misting runs — the run time and the gap until the next run."
msgstr "Hur ofta dimningen körs — körtiden och gapet till nästa körning."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1181
msgid "Drier"
msgstr "Torrare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1182
msgid "Moister"
msgstr "Fuktigare"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1192
msgid "Not used"
msgstr "Används inte"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1209
msgid "Infrequent"
msgstr "Sällan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1212
msgid "Moderate"
msgstr "Måttlig"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1215
msgid "Frequent"
msgstr "Ofta"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1218
msgid "Very frequent"
msgstr "Mycket ofta"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1228
msgid "Temperature Range"
msgstr "Temperaturintervall"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1230
msgid ""
"Aims to stay inside this range. Past a limit it stops whatever pushes the"
" wrong way — too warm: heating off and the shade screen drawn; too cold: "
"cooling off, vents and thermal curtain closed. It does not slam anything "
"to full."
msgstr "Strävar efter att hålla sig inom detta intervall. Bortom en gräns stoppas det som driver i fel riktning — för varmt: uppvärmning av och skuggduken fälld; för kallt: kylning av, ventilationsluckor och värmegardin stängda. Ingenting körs till fullt utslag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1232
#: functions/custom_functions/env_coordinator_impl/_function_info.py:1270
msgid "never past"
msgstr "aldrig förbi"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1247
msgid "Misting by Sunlight Level"
msgstr "Dimning efter solljusnivå"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1255
msgid ""
"Applies to leaf-wetting misting only — fog-type misting runs in strong "
"sun too. Darker than the range it runs freely; brighter than the range it"
" stops; inside the range it tapers off."
msgstr "Gäller endast bladfuktande dimning — dimtypsdimning körs även i starkt solljus. Mörkare än intervallet körs den fritt; ljusare än intervallet stoppar den; inom intervallet trappas den ned."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1266
msgid "Humidity Range"
msgstr "Luftfuktighetsintervall"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1268
msgid ""
"Aims to stay inside this range. Past a limit it stops whatever pushes the"
" wrong way — too damp: misting off; too dry: exhaust fans off. It does "
"not slam anything to full."
msgstr "Strävar efter att hålla sig inom detta intervall. Bortom en gräns stoppas det som driver i fel riktning — för fuktigt: dimning av; för torrt: frånluftsfläktar av. Ingenting körs till fullt utslag."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1285
msgid "Shading and Supplemental Light"
msgstr "Skuggning och tilläggsbelysning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1292
msgid ""
"Darker than the range: the supplemental lights come on and the shade "
"screen opens. Brighter than the range: the shade screen closes. Inside "
"the range nothing happens. Either end can be turned off."
msgstr "Mörkare än intervallet: tilläggsbelysningen tänds och skuggduken öppnas. Ljusare än intervallet: skuggduken stängs. Inom intervallet händer ingenting. Vardera änden kan stängas av."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1300
msgid "no supplemental light"
msgstr "ingen tilläggsbelysning"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:1301
msgid "no shading"
msgstr "ingen skuggning"

