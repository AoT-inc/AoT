msgstr "Fasta timmar — start- och sluttimmarna nedan"

#: functions/lorawan_mode_manager.py:179
msgid "Sunrise to sunset — follows the season at this location"
msgstr "Soluppgång till solnedgång — följer säsongen på denna plats"

#: functions/lorawan_mode_manager.py:181
