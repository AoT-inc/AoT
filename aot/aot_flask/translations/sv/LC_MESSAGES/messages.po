msgstr "Standard: 25. Maxgräns är 30."

#: aot_flask/templates/pages/geo/geo_setting.html:247
msgid "Use digital zoom for high zoom levels not provided by the map source."
msgstr "Använd digital zoom för höga zoomnivåer som inte tillhandahålls av kartkällan."

#: aot_flask/templates/pages/geo/geo_setting.html:262
msgid "Enable fractional zoom for levels close to 18 and above."
msgstr "Aktivera bråkdelszoom för nivåer nära 18 och högre."

#: aot_flask/templates/pages/geo/geo_setting.html:283
msgid "Enable fade-in effect when tiles load."
msgstr "Aktivera intoningseffekt när kartrutor läses in."

#: aot_flask/templates/pages/geo/geo_setting.html:298
msgid ""
"Use Canvas renderer to improve performance when many vector layers are "
"present."
msgstr "Använd Canvas-rendering för att förbättra prestanda när många vektorlager finns."

#: aot_flask/templates/pages/geo/geo_setting.html:312
msgid "Max Site Polygons"
msgstr "Max antal platspolygoner"

#: aot_flask/templates/pages/geo/geo_setting.html:314
msgid ""
"Limit max polygons for Sites. Sites exceeding this limit will be rendered"
" as points."
msgstr "Begränsa max antal polygoner för platser. Platser som överskrider denna gräns visas som punkter."

#: aot_flask/templates/pages/geo/geo_setting.html:325
msgid "Max Zone Polygons"
msgstr "Max antal zonpolygoner"

#: aot_flask/templates/pages/geo/geo_setting.html:327
