msgstr "Next Sunrise/Sunset with Offset"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:39
msgid "Execute condition at Sunrise or Sunset?"
msgstr "Execute condition at Sunrise or Sunset?"

#: aot_flask/templates/pages/function_options/trigger_options/sunrise_sunset.html:55
