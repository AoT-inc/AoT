"แตะปุ่มด้านล่างเพื่ออนุมัติ "
"อุปกรณ์จะถูกควบคุมก็ต่อเมื่อคุณอนุมัติเท่านั้น"

#: ai/services/ai_agent_service.py:3468 ai/services/ai_agent_service.py:3531
msgid ""
"[Device control request] Tap the button below to approve; the device is "
"controlled only after you approve."
msgstr ""
"[คำขอควบคุมอุปกรณ์] แตะปุ่มด้านล่างเพื่ออนุมัติ "
"อุปกรณ์จะถูกควบคุมก็ต่อเมื่อคุณอนุมัติเท่านั้น"

#: aot_flask/app.py:1228 aot_flask/routes_integrations.py:155
