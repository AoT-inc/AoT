msgstr "Grupy"

#: aot_flask/templates/pages/geo/geo_facility.html:955
msgid ""
"Grouping actuators of the same kind lets the coordinator command only the"
" leader and automatically copy the same command to followers according to"
" the mode."
msgstr ""
"Grupowanie siłowników tego samego rodzaju pozwala koordynatorowi sterować"
" wyłącznie liderem i automatycznie kopiować to samo polecenie do "
"pozostałych zgodnie z trybem."

#: aot_flask/templates/pages/geo/geo_facility.html:963
msgid "Leader"
msgstr "Odnośnik"

#: aot_flask/templates/pages/geo/geo_facility.html:964
