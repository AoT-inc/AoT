msgstr "Увімк/Вимк"

#: outputs/on_off_52pi_4ch.py:131 outputs/on_off_ecowitt.py:130
#: outputs/on_off_gpio.py:98 outputs/on_off_grove_multichannel_relay.py:170
#: outputs/on_off_kasa_hs300.py:120 outputs/on_off_kasa_hs300_0_4_2.py:133
#: outputs/on_off_kasa_kp303.py:120 outputs/on_off_kasa_kp303_0_4_2.py:133
