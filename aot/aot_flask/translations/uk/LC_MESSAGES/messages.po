msgstr "Показувати позначку аварії/попередження/активності/очікування. Тільки в режимі керування."

#: widgets/AoT_facility.py:445
msgid "Show Setpoints (§ C)"
msgstr "Показувати уставки (§ C)"

#: widgets/AoT_facility.py:446
