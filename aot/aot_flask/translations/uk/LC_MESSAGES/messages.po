"Спочатку встановіть публічну базову URL-адресу, щоб обчислити URI "
"перенаправлення."

#: aot_flask/templates/settings/integrations.html:97
msgid ""
"Some values are provided by environment variables and override the fields"
" below."
msgstr "Деякі значення надаються змінними середовища та перевизначають поля нижче."

#: aot_flask/templates/settings/integrations.html:106
msgid "Public Base URL"
msgstr "Публічна базова URL-адреса"

#: aot_flask/templates/settings/integrations.html:115
msgid "OAuth Client ID"
msgstr "Ідентифікатор клієнта OAuth"

#: aot_flask/templates/settings/integrations.html:124
msgid "OAuth Client Secret"
msgstr "Секрет клієнта OAuth"

#: aot_flask/templates/settings/integrations.html:133
