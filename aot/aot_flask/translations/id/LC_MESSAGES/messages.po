msgstr "Pilih pengukuran jumlah curah hujan atau deteksi hujan."

#: functions/ext_context_collector.py:136
msgid "Solar Radiation Sensor"
msgstr "Sensor Radiasi Matahari"

#: functions/ext_context_collector.py:137
