#: inputs/chirpstack_MQTT_jmespath.py:182
msgid "JMESPath Expression"
msgstr "Ekspresi JMESPath"

#: inputs/chirpstack_MQTT_jmespath.py:183
msgid "Evaluated against the entire received event (JSON)"
msgstr "Dievaluasi terhadap seluruh event yang diterima (JSON)"

#: inputs/chirpstack_jmespath.py:123
msgid ""
"Periodically calls the ChirpStack v4 REST API to fetch device events, and"
" applies per-channel JMESPath expressions to each event JSON to store "
"measurements. Examples (https://jmespath.org): object.battery_V, "
"object.battery_pct, max_by(rxInfo,&rssi).rssi, max_by(rxInfo,&snr).snr, "
"deviceInfo.devEui."
msgstr ""
"Memanggil REST API ChirpStack v4 secara berkala untuk mengambil event "
"perangkat, dan menerapkan ekspresi JMESPath per channel pada setiap JSON "
"event untuk menyimpan hasil pengukuran. Contoh (https://jmespath.org): "
"object.battery_V, object.battery_pct, max_by(rxInfo,&rssi).rssi, "
"max_by(rxInfo,&snr).snr, deviceInfo.devEui."

#: inputs/chirpstack_jmespath.py:149
msgid "API Base URL"
msgstr "URL dasar API"

#: inputs/chirpstack_jmespath.py:150
msgid ""
"Base address of the ChirpStack REST API (e.g. http://localhost:8080) (the"
" REST proxy is typically on port 8090)"
msgstr ""
"Alamat dasar REST API ChirpStack (mis. http://localhost:8080) (proxy REST"
" biasanya di port 8090)"

#: inputs/chirpstack_jmespath.py:158
msgid ""
"Bearer token for accessing the ChirpStack REST API (issued from the admin"
" console)"
msgstr ""
"Token Bearer untuk mengakses REST API ChirpStack (diterbitkan dari konsol"
" admin)"

#: inputs/chirpstack_jmespath.py:165
