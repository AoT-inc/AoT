#: functions/custom_functions/env_coordinator_impl/_function_info.py:69
msgid "Integrated Environment Control"
msgstr "Kontrol Lingkungan Terintegrasi"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:73
msgid ""
"Coordinates registered Output actuators to optimise photosynthesis. VPD is "
"the primary control target; temperature and humidity act as safety "
"constraints. Add \"Environment Control: Register Actuator\" actions to "
"register devices. External environment data (outdoor temperature, humidity, "
"wind, rain, solar, CO₂) comes from the linked facility's outdoor sensors, or"
" optionally from the ext_context_collector function."
msgstr ""
"Mengoordinasikan aktuator Output yang terdaftar untuk mengoptimalkan "
"fotosintesis. VPD menjadi target kontrol utama; suhu dan kelembapan "
"berfungsi sebagai batasan keselamatan. Tambahkan aksi \"Environment Control:"
" Register Actuator\" untuk mendaftarkan perangkat. Data lingkungan luar "
"(suhu, kelembapan, angin, hujan, radiasi matahari, CO₂ di luar ruangan) "
"berasal dari sensor luar ruangan fasilitas yang terhubung, atau secara "
"opsional dari fungsi ext_context_collector."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:85
msgid ""
"Trigger an immediate cycle, reload actuators, or issue an emergency stop."
msgstr ""
"Memicu siklus segera, memuat ulang aktuator, atau mengeluarkan perintah "
"henti darurat."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:92
msgid "Reload Actuators"
msgstr "Muat Ulang Aktuator"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:94
msgid "Re-read the Actions table and rebuild actuator profiles."
msgstr "Membaca ulang tabel Actions dan membangun ulang profil aktuator."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:101
msgid "Run Now"
msgstr "Jalankan Sekarang"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:103
msgid ""
"Execute one coordination cycle immediately using current sensor readings."
msgstr ""
"Menjalankan satu siklus koordinasi segera menggunakan pembacaan sensor saat "
"ini."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:110
msgid "Emergency Stop"
msgstr "Henti Darurat"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:112
msgid ""
"Immediately set all actuators to safe_default and pause control for 60 s."
msgstr ""
"Segera atur semua aktuator ke safe_default dan jeda kontrol selama 60 dtk."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:119
msgid "Apply Crop Preset Targets"
msgstr "Terapkan Target Preset Tanaman"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:121
msgid ""
"Force-fill VPD / CO₂ / Temp / DLI / GDD target fields from the selected Crop"
" Preset (overwrites current values; variables using a Method are skipped). "
"Save the function first if you just changed the crop preset."
msgstr ""
"Isi paksa kolom target VPD / CO₂ / Suhu / DLI / GDD dari Crop Preset yang "
"dipilih (menimpa nilai saat ini; variabel yang menggunakan Method akan "
"dilewati). Simpan fungsi terlebih dahulu jika Anda baru saja mengubah crop "
"preset."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:143
msgid ""
"Coordination cycle interval. Recommended: slowest actuator response time × "
"1.5."
msgstr ""
"Interval siklus koordinasi. Disarankan: waktu respons aktuator terlambat × "
"1,5."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:151
msgid "Max Sensor Age (seconds)"
msgstr "Usia Sensor Maksimum (detik)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:153
msgid "Reject sensor readings older than this value. 0 = no limit."
msgstr ""
"Tolak pembacaan sensor yang lebih lama dari nilai ini. 0 = tanpa batas."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:160
msgid "Growth Schedule"
msgstr "Jadwal Pertumbuhan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:170
msgid ""
"Planting / germination date. Pick from the calendar. The date is interpreted"
" in the device/facility local timezone (the system stores it as UTC "
"internally — no manual conversion needed). Used to compute weeks_elapsed for"
" all Method curves. Leave empty to disable week-based progression (Methods "
"use wall-clock day only)."
msgstr ""
"Tanggal tanam / perkecambahan. Pilih dari kalender. Tanggal ditafsirkan "
"dalam zona waktu lokal perangkat/fasilitas (sistem menyimpannya secara "
"internal sebagai UTC — tidak perlu konversi manual). Digunakan untuk "
"menghitung weeks_elapsed pada semua kurva Method. Biarkan kosong untuk "
"menonaktifkan progresi berbasis minggu (Method hanya menggunakan hari "
"kalender)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:184
msgid "Schedule End (harvest date)"
msgstr "Akhir Jadwal (tanggal panen)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:186
msgid ""
"Harvest / cycle-end date. Pick from the calendar. Interpreted in the "
"device/facility local timezone (same rules as Schedule Start). Methods keep "
"following actual elapsed weeks until this date; once it passes, control "
"stops — every actuator returns to its configured end-behavior and "
"coordination cycles halt. Leave empty for no end date."
msgstr ""
"Tanggal panen / akhir siklus. Pilih dari kalender. Ditafsirkan dalam zona "
"waktu lokal perangkat/fasilitas (aturan sama seperti Schedule Start). Method"
" terus mengikuti minggu yang telah berlalu secara aktual hingga tanggal ini;"
" setelah terlewati, kontrol berhenti — setiap aktuator kembali ke perilaku "
"akhir yang dikonfigurasi dan siklus koordinasi berhenti. Biarkan kosong jika"
" tanpa tanggal akhir."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:201
msgid ""
"Direct week adjustment applied on top of elapsed weeks. Use a positive value"
" to fast-forward (e.g. system started mid-cycle), or negative to compensate "
"for downtime. Default 0."
msgstr ""
"Penyesuaian minggu langsung yang diterapkan di atas minggu yang telah "
"berlalu. Gunakan nilai positif untuk mempercepat maju (misalnya sistem "
"dimulai di tengah siklus), atau negatif untuk mengompensasi waktu tidak "
"aktif. Default 0."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:210
msgid "Facility (optional)"
msgstr "Fasilitas (opsional)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:218
msgid "Linked Facility"
msgstr "Fasilitas Terhubung"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:220
msgid ""
"When set, actuators are auto-discovered from this facility (envelope, "
"side/roof vents, curtains, fans). GIS metadata (azimuth, area, U-value) is "
"attached to each actuator profile so wind direction and facility geometry "
"can be considered. Manual \"Environment Control\" actions below still apply "
"and are merged with the facility-derived list. Leave empty to use manual "
"actions only."
msgstr ""
"Jika diatur, aktuator akan ditemukan secara otomatis dari fasilitas ini "
"(envelope, ventilasi samping/atap, tirai, kipas). Metadata GIS (azimuth, "
"luas, nilai-U) dilampirkan ke setiap profil aktuator sehingga arah angin dan"
" geometri fasilitas dapat diperhitungkan. Aksi \"Environment Control\" "
"manual di bawah tetap berlaku dan digabungkan dengan daftar hasil turunan "
"fasilitas. Biarkan kosong untuk hanya menggunakan aksi manual."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:233
msgid "Bay Scope (optional)"
msgstr "Cakupan Bay (opsional)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:235
msgid ""
"Restrict this coordinator to one bay of the linked facility. Enter the bay "
"ID (see the facility editor bay list; e.g. \"bay_1\"). Only sensors and "
"actuators placed inside that bay are used, and facility volume/area are "
"scaled to the bay share. Leave empty to control the entire facility. Create "
"one coordinator per bay to control multiple bays independently."
msgstr ""
"Batasi coordinator ini pada satu bay dari fasilitas yang terhubung. Masukkan"
" ID bay (lihat daftar bay pada editor fasilitas; misalnya \"bay_1\"). Hanya "
"sensor dan aktuator yang ditempatkan di dalam bay tersebut yang digunakan, "
"dan volume/luas fasilitas diskalakan sesuai porsi bay. Biarkan kosong untuk "
"mengontrol seluruh fasilitas. Buat satu coordinator per bay untuk mengontrol"
" beberapa bay secara independen."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:247
msgid "Time Control"
msgstr "Kontrol Waktu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:254
msgid "Enable Time Window"
msgstr "Aktifkan Jendela Waktu"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:256
msgid "When enabled, control only runs between Start and End times."
msgstr "Jika diaktifkan, kontrol hanya berjalan antara waktu Start dan End."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:266
msgid ""
"Control period start time (24-hour format). Only active when Enable Time "
"Window is turned on."
msgstr ""
"Waktu mulai periode kontrol (format 24 jam). Hanya aktif ketika Enable Time "
"Window dinyalakan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:277
msgid ""
"On-end behavior per actuator is configured in each Action. Ignored when "
"Photoperiod Method is set."
msgstr ""
"Perilaku akhir per aktuator dikonfigurasi pada masing-masing Action. "
"Diabaikan jika Photoperiod Method diatur."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:287
msgid "Photoperiod Method"
msgstr "Method Fotoperiode"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:289
msgid ""
"Optional. Select an AoT Method that returns photoperiod length in hours "
"(e.g. 14.0 = 14 h light). The function computes time_start/end symmetrically"
" around the Anchor time. When set, the static Start/End times above are "
"overridden."
msgstr ""
"Opsional. Pilih AoT Method yang mengembalikan panjang fotoperiode dalam jam "
"(misalnya 14.0 = 14 jam cahaya). Fungsi ini menghitung time_start/end secara"
" simetris di sekitar waktu Anchor. Jika diatur, waktu Start/End statis di "
"atas akan ditimpa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:300
msgid "Photoperiod Anchor (HH:MM)"
msgstr "Anchor Fotoperiode (HH:MM)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:302
msgid ""
"Solar-noon equivalent. The photoperiod window is centred on this time. "
"Default 12:00. Adjust for your latitude / season if needed."
msgstr ""
"Setara tengah hari matahari. Jendela periode cahaya berpusat pada waktu ini."
" Default 12:00. Sesuaikan dengan garis lintang / musim Anda jika diperlukan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:318
#: functions/custom_functions/env_coordinator_impl/_function_info.py:406
msgid "Static Target"
msgstr "Target Statis"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:319
#: functions/custom_functions/env_coordinator_impl/_function_info.py:407
msgid "Method (time-varying)"
msgstr "Metode (berubah seiring waktu)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:321
msgid "Setpoint Type"
msgstr "Jenis Titik Target"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:323
msgid ""
"Static: use the fixed target value below. Method: follow an AoT Method "
"curve."
msgstr ""
"Statis: gunakan nilai target tetap di bawah. Metode: ikuti kurva AoT Method."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:332
msgid "Target VPD (kPa)"
msgstr "Target VPD (kPa)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:333
msgid "Used when Setpoint Type = Static. 0 = disable VPD control."
msgstr ""
"Digunakan saat Jenis Titik Target = Statis. 0 = nonaktifkan kontrol VPD."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:343
msgid ""
"Used when Setpoint Type = Method. Select an AoT Method that returns a VPD "
"setpoint (kPa)."
msgstr ""
"Digunakan saat Jenis Titik Target = Metode. Pilih AoT Method yang "
"menghasilkan titik target VPD (kPa)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:352
msgid "VPD Priority"
msgstr "Prioritas VPD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:353
msgid "Higher value = processed first. Default 1.2."
msgstr "Nilai lebih tinggi = diproses lebih dulu. Default 1,2."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:360
msgid "VPD Tolerance (kPa)"
msgstr "Toleransi VPD (kPa)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:362
msgid ""
"Dead-band half-width around the VPD setpoint. Adjustments are skipped when "
"the deviation is within this range, reducing unnecessary actuator cycling. "
"Typical value: 0.05–0.15 kPa."
msgstr ""
"Setengah lebar dead-band di sekitar titik target VPD. Penyesuaian dilewati "
"saat deviasi berada dalam rentang ini, mengurangi siklus aktuator yang tidak"
" perlu. Nilai umum: 0,05–0,15 kPa."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:378
msgid "Max Light Threshold"
msgstr "Ambang Cahaya Maksimum"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:380
msgid "Activate shade screen when light exceeds this value. 0 = disabled."
msgstr ""
"Aktifkan tirai peneduh saat cahaya melebihi nilai ini. 0 = dinonaktifkan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:388
msgid "Min Light Threshold (Supplemental)"
msgstr "Ambang Cahaya Minimum (Tambahan)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:390
msgid ""
"Activate supplemental lighting when light falls below this value. 0 = "
"disabled (most facilities — natural light only)."
msgstr ""
"Aktifkan pencahayaan tambahan saat cahaya turun di bawah nilai ini. 0 = "
"dinonaktifkan (sebagian besar fasilitas — hanya cahaya alami)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:398
msgid "CO₂"
msgstr "CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:409
msgid "CO₂ Setpoint Type"
msgstr "Jenis Titik Target CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:411
msgid ""
"Static: use the fixed target below. Method: follow an AoT Method curve (ppm "
"vs time-of-day / growth week)."
msgstr ""
"Statis: gunakan target tetap di bawah. Metode: ikuti kurva AoT Method (ppm "
"vs waktu harian / minggu pertumbuhan)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:420
msgid "Target CO₂ (ppm)"
msgstr "Target CO₂ (ppm)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:421
msgid "Used when CO₂ Setpoint Type = Static."
msgstr "Digunakan saat Jenis Titik Target CO₂ = Statis."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:429
msgid "CO₂ Method"
msgstr "Metode CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:431
msgid ""
"Used when CO₂ Setpoint Type = Method. Select an AoT Method that returns a "
"CO₂ setpoint (ppm)."
msgstr ""
"Digunakan saat Jenis Titik Target CO₂ = Metode. Pilih AoT Method yang "
"menghasilkan titik target CO₂ (ppm)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:440
msgid "CO₂ Priority"
msgstr "Prioritas CO₂"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:442
msgid ""
"Processing order weight for CO₂ relative to other control variables. Higher "
"value = processed earlier in each cycle. Default 0.8 (lower than VPD 1.2, "
"since CO₂ enrichment is secondary)."
msgstr ""
"Bobot urutan pemrosesan untuk CO₂ relatif terhadap variabel kontrol lainnya."
" Nilai lebih tinggi = diproses lebih awal dalam setiap siklus. Default 0,8 "
"(lebih rendah dari VPD 1,2, karena pengayaan CO₂ bersifat sekunder)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:452
msgid "CO₂ Tolerance (ppm)"
msgstr "Toleransi CO₂ (ppm)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:454
msgid ""
"Dead-band half-width around the CO₂ setpoint. Adjustments are skipped when "
"the deviation is within this range. Typical value: 50–150 ppm."
msgstr ""
"Setengah lebar dead-band di sekitar titik target CO₂. Penyesuaian dilewati "
"saat deviasi berada dalam rentang ini. Nilai umum: 50–150 ppm."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:470
msgid "Max Temperature (°C)"
msgstr "Suhu Maksimum (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:472
msgid ""
"Hard upper limit. Forces cooling when exceeded, regardless of VPD target."
msgstr ""
"Batas atas mutlak. Memaksa pendinginan saat terlampaui, terlepas dari target"
" VPD."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:480
msgid "Min Temperature (°C)"
msgstr "Suhu Minimum (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:482
msgid "Hard lower limit. Forces heating when below, regardless of VPD target."
msgstr ""
"Batas bawah mutlak. Memaksa pemanasan saat di bawahnya, terlepas dari target"
" VPD."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:496
msgid "Max Humidity (%)"
msgstr "Kelembapan Maksimum (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:498
msgid "Hard upper limit. Prevents VPD bypass via extreme humidity."
msgstr "Batas atas mutlak. Mencegah VPD terlewati akibat kelembapan ekstrem."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:506
msgid "Min Humidity (%)"
msgstr "Kelembapan Minimum (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:508
msgid "Hard lower limit. Prevents VPD bypass via extreme dryness."
msgstr "Batas bawah mutlak. Mencegah VPD terlewati akibat kekeringan ekstrem."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:515
msgid "VPD Decomposition"
msgstr "Dekomposisi VPD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:522
msgid "T Weight (0-1)"
msgstr "Bobot T (0-1)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:524
msgid ""
"VPD decomposition: fraction of adjustment via temperature (rest via "
"humidity). 0.6 = favour temperature adjustment. Range 0.0~1.0."
msgstr ""
"Dekomposisi VPD: fraksi penyesuaian melalui suhu (sisanya melalui "
"kelembapan). 0,6 = mengutamakan penyesuaian suhu. Rentang 0,0~1,0."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:532
msgid "Photosynthesis Model"
msgstr "Model Fotosintesis"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:539
msgid "Enable Photosynthesis-Oriented Control"
msgstr "Aktifkan Kontrol Berorientasi Fotosintesis"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:541
msgid ""
"When enabled, the Big-Leaf photosynthesis model identifies the current "
"limiting factor (Light / CO₂ / Temperature / VPD) each cycle and dynamically"
" raises that variable's priority. Requires Light sensor. Recommended when ≥ "
"3 active actuator types are available."
msgstr ""
"Jika diaktifkan, model fotosintesis Big-Leaf mengidentifikasi faktor "
"pembatas saat ini (Cahaya / CO₂ / Suhu / VPD) setiap siklus dan secara "
"dinamis menaikkan prioritas variabel tersebut. Membutuhkan sensor Cahaya. "
"Direkomendasikan jika tersedia ≥ 3 jenis aktuator aktif."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:553
msgid "Tomato"
msgstr "Tomat"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:554
msgid "Lettuce / Leafy greens"
msgstr "Selada / Sayuran daun"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:555
msgid "Cucumber"
msgstr "Timun"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:556
msgid "Strawberry"
msgstr "Stroberi"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:557
msgid "Pepper / Paprika"
msgstr "Cabai / Paprika"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:559
msgid "Crop Preset"
msgstr "Preset Tanaman"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:561
msgid ""
"Crop recipe. On Save, fills the target options from this preset — VPD, CO₂, "
"Temp min/max, DLI and GDD — unless you changed a value or use a Method for "
"that variable (your setting wins). Use the \"Apply Crop Preset\" button to "
"force-overwrite. Also selects Big-Leaf model params (A_max, K_L, K_C, T_opt,"
" VPD_half), used only when Photosynthesis-Oriented Control is on."
msgstr ""
"Resep tanaman. Saat Disimpan, mengisi opsi target dari preset ini — VPD, "
"CO₂, Suhu min/maks, DLI, dan GDD — kecuali Anda telah mengubah nilai atau "
"menggunakan Metode untuk variabel tersebut (pengaturan Anda yang berlaku). "
"Gunakan tombol \"Apply Crop Preset\" untuk menimpa secara paksa. Preset ini "
"juga memilih parameter model Big-Leaf (A_max, K_L, K_C, T_opt, VPD_half), "
"yang hanya digunakan saat Kontrol Berorientasi Fotosintesis aktif."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:572
msgid "Guide Ranges (T / RH)"
msgstr "Rentang Panduan (T / RH)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:579
msgid "Guide T Min (°C)"
msgstr "T Min Panduan (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:581
msgid ""
"Advisory lower bound for temperature. Triggers forced heating when exceeded "
"(replaces Min Temperature setting when using crop-preset-derived guide "
"ranges)."
msgstr ""
"Batas bawah anjuran untuk suhu. Memicu pemanasan paksa saat terlampaui "
"(menggantikan pengaturan Suhu Minimum saat menggunakan rentang panduan yang "
"berasal dari preset tanaman)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:591
msgid "Guide T Max (°C)"
msgstr "Suhu Maks Panduan (°C)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:592
msgid "Advisory upper bound for temperature."
msgstr "Batas atas anjuran untuk suhu."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:599
msgid "Guide RH Min (%)"
msgstr "RH Min Panduan (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:600
msgid "Advisory lower bound for relative humidity."
msgstr "Batas bawah anjuran untuk kelembapan relatif."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:607
msgid "Guide RH Max (%)"
msgstr "RH Maks Panduan (%)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:608
msgid "Advisory upper bound for relative humidity."
msgstr "Batas atas anjuran untuk kelembapan relatif."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:614
msgid "Cumulative Goal Tracker"
msgstr "Pelacak Target Kumulatif"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:621
msgid "Enable DLI / GDD Tracker"
msgstr "Aktifkan Pelacak DLI / GDD"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:623
msgid ""
"Tracks daily light integral (DLI) and growing degree-days (GDD), rolling "
"over at the facility-local midnight (device timezone). Light is converted to"
" PPFD by sensor unit (W/m² assumed if unknown). Generates compensation "
"suggestions when debt accumulates. Requires a Light sensor for DLI tracking."
msgstr ""
"Melacak integral cahaya harian (DLI) dan derajat-hari pertumbuhan (GDD), "
"yang direset pada tengah malam waktu setempat fasilitas (zona waktu "
"perangkat). Cahaya dikonversi ke PPFD berdasarkan satuan sensor (diasumsikan"
" W/m² jika tidak diketahui). Menghasilkan saran kompensasi saat terjadi "
"defisit yang terakumulasi. Memerlukan sensor Cahaya untuk pelacakan DLI."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:635
msgid "DLI Target (mol/m²/day)"
msgstr "Target DLI (mol/m²/hari)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:637
msgid ""
"Daily light integral target. 0 = use the selected crop preset default (leafy"
" greens ~14, tomato/cucumber/pepper ~22, strawberry ~17). Turn the tracker "
"off above to disable entirely."
msgstr ""
"Target integral cahaya harian. 0 = gunakan nilai default preset tanaman yang"
" dipilih (sayuran daun ~14, tomat/mentimun/paprika ~22, stroberi ~17). "
"Matikan pelacak di atas untuk menonaktifkan sepenuhnya."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:647
msgid "GDD Target (°C·day/day)"
msgstr "Target GDD (°C·hari/hari)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:649
msgid ""
"Growing degree-day target per day. 0 = use the selected crop preset default "
"(≈ T_opt − T_base). Computed as max(0, T_mean − T_base) per cycle."
msgstr ""
"Target derajat-hari pertumbuhan per hari. 0 = gunakan nilai default preset "
"tanaman yang dipilih (≈ T_opt − T_base). Dihitung sebagai max(0, T_mean − "
"T_base) per siklus."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:664
msgid "Strong Wind Threshold (m/s)"
msgstr "Ambang Angin Kencang (m/s)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:666
msgid "Openings (vents, side walls) are forced closed above this wind speed."
msgstr ""
"Bukaan (ventilasi, dinding samping) dipaksa menutup di atas kecepatan angin "
"ini."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:673
msgid "Effect Calibration"
msgstr "Kalibrasi Efek"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:681
msgid "Legacy (built-in K constants)"
msgstr "Warisan (konstanta K bawaan)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:682
msgid "Shadow (grey-box logged, legacy controls)"
msgstr "Bayangan (grey-box tercatat, kontrol warisan)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:683
msgid "Grey-box (physics model controls)"
msgstr "Grey-box (kontrol model fisika)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:685
msgid "Effect Engine"
msgstr "Mesin Efek"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:687
msgid ""
"Legacy: uses built-in K_* constants (default, safe). Shadow: runs grey-box "
"model in parallel for KPI logging only — no control change. Grey-box: "
"physics-model control (effect magnitudes from the grey-box model, with MPC "
"look-ahead when a forecast is available). Grey-box activates ONLY after the "
"shadow KPI passes and parameters have converged; until then it automatically"
" falls back to Legacy control. Recommended flow: run Shadow first, then "
"switch to Grey-box."
msgstr ""
"Warisan: menggunakan konstanta K_* bawaan (default, aman). Bayangan: "
"menjalankan model grey-box secara paralel hanya untuk pencatatan KPI — tanpa"
" perubahan kontrol. Grey-box: kontrol berbasis model fisika (besaran efek "
"dari model grey-box, dengan tinjauan-depan MPC saat prakiraan tersedia). "
"Grey-box hanya aktif SETELAH KPI bayangan lulus dan parameter telah "
"konvergen; sebelum itu secara otomatis kembali ke kontrol Warisan. Alur yang"
" disarankan: jalankan Bayangan terlebih dahulu, lalu beralih ke Grey-box."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:701
msgid "Enable RLS Calibration"
msgstr "Aktifkan Kalibrasi RLS"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:703
msgid ""
"Learn per-actuator effect coefficients (K_*) from sensor response. Requires "
"several days of data to converge. Falls back to built-in defaults until "
"convergence."
msgstr ""
"Mempelajari koefisien efek per-aktuator (K_*) dari respons sensor. "
"Memerlukan data beberapa hari untuk konvergen. Kembali ke nilai default "
"bawaan hingga konvergen."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:713
msgid "Enable Active Probing"
msgstr "Aktifkan Probing Aktif"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:715
#, python-format
msgid ""
"Periodically perturb one actuator by ±10 %% to improve calibration "
"identifiability. Only triggers when load is low and no safety gate is "
"active. Requires RLS Calibration to be enabled."
msgstr ""
"Secara berkala mengganggu satu aktuator sebesar ±10 %% untuk meningkatkan "
"keteridentifikasian kalibrasi. Hanya dipicu saat beban rendah dan tidak ada "
"gerbang keselamatan yang aktif. Memerlukan Kalibrasi RLS diaktifkan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:725
msgid "Probe Interval (seconds)"
msgstr "Interval Probing (detik)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:727
msgid "Minimum time between active probing events. Default 3600 s (1 hour)."
msgstr ""
"Waktu minimum antar peristiwa probing aktif. Default 3600 dtk (1 jam)."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
msgid "Forecast Feedforward"
msgstr "Feedforward Prakiraan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:741
msgid "Enable Forecast Feedforward"
msgstr "Aktifkan Feedforward Prakiraan"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:743
msgid ""
"Use KMA short-term weather forecast (forecast.json) to proactively shift "
"temperature/humidity setpoints and inhibit ventilation before adverse "
"weather arrives."
msgstr ""
"Gunakan prakiraan cuaca jangka pendek KMA (forecast.json) untuk secara "
"proaktif menggeser titik setel suhu/kelembapan dan menghambat ventilasi "
"sebelum cuaca buruk tiba."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:753
msgid "Forecast Lookahead (hours)"
msgstr "Tinjauan-Depan Prakiraan (jam)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:755
msgid ""
"How many hours ahead to check for incoming adverse weather (1–6 h). Longer "
"lookahead gives earlier warning but may over-correct."
msgstr ""
"Berapa jam ke depan untuk memeriksa cuaca buruk yang akan datang (1–6 jam). "
"Tinjauan-depan yang lebih lama memberikan peringatan lebih awal tetapi dapat"
" menyebabkan koreksi berlebihan."

#: functions/custom_functions/env_coordinator_impl/_function_info.py:772
msgid ""
"Write per-cycle decision data to InfluxDB (goal targets, deviations, mode, "
"cycle metrics, actuator mismatch count, learning hygiene). Also emits per-"
"cycle DEBUG log lines (constraint violations, feedforward decisions, "
"deadband skips). Leave OFF for production — critical events (safety gate, "
"dispatch failure, runtime state error) are always recorded regardless of "
"this flag."
msgstr ""
"Menulis data keputusan per-siklus ke InfluxDB (target tujuan, deviasi, mode,"
" metrik siklus, jumlah ketidaksesuaian aktuator, kebersihan pembelajaran). "
"Juga mengeluarkan baris log DEBUG per-siklus (pelanggaran batasan, keputusan"
" feedforward, deadband yang dilewati). Biarkan MATI untuk produksi — "
"peristiwa kritis (gerbang keselamatan, kegagalan pengiriman, kesalahan "
"status runtime) selalu dicatat terlepas dari flag ini."
