msgstr "Opsional: gunakan untuk hanya menanyakan perangkat milik tenant tertentu"

#: inputs/chirpstack_jmespath.py:173
msgid "Application ID"
msgstr "ID aplikasi"

#: inputs/chirpstack_jmespath.py:174
msgid "Optional: use to query only devices belonging to a specific application"
msgstr "Opsional: gunakan untuk hanya menanyakan perangkat milik aplikasi tertentu"

#: inputs/chirpstack_jmespath.py:182
msgid ""
"Optional: enter the device EUIs to query, separated by commas. If empty, "
"all devices in the application are targeted"
msgstr ""
"Opsional: masukkan EUI perangkat yang akan ditanyakan, dipisahkan koma. "
"Jika kosong, semua perangkat dalam aplikasi menjadi target"

#: inputs/chirpstack_jmespath.py:189
