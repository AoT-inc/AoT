msgstr "Pilih pengukuran radiasi matahari (W/m²) atau iluminansi."

#: functions/ext_context_collector.py:145
msgid "Dew Point Sensor"
msgstr "Sensor Titik Embun"

#: functions/ext_context_collector.py:146
msgid ""
"Select the dew point (°C) measurement. If absent, it is calculated from "
"temperature and humidity."
msgstr ""
"Pilih pengukuran titik embun (°C). Jika tidak ada, nilai ini dihitung dari "
"suhu dan kelembapan."

#: functions/ext_context_collector.py:154
msgid "External CO₂ Sensor"
msgstr "Sensor CO₂ Eksternal"

#: functions/ext_context_collector.py:155
msgid ""
"Select the external CO₂ (ppm) measurement. If absent, the default is 400 "
"ppm."
msgstr ""
"Pilih pengukuran CO₂ (ppm) eksternal. Jika tidak ada, nilai default adalah "
"400 ppm."

#: functions/ext_context_collector.py:164
msgid "Sensor Maximum Allowed Age (seconds)"
msgstr "Usia Maksimum Sensor yang Diizinkan (detik)"

#: functions/ext_context_collector.py:165
msgid ""
"Measurements older than this are replaced with the fallback default value."
msgstr ""
"Pengukuran yang lebih lama dari ini akan digantikan dengan nilai default "
"fallback."

#: functions/ext_context_collector.py:172
msgid "Fallback External Temperature (°C)"
msgstr "Suhu Eksternal Fallback (°C)"

#: functions/ext_context_collector.py:173
