#: inputs/atlas_ph.py:80
msgid "Temperature Compensation"
msgstr "온도 보정"

#: inputs/ads1115_analog_ph_ec.py:139 inputs/ads1256_analog_ph_ec.py:223
#: inputs/anyleaf_ph.py:63 inputs/atlas_do.py:69 inputs/atlas_ec.py:82
