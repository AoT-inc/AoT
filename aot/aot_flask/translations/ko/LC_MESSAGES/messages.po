#: functions/custom_functions/env_coordinator_impl/_function_info.py:685
msgid "Effect Engine"
msgstr "효과 엔진"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:687
msgid ""
"Legacy: uses built-in K_* constants (default, safe). Shadow: runs grey-box "
"model in parallel for KPI logging only — no control change. Grey-box: "
"physics-model control (effect magnitudes from the grey-box model, with MPC "
"look-ahead when a forecast is available). Grey-box activates ONLY after the "
"shadow KPI passes and parameters have converged; until then it automatically"
" falls back to Legacy control. Recommended flow: run Shadow first, then "
"switch to Grey-box."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:701
msgid "Enable RLS Calibration"
msgstr "RLS 보정 사용"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:703
msgid ""
"Learn per-actuator effect coefficients (K_*) from sensor response. Requires "
"several days of data to converge. Falls back to built-in defaults until "
"convergence."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:713
msgid "Enable Active Probing"
msgstr "능동 프로빙 사용"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:715
#, python-format
msgid ""
"Periodically perturb one actuator by ±10 %% to improve calibration "
"identifiability. Only triggers when load is low and no safety gate is "
"active. Requires RLS Calibration to be enabled."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:725
msgid "Probe Interval (seconds)"
msgstr "프로빙 간격 (초)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:727
msgid "Minimum time between active probing events. Default 3600 s (1 hour)."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:734
msgid "Forecast Feedforward"
msgstr "예보 피드포워드"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:741
msgid "Enable Forecast Feedforward"
msgstr "예보 피드포워드 사용"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:743
msgid ""
"Use KMA short-term weather forecast (forecast.json) to proactively shift "
"temperature/humidity setpoints and inhibit ventilation before adverse "
"weather arrives."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:753
msgid "Forecast Lookahead (hours)"
msgstr "예보 예측 시간 (시간)"

#: functions/custom_functions/env_coordinator_impl/_function_info.py:755
msgid ""
"How many hours ahead to check for incoming adverse weather (1–6 h). Longer "
"lookahead gives earlier warning but may over-correct."
msgstr ""

#: functions/custom_functions/env_coordinator_impl/_function_info.py:772
msgid ""
"Write per-cycle decision data to InfluxDB (goal targets, deviations, mode, "
"cycle metrics, actuator mismatch count, learning hygiene). Also emits per-"
"cycle DEBUG log lines (constraint violations, feedforward decisions, "
"deadband skips). Leave OFF for production — critical events (safety gate, "
"dispatch failure, runtime state error) are always recorded regardless of "
"this flag."
msgstr ""

