msgstr "지연 (초)"

#: aot_flask/templates/pages/function_options/trigger_sequence_options.html:125
msgid "Overlap (seconds)"
msgstr "중복 (초)"

#: aot_flask/templates/pages/function_options/trigger_sequence_options.html:132
msgid "Input Validity (seconds)"
msgstr "입력 유효성 (초)"

