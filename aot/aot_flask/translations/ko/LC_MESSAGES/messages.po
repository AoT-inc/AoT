msgstr "작동상태를 타이틀바에 표시 합니다."

#: widgets/AoT_timer.py:1111
msgid "Status Size"
msgstr "상태 크기"

#: widgets/AoT_timer.py:1112 widgets/AoT_timer.py:1127
#: widgets/AoT_timer.py:1146
msgid "Size in (em)"
msgstr "(em) 단위"

#: widgets/AoT_timer.py:1118
msgid "Operation Time"
msgstr "작동시간"

#: widgets/AoT_timer.py:1119
