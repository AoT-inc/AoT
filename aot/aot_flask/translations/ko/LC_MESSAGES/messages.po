msgstr "레이블당 표시되는 측정값의 개수입니다. 초과 채널은 \"+\"로 축약됩니다."

#: widgets/AoT_facility.py:507 widgets/AoT_map.py:921
msgid "Decimals"
msgstr "소수점 자리수"

#: widgets/AoT_facility.py:508 widgets/AoT_map.py:922
msgid "Decimal places for label values."
msgstr "레이블 값의 소수점 자리수입니다."

#: widgets/AoT_facility.py:515 widgets/AoT_map.py:929
msgid "Label Size (em)"
msgstr "레이블 크기 (em)"

#: widgets/AoT_facility.py:516 widgets/AoT_map.py:930
msgid "Font size of sensor labels in em units."
msgstr "센서 레이블의 글꼴 크기입니다 (단위: em)."

#: widgets/AoT_facility.py:523 widgets/AoT_map.py:937
msgid "Label Background"
msgstr "레이블 배경"

#: widgets/AoT_facility.py:524 widgets/AoT_map.py:938
